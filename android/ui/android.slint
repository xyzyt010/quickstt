import { ScrollView } from "std-widgets.slint";

// QuickSTT for Android — touch-first UI.
//
// This is deliberately NOT the desktop dashboard: phones are held in one
// hand, so the primary action (the mic orb) sits in the bottom third of the
// thumb arc, every target is at least 44 DIP, and navigation is a fixed
// bottom bar instead of a collapsible sidebar. Same palette and typography
// family as the desktop app so both feel like one product.
//
// Two Slint rules drive the structure below — breaking them is what made the
// old layout look broken:
//
//   1. A layout inside a plain `Rectangle` does NOT stretch to the rectangle.
//      It keeps its own size and floats in the middle of it. Every nested
//      layout therefore binds `width: parent.width` explicitly.
//   2. `Text` is centred inside its slot by default. Every piece of body
//      text therefore sets `horizontal-alignment: left`; only buttons, tab
//      titles and centred labels keep the default.
//
// Plus: every long text wraps or elides. A long text must never widen the
// layout, or the page grows wider than the screen and the cards fall off the
// right edge.

export struct Turn {
    text: string,
    when: string,
    seconds: int,
}

// A speech model that really runs on this phone. The list comes from the
// Rust side (stt::MODELS) — the UI never invents an engine.
export struct ModelItem {
    name: string,
    detail: string,
    size: string,
    installed: bool,
}

// ── Small building blocks ──────────────────────────────────────────────────

// A 8px status dot that fills when listening.
component StatusDot inherits Rectangle {
    in property <bool> active;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.active ? #4ADE80 : #4A4A4A;
    animate background { duration: 160ms; }
}

// Body text: left aligned, the way text belongs on a phone.
component Body inherits Text {
    horizontal-alignment: left;
    color: #EDEDED;
    wrap: word-wrap;
}

// Small caps section heading.
component SectionLabel inherits Text {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.2px;
    color: #4A4A4A;
    horizontal-alignment: left;
    wrap: word-wrap;
}

// ── Tab bar icons (22x22, one colour) ─────────────────────────────────────

// Microphone.
component IconMic inherits Rectangle {
    in property <color> tint: #FFFFFF;
    width: 22px;
    height: 22px;
    background: transparent;
    Rectangle { width: 7px; height: 11px; x: 7.5px; y: 2px; border-radius: 3.5px; background: root.tint; }
    Rectangle { width: 1.5px; height: 5px; x: 4.5px; y: 9px; background: root.tint; }
    Rectangle { width: 1.5px; height: 5px; x: 16px; y: 9px; background: root.tint; }
    Rectangle { width: 13px; height: 1.5px; x: 4.5px; y: 12.5px; background: root.tint; }
    Rectangle { width: 1.5px; height: 5px; x: 10.25px; y: 14px; background: root.tint; }
    Rectangle { width: 8px; height: 1.5px; x: 7px; y: 19px; background: root.tint; }
}

// A list of past turns.
component IconList inherits Rectangle {
    in property <color> tint: #FFFFFF;
    width: 22px;
    height: 22px;
    background: transparent;
    Rectangle { width: 14px; height: 1.5px; x: 4px; y: 6px; border-radius: 1px; background: root.tint; }
    Rectangle { width: 14px; height: 1.5px; x: 4px; y: 10.25px; border-radius: 1px; background: root.tint; }
    Rectangle { width: 9px; height: 1.5px; x: 4px; y: 14.5px; border-radius: 1px; background: root.tint; }
}

// Stacked layers: the model files.
component IconLayers inherits Rectangle {
    in property <color> tint: #FFFFFF;
    width: 22px;
    height: 22px;
    background: transparent;
    Rectangle { width: 14px; height: 4px; x: 4px; y: 4px; border-radius: 2px; background: root.tint; }
    Rectangle { width: 14px; height: 4px; x: 4px; y: 9px; border-radius: 2px; background: root.tint; }
    Rectangle { width: 14px; height: 4px; x: 4px; y: 14px; border-radius: 2px; background: root.tint; }
}

// Two sliders.
component IconSliders inherits Rectangle {
    in property <color> tint: #FFFFFF;
    width: 22px;
    height: 22px;
    background: transparent;
    Rectangle { width: 14px; height: 1.5px; x: 4px; y: 7px; border-radius: 1px; background: root.tint; }
    Rectangle { width: 4px; height: 4px; x: 6px; y: 5.75px; border-radius: 2px; background: root.tint; }
    Rectangle { width: 14px; height: 1.5px; x: 4px; y: 14px; border-radius: 1px; background: root.tint; }
    Rectangle { width: 4px; height: 4px; x: 13px; y: 12.75px; border-radius: 2px; background: root.tint; }
}

// ── Controls ───────────────────────────────────────────────────────────────

// Pill switch — 46x28 box, 22px knob, 150ms slide.
component Toggle inherits Rectangle {
    in-out property <bool> on;
    callback toggled();

    width: 46px;
    height: 28px;
    border-radius: 14px;
    background: root.on ? #245C3B : #1A1A1A;
    border-width: 1px;
    border-color: root.on ? #3E8B5F : #2C2C2C;
    animate background { duration: 150ms; easing: ease-out; }

    Rectangle {
        width: 22px;
        height: 22px;
        y: 3px;
        x: root.on ? 21px : 3px;
        border-radius: 11px;
        background: root.on ? #FFFFFF : #B0B0B0;
        animate x { duration: 150ms; easing: ease-out; }
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

// The one button in the app — every target is 44 DIP or taller.
component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: true;
    in property <bool> enabled: true;
    callback clicked();

    height: 44px;
    border-radius: 22px;
    background: !root.enabled ? #121212 : (root.primary ? #4ADE80 : #171717);
    border-width: 1px;
    border-color: !root.enabled ? #232323 : (root.primary ? #4ADE80 : #2C2C2C);

    Text {
        text: root.label;
        font-size: 14px;
        font-weight: 600;
        color: !root.enabled ? #555555 : (root.primary ? #06120B : #EDEDED);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A card: rounded, dark, hairline border.
component Card inherits Rectangle {
    border-radius: 16px;
    background: #0B0B0B;
    border-width: 1px;
    border-color: #1E1E1E;
}

// Bottom-bar entry: an icon, a label and an accent rail on top.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <int> icon: 0;
    in property <bool> active;
    callback picked();

    // Share the bar evenly: four equal touch columns.
    horizontal-stretch: 1;
    background: transparent;

    // The active marker sits on the very top of the item.
    Rectangle {
        x: (parent.width - 18px) / 2;
        y: 0;
        width: 18px;
        height: 2.5px;
        border-radius: 1.5px;
        background: root.active ? #4ADE80 : transparent;
        animate background { duration: 150ms; }
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        alignment: center;
        cross-axis-alignment: center;
        spacing: 5px;

        Rectangle {
            width: 22px;
            height: 22px;
            background: transparent;

            if root.icon == 0 : IconMic { tint: root.active ? #FFFFFF : #707070; }
            if root.icon == 1 : IconList { tint: root.active ? #FFFFFF : #707070; }
            if root.icon == 2 : IconLayers { tint: root.active ? #FFFFFF : #707070; }
            if root.icon == 3 : IconSliders { tint: root.active ? #FFFFFF : #707070; }
        }

        Text {
            text: root.label;
            font-size: 10px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? #FFFFFF : #707070;
            horizontal-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.picked(); }
    }
}

// A transcript row with a circular play affordance.
component TurnRow inherits Rectangle {
    in property <string> text;
    in property <string> when;
    in property <int> seconds;

    height: 66px;
    background: transparent;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        cross-axis-alignment: center;

        Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: #161616;
            border-width: 1px;
            border-color: #2A2A2A;

            Path {
                width: 8px;
                height: 10px;
                x: 15px;
                y: 13px;
                commands: "M 0 0 L 8 5 L 0 10 Z";
                fill: #EDEDED;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;

            Body {
                text: root.text;
                font-size: 14px;
                overflow: elide;
            }

            Text {
                text: root.when;
                font-size: 11px;
                color: #5E5E5E;
                horizontal-alignment: left;
                overflow: elide;
            }
        }

        Text {
            text: "\{root.seconds}s";
            font-size: 11px;
            color: #5E5E5E;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// A numbered setup step: badge, title, explanation and an optional action.
component SetupStep inherits Rectangle {
    in property <string> number: "1";
    in property <string> title;
    in property <string> detail;
    in property <string> extra: "";
    in property <bool> done: false;
    in property <bool> busy: false;
    in property <string> action-label: "";
    in property <bool> action-primary: true;
    in property <bool> action-enabled: true;
    in property <float> progress: 0.0;
    callback action();

    height: 76px;
    background: transparent;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 12px;
        cross-axis-alignment: center;

        Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 13px;
            background: root.done ? #12241A : #1A1416;
            border-width: 1px;
            border-color: root.done ? #245C3B : #4A2028;

            Text {
                text: root.number;
                font-size: 12px;
                font-weight: 700;
                color: root.done ? #4ADE80 : #FF7A8A;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;

            Body {
                text: root.title;
                font-size: 14px;
            }

            Body {
                text: root.detail;
                font-size: 12px;
                color: #7A7A7A;
            }

            if root.extra != "" : Body {
                text: root.extra;
                font-size: 11px;
                color: #FFB27A;
            }

            if root.busy : Rectangle {
                height: 4px;
                border-radius: 2px;
                background: #1E1E1E;

                Rectangle {
                    width: parent.width * root.progress;
                    height: 4px;
                    border-radius: 2px;
                    background: #4ADE80;
                }
            }
        }

        if root.action-label != "" : ActionButton {
            width: 96px;
            label: root.action-label;
            primary: root.action-primary;
            enabled: root.action-enabled && !root.busy;
            clicked => { root.action(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "QuickSTT";
    background: #000000;
    default-font-size: 15px;
    preferred-width: 412px;
    preferred-height: 760px;

    in-out property <int> tab: 0;
    in-out property <bool> recording: false;
    in-out property <string> live-text: "Tap the mic, then speak.";
    in-out property <int> selected-model: 0;
    in-out property <bool> auto-offload: true;
    in-out property <bool> haptics: true;
    in-out property <float> pulse: 0.0;
    // Live wiring (set from Rust): setup state, model download progress and
    // the floating-bubble permission.
    in-out property <string> status-text: "Starting…";
    in-out property <bool> mic-ok: false;
    in-out property <bool> model-installed: false;
    in-out property <bool> model-downloading: false;
    in-out property <float> model-progress: 0.0;
    in-out property <bool> overlay-ok: false;
    in-out property <bool> busy: false;
    // True once there is a transcript that can be typed or shared.
    in-out property <bool> has-text: false;
    // Live microphone health: empty = healthy, otherwise the reason the
    // input cannot be used ("clipped" / "no signal").
    in-out property <string> mic-health: "";
    // A short, human-readable activity log — the app tells the user what it
    // is doing instead of looking frozen.
    in-out property <string> log-text: "";
    in property <[string]> tabs: ["Listen", "History", "Models", "Settings"];

    in-out property <[Turn]> turns: [];
    in-out property <[ModelItem]> models: [];

    callback toggle-record();
    callback pick-model(int);
    callback nav(int);
    // Microphone self-test: opens the mic for a second and reports the
    // level and the input health (clipped / no signal).
    callback test-mic();
    // Setup actions (wired in Rust).
    callback grant-mic();
    callback download-model();
    callback toggle-overlay();
    callback open-overlay-settings();
    // Push the last transcript into the app in front / into the share sheet.
    callback type-into-app();
    callback share-text();

    // Root box: a Rectangle fills the Window; a bare root layout gets centred
    // at its preferred width by the winit backend instead of stretching.
    Rectangle {
        background: #000000;

        VerticalLayout {
            width: parent.width;
            height: parent.height;

            // Status bar allowance (the Android surface is full-bleed).
            Rectangle { height: 24px; background: transparent; }

            // ── Header ────────────────────────────────────────────────────
            Rectangle {
                height: 58px;
                background: transparent;

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 10px;
                    cross-axis-alignment: center;

                    Text {
                        text: "QuickSTT";
                        font-size: 20px;
                        font-weight: 700;
                        color: #FFFFFF;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Rectangle {
                        width: 104px;
                        height: 30px;
                        border-radius: 15px;
                        background: root.recording ? #12241A : #101010;
                        border-width: 1px;
                        border-color: root.recording ? #245C3B : #222222;

                        HorizontalLayout {
                            width: parent.width;
                            height: parent.height;
                            padding-left: 12px;
                            padding-right: 13px;
                            spacing: 7px;
                            cross-axis-alignment: center;

                            StatusDot { active: root.recording; }

                            Text {
                                text: root.recording ? "Listening" : "Idle";
                                font-size: 12px;
                                color: root.recording ? #B7F7CD : #8A8A8A;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // ── Body ──────────────────────────────────────────────────────
            Rectangle {
                vertical-stretch: 1;
                background: #000000;

                // ══ LISTEN ═══════════════════════════════════════════════
                if root.tab == 0 : ScrollView {
                    VerticalLayout {
                        width: 100%;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 4px;
                        padding-bottom: 20px;
                        // A layout without a stretched child shares the leftover
                        // space equally, which would stretch the cards. This
                        // sponge takes it instead.
                        Rectangle { vertical-stretch: 1; }
                        spacing: 14px;

                        // Status card: what the app is doing right now.
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 6px;

                                SectionLabel {
                                    text: root.recording ? "LISTENING" : (root.busy ? "WORKING" : "READY");
                                    color: root.recording ? #4ADE80 : #4A4A4A;
                                }

                                Body {
                                    text: root.status-text;
                                    font-size: 15px;
                                }

                                if root.log-text != "" : Body {
                                    text: root.log-text;
                                    font-size: 11px;
                                    color: #5E5E5E;
                                }
                            }
                        }

                        // Orb: 184px core, breathing ring while listening.
                        Rectangle {
                            height: 212px;
                            background: transparent;

                            Rectangle {
                                width: 184px + root.pulse * 30px;
                                height: 184px + root.pulse * 30px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: self.width / 2;
                                background: transparent;
                                border-width: 1px;
                                border-color: #245C3B;
                                opacity: root.recording ? 0.85 - root.pulse * 0.55 : 0.0;
                            }

                            Rectangle {
                                width: 184px;
                                height: 184px;
                                x: (parent.width - 184px) / 2;
                                y: (parent.height - 184px) / 2;
                                border-radius: 92px;
                                background: root.recording ? #101A13 : #0D0D0D;
                                border-width: 1px;
                                border-color: root.recording ? #2E6B47 : #242424;
                                animate background { duration: 200ms; }
                                animate border-color { duration: 200ms; }

                                // Drawn microphone: capsule + cradle + stand.
                                Rectangle {
                                    width: 26px;
                                    height: 40px;
                                    x: (parent.width - 26px) / 2;
                                    y: 56px;
                                    border-radius: 13px;
                                    background: root.recording ? #4ADE80 : #FFFFFF;
                                    animate background { duration: 200ms; }
                                }

                                Rectangle {
                                    width: 48px;
                                    height: 22px;
                                    x: (parent.width - 48px) / 2;
                                    y: 78px;
                                    clip: true;
                                    background: transparent;

                                    Rectangle {
                                        width: 48px;
                                        height: 48px;
                                        y: -26px;
                                        border-radius: 24px;
                                        background: transparent;
                                        border-width: 2px;
                                        border-color: root.recording ? #4ADE80 : #FFFFFF;
                                    }
                                }

                                Rectangle {
                                    width: 2px;
                                    height: 12px;
                                    x: (parent.width - 2px) / 2;
                                    y: 118px;
                                    background: root.recording ? #4ADE80 : #FFFFFF;
                                }

                                Rectangle {
                                    width: 22px;
                                    height: 2px;
                                    x: (parent.width - 22px) / 2;
                                    y: 130px;
                                    border-radius: 1px;
                                    background: root.recording ? #4ADE80 : #FFFFFF;
                                }

                                TouchArea {
                                    clicked => { root.toggle-record(); }
                                }
                            }
                        }

                        Text {
                            text: root.recording ? "Tap to stop" : "Tap to record";
                            font-size: 13px;
                            color: #7A7A7A;
                            horizontal-alignment: center;
                        }

                        // Model chip.
                        Rectangle {
                            height: 52px;
                            border-radius: 12px;
                            background: #0C0C0C;
                            border-width: 1px;
                            border-color: #222222;

                            HorizontalLayout {
                                width: parent.width;
                                height: parent.height;
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 10px;
                                cross-axis-alignment: center;

                                Rectangle {
                                    width: 7px;
                                    height: 7px;
                                    border-radius: 4px;
                                    background: root.model-installed ? #4ADE80 : #4A4A4A;
                                }

                                Text {
                                    text: root.models.length > 0 ? root.models[root.selected-model].name : "No model";
                                    font-size: 13px;
                                    color: #EDEDED;
                                    horizontal-alignment: left;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.models.length > 0 ? root.models[root.selected-model].size : "";
                                    font-size: 12px;
                                    color: #5E5E5E;
                                    horizontal-alignment: left;
                                }

                                Text {
                                    text: "Models ›";
                                    font-size: 12px;
                                    color: #8A8A8A;
                                    horizontal-alignment: right;
                                    horizontal-stretch: 1;
                                }
                            }

                            TouchArea {
                                clicked => { root.nav(2); }
                            }
                        }

                        // Live transcript + the actions that push it out.
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 10px;

                                SectionLabel {
                                    text: root.recording ? "LIVE" : "READY";
                                    color: root.recording ? #4ADE80 : #4A4A4A;
                                }

                                Body {
                                    text: root.live-text;
                                    font-size: 16px;
                                    color: root.recording ? #FFFFFF : #8A8A8A;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    cross-axis-alignment: center;

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        height: 40px;
                                        label: "Type into app";
                                        primary: false;
                                        enabled: root.has-text;
                                        clicked => { root.type-into-app(); }
                                    }

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        height: 40px;
                                        label: "Share";
                                        primary: false;
                                        enabled: root.has-text;
                                        clicked => { root.share-text(); }
                                    }
                                }

                                Body {
                                    text: "Start the recording, switch to the app you want to write in and speak — the text is typed straight into it (and always copied to the clipboard).";
                                    font-size: 11px;
                                    color: #5E5E5E;
                                }
                            }
                        }

                        // ── Setup ─────────────────────────────────────────────
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 4px;

                                SectionLabel { text: "SET UP"; }

                                SetupStep {
                                    number: "1";
                                    title: "Allow the microphone";
                                    detail: root.mic-ok ? "Granted — the orb can listen." : "Required for dictation.";
                                    extra: root.mic-health;
                                    done: root.mic-ok;
                                    action-label: root.mic-ok ? "Test mic" : "Allow";
                                    action-primary: !root.mic-ok;
                                    action => {
                                        if root.mic-ok { root.test-mic(); } else { root.grant-mic(); }
                                    }
                                }

                                SetupStep {
                                    number: "2";
                                    title: "Download the speech model";
                                    detail: root.model-installed
                                        ? "The model is installed (32 MB, works offline)."
                                        : (root.model-downloading ? "Downloading…" : "Whisper Tiny EN · 32 MB · one-time");
                                    done: root.model-installed;
                                    busy: root.model-downloading;
                                    progress: root.model-progress;
                                    action-label: root.model-installed ? "" : (root.model-downloading ? "…" : "Get");
                                    action-primary: true;
                                    action => { root.download-model(); }
                                }

                                SetupStep {
                                    number: "3";
                                    title: "Floating bubble";
                                    detail: root.overlay-ok
                                        ? "On — the mic bubble shows above other apps."
                                        : "Shows the mic state above other apps.";
                                    done: root.overlay-ok;
                                    action-label: root.overlay-ok ? "Hide" : "Enable";
                                    action-primary: false;
                                    action => {
                                        if root.overlay-ok { root.toggle-overlay(); } else { root.open-overlay-settings(); }
                                    }
                                }
                            }
                        }

                        // ── How to use ────────────────────────────────────────
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 8px;

                                SectionLabel { text: "HOW TO USE"; }

                                Body {
                                    text: "• Tap the mic orb to start, tap again to stop. The text is transcribed on-device and copied to the clipboard.\n• Recording stops on its own after 1.4 s of silence.\n• Models: switch engines. History: replay a turn. Settings: options.";
                                    font-size: 13px;
                                    color: #9A9A9A;
                                }
                            }
                        }

                        // Recent turns.
                        if root.turns.length > 0 : SectionLabel { text: "RECENT"; }

                        if root.turns.length > 0 : Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 4px;

                                for t[i] in root.turns : TurnRow {
                                    visible: i < 3;
                                    text: t.text;
                                    when: t.when;
                                    seconds: t.seconds;
                                }
                            }
                        }
                    }
                }

                // ══ HISTORY ══════════════════════════════════════════════
                if root.tab == 1 : ScrollView {
                    VerticalLayout {
                        width: 100%;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 4px;
                        padding-bottom: 20px;
                        // A layout without a stretched child shares the leftover
                        // space equally, which would stretch the cards. This
                        // sponge takes it instead.
                        Rectangle { vertical-stretch: 1; }
                        spacing: 12px;

                        Text {
                            text: "History";
                            font-size: 24px;
                            font-weight: 700;
                            color: #FFFFFF;
                            horizontal-alignment: left;
                        }

                        Body {
                            text: "Every finished turn, with its length. The newest one is on top.";
                            font-size: 13px;
                            color: #6B6B6B;
                        }

                        if root.turns.length == 0 : Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 20px;
                                spacing: 6px;

                                Body {
                                    text: "No turns yet";
                                    font-size: 15px;
                                }

                                Body {
                                    text: "Record something on the Listen tab and it shows up here.";
                                    font-size: 12px;
                                    color: #6B6B6B;
                                }
                            }
                        }

                        if root.turns.length > 0 : Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 4px;

                                for t[i] in root.turns : TurnRow {
                                    text: t.text;
                                    when: t.when;
                                    seconds: t.seconds;
                                }
                            }
                        }
                    }
                }

                // ══ MODELS ═══════════════════════════════════════════════
                if root.tab == 2 : ScrollView {
                    VerticalLayout {
                        width: 100%;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 4px;
                        padding-bottom: 20px;
                        // A layout without a stretched child shares the leftover
                        // space equally, which would stretch the cards. This
                        // sponge takes it instead.
                        Rectangle { vertical-stretch: 1; }
                        spacing: 12px;

                        Text {
                            text: "Models";
                            font-size: 24px;
                            font-weight: 700;
                            color: #FFFFFF;
                            horizontal-alignment: left;
                        }

                        Body {
                            text: "Every model below runs on this phone with the bundled engine. Nothing is bundled in the app — a model is downloaded once and then works offline.";
                            font-size: 13px;
                            color: #6B6B6B;
                        }

                        for m[i] in root.models : Card {
                            background: root.selected-model == i ? #0F1A13 : #0B0B0B;
                            border-color: root.selected-model == i ? #2E6B47 : #1E1E1E;

                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 10px;

                                HorizontalLayout {
                                    spacing: 10px;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: m.name;
                                        font-size: 15px;
                                        font-weight: 600;
                                        color: #FFFFFF;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: m.size;
                                        font-size: 11px;
                                        color: #4A4A4A;
                                        horizontal-alignment: right;
                                    }
                                }

                                Body {
                                    text: m.detail;
                                    font-size: 12px;
                                    color: #6B6B6B;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    cross-axis-alignment: center;

                                    if m.installed : Rectangle {
                                        width: 104px;
                                        height: 38px;
                                        border-radius: 19px;
                                        background: #12241A;
                                        border-width: 1px;
                                        border-color: #245C3B;

                                        Text {
                                            text: "Installed";
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: #9FE8BA;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if !m.installed : ActionButton {
                                        width: 140px;
                                        height: 38px;
                                        label: root.model-downloading ? "Downloading…" : "Download";
                                        primary: true;
                                        enabled: !root.model-downloading;
                                        clicked => { root.pick-model(i); root.download-model(); }
                                    }

                                    ActionButton {
                                        width: 92px;
                                        height: 38px;
                                        label: root.selected-model == i ? "Selected" : "Use";
                                        primary: root.selected-model != i;
                                        enabled: root.selected-model != i;
                                        clicked => { root.pick-model(i); }
                                    }
                                }
                            }
                        }

                        Body {
                            text: "The phone build is English only — the multilingual engines (SenseVoice, Parakeet, Qwen3-ASR) are part of the desktop app.";
                            font-size: 11px;
                            color: #4A4A4A;
                        }
                    }
                }

                // ══ SETTINGS ═════════════════════════════════════════════
                if root.tab == 3 : ScrollView {
                    VerticalLayout {
                        width: 100%;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 4px;
                        padding-bottom: 20px;
                        // A layout without a stretched child shares the leftover
                        // space equally, which would stretch the cards. This
                        // sponge takes it instead.
                        Rectangle { vertical-stretch: 1; }
                        spacing: 12px;

                        Text {
                            text: "Settings";
                            font-size: 24px;
                            font-weight: 700;
                            color: #FFFFFF;
                            horizontal-alignment: left;
                        }

                        // Engine card.
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 8px;

                                SectionLabel { text: "ENGINE"; }

                                Body {
                                    text: root.models.length > 0 ? root.models[root.selected-model].name : "No model";
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: #FFFFFF;
                                }

                                Body {
                                    text: root.models.length > 0 ? root.models[root.selected-model].detail : "";
                                    font-size: 12px;
                                    color: #6B6B6B;
                                }
                            }
                        }

                        // Behaviour card.
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 6px;
                                padding-bottom: 6px;

                                Rectangle {
                                    height: 60px;
                                    background: transparent;

                                    HorizontalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        cross-axis-alignment: center;
                                        spacing: 12px;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;

                                            Body {
                                                text: "Unload model when idle";
                                                font-size: 14px;
                                            }

                                            Body {
                                                text: "Frees RAM after a minute without speech";
                                                font-size: 11px;
                                                color: #5E5E5E;
                                            }
                                        }

                                        Toggle {
                                            on: root.auto-offload;
                                            toggled => { root.auto-offload = !root.auto-offload; }
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: #1A1A1A; }

                                Rectangle {
                                    height: 60px;
                                    background: transparent;

                                    HorizontalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        cross-axis-alignment: center;
                                        spacing: 12px;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;

                                            Body {
                                                text: "Haptic feedback";
                                                font-size: 14px;
                                            }

                                            Body {
                                                text: "A short buzz when listening starts and stops";
                                                font-size: 11px;
                                                color: #5E5E5E;
                                            }
                                        }

                                        Toggle {
                                            on: root.haptics;
                                            toggled => { root.haptics = !root.haptics; }
                                        }
                                    }
                                }
                            }
                        }

                        // Floating bubble card.
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 8px;

                                SectionLabel { text: "FLOATING BUBBLE"; }

                                Body {
                                    text: root.overlay-ok
                                        ? "On. A small bubble follows you across apps and shows the mic state and the last transcript."
                                        : "Off. The bubble needs the “Display over other apps” permission.";
                                    font-size: 12px;
                                    color: #6B6B6B;
                                }

                                ActionButton {                                    label: root.overlay-ok ? "Hide the bubble" : "Open the settings";
                                    primary: false;
                                    clicked => {
                                        if root.overlay-ok { root.toggle-overlay(); } else { root.open-overlay-settings(); }
                                    }
                                }
                            }
                        }

                        // Typing card — how the text reaches another app.
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 8px;

                                SectionLabel { text: "TYPING INTO OTHER APPS"; }

                                Body {
                                    text: "QuickSTT types with real key events (InputManager.injectInputEvent). Android only allows that for apps with the INJECT_EVENTS permission — on a rooted phone or a userdebug build run:\nadb shell pm grant ai.quickstt.app android.permission.INJECT_EVENTS\nWithout it the text is copied to the clipboard and the bubble says so.";
                                    font-size: 12px;
                                    color: #6B6B6B;
                                }

                                ActionButton {                                    label: "Type the last transcript";
                                    primary: false;
                                    enabled: root.has-text;
                                    clicked => { root.type-into-app(); }
                                }
                            }
                        }

                        // Diagnostics — what the app did, in plain words.
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 8px;

                                SectionLabel { text: "ACTIVITY"; }

                                Body {
                                    text: root.log-text != "" ? root.log-text : "Nothing yet.";
                                    font-size: 12px;
                                    color: #6B6B6B;
                                }
                            }
                        }

                        Text {
                            text: "QuickSTT · offline speech, no account, no cloud";
                            font-size: 11px;
                            color: #3A3A3A;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // ── Bottom navigation ─────────────────────────────────────────
            Rectangle {
                height: 1px;
                background: #1A1A1A;
            }

            Rectangle {
                height: 66px;
                background: #080808;

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;

                    NavItem {
                        width: 25%;
                        icon: 0;
                        label: "Listen";
                        active: root.tab == 0;
                        picked => { root.nav(0); }
                    }

                    NavItem {
                        width: 25%;
                        icon: 1;
                        label: "History";
                        active: root.tab == 1;
                        picked => { root.nav(1); }
                    }

                    NavItem {
                        width: 25%;
                        icon: 2;
                        label: "Models";
                        active: root.tab == 2;
                        picked => { root.nav(2); }
                    }

                    NavItem {
                        width: 25%;
                        icon: 3;
                        label: "Settings";
                        active: root.tab == 3;
                        picked => { root.nav(3); }
                    }
                }
            }

            // Home-indicator allowance on gesture-nav phones.
            Rectangle {
                height: 16px;
                background: #080808;
            }
        }
    }
}



