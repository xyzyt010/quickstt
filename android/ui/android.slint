// QuickSTT for Android — Touch-first minimalist monochrome UI.
//
// Palette: Deep black #000000, dark grey #121212, subtle borders #242424,
// crisp pure white #FFFFFF accents and light grey text #EDEDED. No greens.

export struct Turn {
    text: string,
    when: string,
    seconds: int,
}

// A speech model that really runs on this phone.
export struct ModelItem {
    name: string,
    detail: string,
    size: string,
    installed: bool,
    downloading: bool,
    progress: float,
    engine: string,
}

// ── Small building blocks ──────────────────────────────────────────────────

// Minimalist status dot that fills white when active.
component StatusDot inherits Rectangle {
    in property <bool> active;
    width: 7px;
    height: 7px;
    border-radius: 3.5px;
    background: root.active ? #FFFFFF : #444444;
    animate background { duration: 160ms; }
}

// Standard body text.
component Body inherits Text {
    horizontal-alignment: left;
    color: #EDEDED;
    wrap: word-wrap;
}

// Small caps section heading.
component SectionLabel inherits Text {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #777777;
    horizontal-alignment: left;
    wrap: word-wrap;
}

// Minimalist, robust horizontal progress bar pinned to the left (x: 0).
component ProgressBar inherits Rectangle {
    in property <float> progress: 0.0;
    height: 4px;
    border-radius: 2px;
    background: #222222;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * Math.max(0.0, Math.min(1.0, root.progress));
        height: parent.height;
        border-radius: 2px;
        background: #FFFFFF;
        animate width { duration: 120ms; easing: ease-out; }
    }
}

// ── Minimalist Vector Icons (22x22, monochrome) ───────────────────────────

// Minimalist microphone: sleek pill capsule + cradle arc + stem + base.
component IconMic inherits Rectangle {
    in property <color> tint: #FFFFFF;
    width: 22px;
    height: 22px;
    background: transparent;

    // Capsule
    Rectangle {
        x: 8px;
        y: 2px;
        width: 6px;
        height: 11px;
        border-radius: 3px;
        background: root.tint;
    }

    // Cradle arc
    Rectangle {
        x: 4.5px;
        y: 7px;
        width: 13px;
        height: 8px;
        background: transparent;
        border-width: 1.5px;
        border-color: root.tint;
        border-bottom-left-radius: 6.5px;
        border-bottom-right-radius: 6.5px;
        border-top-left-radius: 0px;
        border-top-right-radius: 0px;
    }

    // Stem
    Rectangle {
        x: 10.25px;
        y: 15px;
        width: 1.5px;
        height: 4px;
        background: root.tint;
    }

    // Base bar
    Rectangle {
        x: 6.5px;
        y: 18.5px;
        width: 9px;
        height: 1.5px;
        border-radius: 0.75px;
        background: root.tint;
    }
}

// Minimal list icon.
component IconList inherits Rectangle {
    in property <color> tint: #FFFFFF;
    width: 22px;
    height: 22px;
    background: transparent;
    Rectangle { width: 14px; height: 1.5px; x: 4px; y: 6px; border-radius: 1px; background: root.tint; }
    Rectangle { width: 14px; height: 1.5px; x: 4px; y: 10.5px; border-radius: 1px; background: root.tint; }
    Rectangle { width: 9px; height: 1.5px; x: 4px; y: 15px; border-radius: 1px; background: root.tint; }
}

// Minimal layers icon.
component IconLayers inherits Rectangle {
    in property <color> tint: #FFFFFF;
    width: 22px;
    height: 22px;
    background: transparent;
    Rectangle { width: 14px; height: 3px; x: 4px; y: 4.5px; border-radius: 1.5px; background: root.tint; }
    Rectangle { width: 14px; height: 3px; x: 4px; y: 9.5px; border-radius: 1.5px; background: root.tint; }
    Rectangle { width: 14px; height: 3px; x: 4px; y: 14.5px; border-radius: 1.5px; background: root.tint; }
}

// Minimal sliders icon.
component IconSliders inherits Rectangle {
    in property <color> tint: #FFFFFF;
    width: 22px;
    height: 22px;
    background: transparent;
    Rectangle { width: 14px; height: 1.5px; x: 4px; y: 7px; border-radius: 1px; background: root.tint; }
    Rectangle { width: 4px; height: 4px; x: 6px; y: 5.75px; border-radius: 2px; background: root.tint; }
    Rectangle { width: 14px; height: 1.5px; x: 4px; y: 14px; border-radius: 1px; background: root.tint; }
    Rectangle { width: 4px; height: 4px; x: 13px; y: 12.75px; border-radius: 2px; background: root.tint; }
}

// ── Controls ───────────────────────────────────────────────────────────────

// Minimal toggle switch (monochrome dark grey / white).
component Toggle inherits Rectangle {
    in-out property <bool> on;
    callback toggled();

    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: root.on ? #FFFFFF : #1A1A1A;
    border-width: 1px;
    border-color: root.on ? #FFFFFF : #333333;
    animate background { duration: 150ms; easing: ease-out; }

    Rectangle {
        width: 20px;
        height: 20px;
        y: 2px;
        x: root.on ? 21px : 2px;
        border-radius: 10px;
        background: root.on ? #000000 : #888888;
        animate x { duration: 150ms; easing: ease-out; }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.toggled(); }
    }
}

// Sleek high-contrast action button.
component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: true;
    in property <bool> enabled: true;
    in property <bool> destructive: false;
    callback clicked();

    height: 42px;
    border-radius: 21px;
    background: !root.enabled ? #141414 : (root.primary ? #FFFFFF : (root.destructive ? #201414 : #1A1A1A));
    border-width: 1px;
    border-color: !root.enabled ? #222222 : (root.primary ? #FFFFFF : (root.destructive ? #4A2222 : #333333));
    animate background { duration: 140ms; }
    animate border-color { duration: 140ms; }

    Text {
        text: root.label;
        font-size: 13px;
        font-weight: 600;
        color: !root.enabled ? #555555 : (root.primary ? #000000 : (root.destructive ? #FF8888 : #FFFFFF));
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A sleek card: deep black/grey #121212 with subtle #222222 border.
component Card inherits Rectangle {
    border-radius: 14px;
    background: #121212;
    border-width: 1px;
    border-color: #242424;
}

// Bottom navigation item.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <int> icon: 0;
    in property <bool> active;
    callback picked();

    horizontal-stretch: 1;
    background: transparent;

    // Active top rail indicator
    Rectangle {
        x: (parent.width - 20px) / 2;
        y: 0;
        width: 20px;
        height: 2px;
        border-radius: 1px;
        background: root.active ? #FFFFFF : transparent;
        animate background { duration: 150ms; }
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        alignment: center;
        cross-axis-alignment: center;
        spacing: 4px;

        Rectangle {
            width: 22px;
            height: 22px;
            background: transparent;

            if root.icon == 0 : IconMic { tint: root.active ? #FFFFFF : #666666; }
            if root.icon == 1 : IconList { tint: root.active ? #FFFFFF : #666666; }
            if root.icon == 2 : IconLayers { tint: root.active ? #FFFFFF : #666666; }
            if root.icon == 3 : IconSliders { tint: root.active ? #FFFFFF : #666666; }
        }

        Text {
            text: root.label;
            font-size: 10px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? #FFFFFF : #666666;
            horizontal-alignment: center;
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.picked(); }
    }
}

// Turn row in history.
component TurnRow inherits Rectangle {
    in property <string> text;
    in property <string> when;
    in property <int> seconds;

    height: 60px;
    background: transparent;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        cross-axis-alignment: center;

        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: #1A1A1A;
            border-width: 1px;
            border-color: #2E2E2E;

            Path {
                width: 8px;
                height: 10px;
                x: 13px;
                y: 11px;
                commands: "M 0 0 L 8 5 L 0 10 Z";
                fill: #FFFFFF;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Body {
                text: root.text;
                font-size: 13px;
                overflow: elide;
            }

            Text {
                text: root.when;
                font-size: 11px;
                color: #777777;
                horizontal-alignment: left;
                overflow: elide;
            }
        }

        Text {
            text: "\{root.seconds}s";
            font-size: 11px;
            color: #777777;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// Numbered setup step with monochrome badge.
component SetupStep inherits Rectangle {
    in property <string> number: "1";
    in property <string> title;
    in property <string> detail;
    in property <string> extra: "";
    in property <bool> done: false;
    in property <bool> busy: false;
    in property <string> action-label: "";
    in property <bool> action-primary: true;
    in property <bool> action-enabled: true;
    in property <float> progress: 0.0;
    callback action();

    min-height: 72px;
    background: transparent;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 12px;
        cross-axis-alignment: center;

        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: root.done ? #FFFFFF : #1E1E1E;
            border-width: 1px;
            border-color: root.done ? #FFFFFF : #3A3A3A;

            Text {
                text: root.done ? "✓" : root.number;
                font-size: 11px;
                font-weight: 700;
                color: root.done ? #000000 : #888888;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;

            Body {
                text: root.title;
                font-size: 14px;
                font-weight: 600;
            }

            Body {
                text: root.detail;
                font-size: 12px;
                color: #888888;
            }

            if root.extra != "" : Body {
                text: root.extra;
                font-size: 11px;
                color: #AAAAAA;
            }

            if root.busy : ProgressBar {
                progress: root.progress;
            }
        }

        if root.action-label != "" : ActionButton {
            width: 90px;
            height: 36px;
            label: root.action-label;
            primary: root.action-primary;
            enabled: root.action-enabled && !root.busy;
            clicked => { root.action(); }
        }
    }
}

// ══════════════════════════════════════════════════════════════════════════════
//  MAIN APP WINDOW
// ══════════════════════════════════════════════════════════════════════════════

export component AppWindow inherits Window {
    title: "QuickSTT";
    background: #000000;
    default-font-size: 15px;
    preferred-width: 412px;
    preferred-height: 760px;

    in-out property <int> tab: 0;
    in-out property <bool> recording: false;
    in-out property <string> live-text: "Tap the mic, then speak.";
    in-out property <int> selected-model: 0;
    in-out property <bool> auto-offload: true;
    in-out property <bool> haptics: true;
    in-out property <float> pulse: 0.0;
    in-out property <string> status-text: "Ready";
    in-out property <bool> mic-ok: false;
    in-out property <bool> model-installed: false;
    in-out property <bool> model-downloading: false;
    in-out property <float> model-progress: 0.0;
    in-out property <bool> overlay-ok: false;
    in-out property <bool> overlay-enabled: false;
    in-out property <bool> busy: false;
    in-out property <bool> has-text: false;
    in-out property <string> mic-health: "";
    in-out property <string> log-text: "";
    in-out property <string> touch-probe: "No tap yet";
    in-out property <string> test-result: "";
    in-out property <bool> test-running: false;
    in-out property <string> diagnostics: "";
    in-out property <bool> background-ok: false;
    in-out property <bool> battery-ok: false;
    in property <[string]> tabs: ["Listen", "History", "Models", "Settings"];

    in-out property <[Turn]> turns: [];
    in-out property <[ModelItem]> models: [];

    callback toggle-record();
    callback pick-model(int);
    callback nav(int);
    callback test-mic();
    callback test-model(int);
    callback run-diagnostics();
    callback copy-diagnostics();
    callback request-battery-exemption();
    callback grant-mic();
    callback download-model();
    callback uninstall-model(int);
    callback toggle-overlay();
    callback open-overlay-settings();
    callback type-into-app();
    callback share-text();
    callback report-tap(float, float);

    Rectangle {
        background: #000000;

        VerticalLayout {
            width: parent.width;
            height: parent.height;

            // Status bar spacer
            Rectangle { height: 24px; background: transparent; }

            // ── Top Header ─────────────────────────────────────────────────
            Rectangle {
                height: 58px;
                background: transparent;

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 10px;
                    cross-axis-alignment: center;

                    Text {
                        text: "QuickSTT";
                        font-size: 19px;
                        font-weight: 700;
                        color: #FFFFFF;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // Pill status badge
                    Rectangle {
                        width: 96px;
                        height: 28px;
                        border-radius: 14px;
                        background: root.recording ? #FFFFFF : #121212;
                        border-width: 1px;
                        border-color: root.recording ? #FFFFFF : #262626;

                        HorizontalLayout {
                            width: parent.width;
                            height: parent.height;
                            padding-left: 10px;
                            padding-right: 12px;
                            spacing: 6px;
                            cross-axis-alignment: center;

                            StatusDot { active: root.recording; }

                            Text {
                                text: root.recording ? "Listening" : "Ready";
                                font-size: 11px;
                                font-weight: 600;
                                color: root.recording ? #000000 : #888888;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // ── Main Body ──────────────────────────────────────────────────
            Rectangle {
                vertical-stretch: 1;
                background: #000000;

                // ══ TAB 0: LISTEN ════════════════════════════════════════
                if root.tab == 0 : Flickable {
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 4px;
                        padding-bottom: 24px;
                        Rectangle { vertical-stretch: 1; }
                        spacing: 14px;

                        // Status notification card
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 6px;

                                SectionLabel {
                                    text: root.recording ? "LISTENING" : (root.busy ? "PROCESSING" : "STATUS");
                                }

                                Body {
                                    text: root.status-text;
                                    font-size: 14px;
                                    font-weight: 500;
                                }

                                if root.log-text != "" : Body {
                                    text: root.log-text;
                                    font-size: 11px;
                                    color: #777777;
                                }

                                Body {
                                    text: root.touch-probe;
                                    font-size: 10px;
                                    color: #555555;
                                }
                            }

                            probe := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => {
                                    root.report-tap(probe.mouse-x / 1px, probe.mouse-y / 1px);
                                }
                            }
                        }

                        // Minimalist Recording Orb
                        Rectangle {
                            height: 190px;
                            background: transparent;

                            // Outer pulse halo (monochrome)
                            Rectangle {
                                width: 154px + root.pulse * 24px;
                                height: 154px + root.pulse * 24px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: self.width / 2;
                                background: transparent;
                                border-width: 1.5px;
                                border-color: #FFFFFF;
                                opacity: root.recording ? 0.6 - root.pulse * 0.5 : 0.0;
                            }

                            // Main touchable orb
                            Rectangle {
                                width: 154px;
                                height: 154px;
                                x: (parent.width - 154px) / 2;
                                y: (parent.height - 154px) / 2;
                                border-radius: 77px;
                                background: root.recording ? #262626 : #121212;
                                border-width: 1.5px;
                                border-color: root.recording ? #FFFFFF : #333333;
                                animate background { duration: 180ms; }
                                animate border-color { duration: 180ms; }

                                // Large clean minimalist mic icon in center
                                Rectangle {
                                    x: (parent.width - 40px) / 2;
                                    y: 40px;
                                    width: 40px;
                                    height: 52px;
                                    background: transparent;

                                    // Capsule
                                    Rectangle {
                                        x: 13px;
                                        y: 0px;
                                        width: 14px;
                                        height: 26px;
                                        border-radius: 7px;
                                        background: #FFFFFF;
                                    }

                                    // Cradle arc
                                    Rectangle {
                                        x: 6px;
                                        y: 12px;
                                        width: 28px;
                                        height: 19px;
                                        background: transparent;
                                        border-width: 2.5px;
                                        border-color: #FFFFFF;
                                        border-bottom-left-radius: 14px;
                                        border-bottom-right-radius: 14px;
                                        border-top-left-radius: 0px;
                                        border-top-right-radius: 0px;
                                    }

                                    // Stem
                                    Rectangle {
                                        x: 18.75px;
                                        y: 31px;
                                        width: 2.5px;
                                        height: 10px;
                                        background: #FFFFFF;
                                    }

                                    // Base bar
                                    Rectangle {
                                        x: 11px;
                                        y: 41px;
                                        width: 18px;
                                        height: 2.5px;
                                        border-radius: 1.25px;
                                        background: #FFFFFF;
                                    }
                                }

                                Text {
                                    y: 106px;
                                    width: parent.width;
                                    text: root.recording ? "STOP" : "REC";
                                    font-size: 12px;
                                    font-weight: 700;
                                    letter-spacing: 1.5px;
                                    color: #FFFFFF;
                                    horizontal-alignment: center;
                                }

                                TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    clicked => { root.toggle-record(); }
                                }
                            }
                        }

                        Text {
                            text: root.recording ? "Listening… tap to finish" : "Tap the orb to start dictating";
                            font-size: 13px;
                            color: #888888;
                            horizontal-alignment: center;
                        }

                        // Model Selector Chip
                        Rectangle {
                            height: 48px;
                            border-radius: 10px;
                            background: #121212;
                            border-width: 1px;
                            border-color: #242424;

                            HorizontalLayout {
                                width: parent.width;
                                height: parent.height;
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 10px;
                                cross-axis-alignment: center;

                                StatusDot { active: root.model-installed; }

                                Text {
                                    text: root.models.length > 0 ? root.models[root.selected-model].name : "No model";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: #FFFFFF;
                                    horizontal-alignment: left;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.models.length > 0 ? root.models[root.selected-model].size : "";
                                    font-size: 12px;
                                    color: #666666;
                                    horizontal-alignment: left;
                                }

                                Text {
                                    text: "Switch ›";
                                    font-size: 12px;
                                    color: #999999;
                                    horizontal-alignment: right;
                                    horizontal-stretch: 1;
                                }
                            }

                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => { root.nav(2); }
                            }
                        }

                        // Live transcript & Output actions
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 10px;

                                SectionLabel {
                                    text: root.recording ? "TRANSCRIPTION" : "TRANSCRIPT";
                                }

                                Body {
                                    text: root.live-text;
                                    font-size: 15px;
                                    color: root.recording ? #FFFFFF : #AAAAAA;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    cross-axis-alignment: center;

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        height: 38px;
                                        label: "Type into app";
                                        primary: false;
                                        enabled: root.has-text;
                                        clicked => { root.type-into-app(); }
                                    }

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        height: 38px;
                                        label: "Share";
                                        primary: false;
                                        enabled: root.has-text;
                                        clicked => { root.share-text(); }
                                    }
                                }
                            }
                        }

                        // ── Setup Walkthrough ──────────────────────────────
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 6px;

                                SectionLabel { text: "SETUP GUIDE"; }

                                SetupStep {
                                    number: "1";
                                    title: "Microphone Access";
                                    detail: root.mic-ok ? "Permission granted — ready to listen." : "Required for voice dictation.";
                                    extra: root.mic-health;
                                    done: root.mic-ok;
                                    action-label: root.mic-ok ? "Test" : "Allow";
                                    action-primary: !root.mic-ok;
                                    action => {
                                        if root.mic-ok { root.test-mic(); } else { root.grant-mic(); }
                                    }
                                }

                                SetupStep {
                                    number: "2";
                                    title: "Speech Model";
                                    detail: root.model-installed
                                        ? (root.models.length > 0 ? root.models[root.selected-model].name + " is installed" : "Installed")
                                        : (root.model-downloading ? "Downloading…" : (root.models.length > 0 ? root.models[root.selected-model].name + " · " + root.models[root.selected-model].size : "Download required"));
                                    done: root.model-installed;
                                    busy: root.model-downloading;
                                    progress: root.model-progress;
                                    action-label: root.model-installed ? "Ready" : (root.model-downloading ? "…" : "Download");
                                    action-primary: !root.model-installed;
                                    action => { root.download-model(); }
                                }

                                SetupStep {
                                    number: "3";
                                    title: "Floating Overlay";
                                    detail: root.overlay-ok
                                        ? (root.overlay-enabled ? "Active — bubble floats over other apps." : "Allowed — switch on to display over apps.")
                                        : "Display over other apps permission required.";
                                    done: root.overlay-enabled;
                                    action-label: root.overlay-enabled ? "Disable" : (root.overlay-ok ? "Enable" : "Allow");
                                    action-primary: !root.overlay-enabled;
                                    action => { root.toggle-overlay(); }
                                }
                            }
                        }

                        // Recent dictations
                        if root.turns.length > 0 : SectionLabel { text: "RECENT TRANSCRIPTS"; }

                        if root.turns.length > 0 : Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 4px;

                                for t[i] in root.turns : TurnRow {
                                    visible: i < 3;
                                    text: t.text;
                                    when: t.when;
                                    seconds: t.seconds;
                                }
                            }
                        }
                    }
                }

                // ══ TAB 1: HISTORY ═══════════════════════════════════════
                if root.tab == 1 : Flickable {
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 4px;
                        padding-bottom: 24px;
                        Rectangle { vertical-stretch: 1; }
                        spacing: 12px;

                        Text {
                            text: "History";
                            font-size: 22px;
                            font-weight: 700;
                            color: #FFFFFF;
                            horizontal-alignment: left;
                        }

                        Body {
                            text: "Past voice dictations saved locally on your device.";
                            font-size: 13px;
                            color: #777777;
                        }

                        if root.turns.length == 0 : Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 20px;
                                spacing: 6px;

                                Body {
                                    text: "No transcripts recorded yet";
                                    font-size: 14px;
                                    font-weight: 600;
                                }

                                Body {
                                    text: "Tap the microphone on the Listen tab to start dictating.";
                                    font-size: 12px;
                                    color: #777777;
                                }
                            }
                        }

                        if root.turns.length > 0 : Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 4px;

                                for t[i] in root.turns : TurnRow {
                                    text: t.text;
                                    when: t.when;
                                    seconds: t.seconds;
                                }
                            }
                        }
                    }
                }

                // ══ TAB 2: MODELS ════════════════════════════════════════
                if root.tab == 2 : Flickable {
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 4px;
                        padding-bottom: 24px;
                        Rectangle { vertical-stretch: 1; }
                        spacing: 12px;

                        Text {
                            text: "Speech Models";
                            font-size: 22px;
                            font-weight: 700;
                            color: #FFFFFF;
                            horizontal-alignment: left;
                        }

                        Body {
                            text: "All speech models run 100% offline on-device. Manage and test speech engines below.";
                            font-size: 13px;
                            color: #777777;
                        }

                        if root.status-text != "" : Text {
                            text: root.status-text;
                            font-size: 12px;
                            color: #FFFFFF;
                            horizontal-alignment: left;
                            wrap: word-wrap;
                        }

                        // Test Benchmark Card
                        Card {
                            background: #181818;
                            border-color: #333333;

                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 8px;

                                SectionLabel {
                                    text: "BENCHMARK & TEST";
                                    color: #FFFFFF;
                                }

                                Body {
                                    text: root.test-result != ""
                                        ? root.test-result
                                        : "Tap “Test” on any installed model to run a 4-second audio benchmark.";
                                    font-size: 12px;
                                    color: #CCCCCC;
                                }
                            }
                        }

                        // Model Cards
                        for m[i] in root.models : Card {
                            background: root.selected-model == i ? #181818 : #121212;
                            border-color: root.selected-model == i ? #FFFFFF : #242424;

                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 10px;

                                HorizontalLayout {
                                    spacing: 10px;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: m.name;
                                        font-size: 15px;
                                        font-weight: 600;
                                        color: #FFFFFF;
                                        horizontal-alignment: left;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: m.size;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #888888;
                                        horizontal-alignment: right;
                                    }
                                }

                                Body {
                                    text: m.detail;
                                    font-size: 12px;
                                    color: #777777;
                                }

                                // Proper progress bar pinned to the left, starting from 0%
                                if m.downloading : VerticalLayout {
                                    width: 100%;
                                    spacing: 6px;

                                    ProgressBar {
                                        progress: m.progress;
                                    }

                                    HorizontalLayout {
                                        Text {
                                            text: "Downloading model…";
                                            font-size: 11px;
                                            color: #AAAAAA;
                                            horizontal-alignment: left;
                                            horizontal-stretch: 1;
                                        }

                                        Text {
                                            text: (m.progress * 100.0) + "%";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #FFFFFF;
                                            horizontal-alignment: right;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    cross-axis-alignment: center;

                                    // If not installed: Download button
                                    if !m.installed && !m.downloading : ActionButton {
                                        width: 120px;
                                        height: 36px;
                                        label: "Download";
                                        primary: true;
                                        enabled: !root.model-downloading;
                                        clicked => { root.pick-model(i); root.download-model(); }
                                    }

                                    // If downloading: status badge
                                    if m.downloading : Rectangle {
                                        width: 120px;
                                        height: 36px;
                                        border-radius: 18px;
                                        background: #1C1C1C;
                                        border-width: 1px;
                                        border-color: #333333;

                                        Text {
                                            text: "Downloading…";
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: #FFFFFF;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Use / Selected button
                                    if m.installed : ActionButton {
                                        width: 90px;
                                        height: 36px;
                                        label: root.selected-model == i ? "Active" : "Use";
                                        primary: root.selected-model != i;
                                        enabled: root.selected-model != i;
                                        clicked => { root.pick-model(i); }
                                    }

                                    // Test button
                                    if m.installed : ActionButton {
                                        width: 74px;
                                        height: 36px;
                                        label: "Test";
                                        primary: false;
                                        enabled: !root.test-running;
                                        clicked => { root.test-model(i); }
                                    }

                                    // Uninstall button
                                    if m.installed : ActionButton {
                                        width: 88px;
                                        height: 36px;
                                        label: "Uninstall";
                                        primary: false;
                                        destructive: true;
                                        clicked => { root.uninstall-model(i); }
                                    }
                                }
                            }
                        }
                    }
                }

                // ══ TAB 3: SETTINGS ══════════════════════════════════════
                if root.tab == 3 : Flickable {
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 4px;
                        padding-bottom: 24px;
                        Rectangle { vertical-stretch: 1; }
                        spacing: 12px;

                        Text {
                            text: "Settings";
                            font-size: 22px;
                            font-weight: 700;
                            color: #FFFFFF;
                            horizontal-alignment: left;
                        }

                        // Floating bubble configuration
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 8px;

                                SectionLabel { text: "OVERLAY BUBBLE"; }

                                Body {
                                    text: "The floating bubble sits over your other apps with REC and TYPE buttons for seamless dictation anywhere.";
                                    font-size: 12px;
                                    color: #777777;
                                }

                                if root.overlay-ok : Rectangle {
                                    height: 50px;
                                    background: transparent;

                                    HorizontalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        cross-axis-alignment: center;
                                        spacing: 12px;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;

                                            Body {
                                                text: "Show floating bubble";
                                                font-size: 14px;
                                                font-weight: 500;
                                            }

                                            Body {
                                                text: "Always-on overlay above apps";
                                                font-size: 11px;
                                                color: #777777;
                                            }
                                        }

                                        Toggle {
                                            on: root.overlay-enabled;
                                            toggled => { root.toggle-overlay(); }
                                        }
                                    }
                                }

                                if !root.overlay-ok : ActionButton {
                                    label: "Grant overlay permission";
                                    primary: true;
                                    clicked => { root.open-overlay-settings(); }
                                }
                            }
                        }

                        // Battery & Background Keep-Alive
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 8px;

                                SectionLabel { text: "BACKGROUND SERVICE"; }

                                Body {
                                    text: root.battery-ok
                                        ? "Battery optimization exemption is active. QuickSTT will not be terminated while in the background."
                                        : "Exempt QuickSTT from battery restrictions so the overlay stays active when switching apps.";
                                    font-size: 12px;
                                    color: #777777;
                                }

                                if !root.battery-ok : ActionButton {
                                    label: "Allow running in background";
                                    primary: false;
                                    clicked => { root.request-battery-exemption(); }
                                }
                            }
                        }

                        // Activity log
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 8px;

                                SectionLabel { text: "ACTIVITY LOG"; }

                                Body {
                                    text: root.log-text != "" ? root.log-text : "No events recorded.";
                                    font-size: 12px;
                                    color: #777777;
                                }
                            }
                        }

                        // Diagnostics self-test
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 8px;

                                SectionLabel { text: "DIAGNOSTICS & SYSTEM"; }

                                Body {
                                    text: root.diagnostics != ""
                                        ? root.diagnostics
                                        : "Verifies microphone permissions, speech engines and downloaded models.";
                                    font-size: 11px;
                                    color: #777777;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    cross-axis-alignment: center;

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        height: 38px;
                                        label: "Run Self-Test";
                                        primary: false;
                                        clicked => { root.run-diagnostics(); }
                                    }

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        height: 38px;
                                        label: "Copy";
                                        primary: false;
                                        enabled: root.diagnostics != "";
                                        clicked => { root.copy-diagnostics(); }
                                    }
                                }
                            }
                        }

                        Text {
                            text: "QuickSTT · 100% on-device speech-to-text";
                            font-size: 11px;
                            color: #444444;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // ── Bottom Navigation Bar ──────────────────────────────────────
            Rectangle {
                height: 1px;
                background: #1A1A1A;
            }

            Rectangle {
                height: 66px;
                background: #000000;

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;

                    NavItem {
                        width: 25%;
                        icon: 0;
                        label: "Listen";
                        active: root.tab == 0;
                        picked => { root.nav(0); }
                    }

                    NavItem {
                        width: 25%;
                        icon: 1;
                        label: "History";
                        active: root.tab == 1;
                        picked => { root.nav(1); }
                    }

                    NavItem {
                        width: 25%;
                        icon: 2;
                        label: "Models";
                        active: root.tab == 2;
                        picked => { root.nav(2); }
                    }

                    NavItem {
                        width: 25%;
                        icon: 3;
                        label: "Settings";
                        active: root.tab == 3;
                        picked => { root.nav(3); }
                    }
                }
            }

            // Home-indicator safe area
            Rectangle {
                height: 16px;
                background: #000000;
            }
        }
    }
}
