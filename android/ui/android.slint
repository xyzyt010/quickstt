// QuickSTT for Android — Touch-first STT UI with live white waveforms,
// deep black surfaces (#000000 / #0A0A0F), subtle purple highlights (#A855F7),
// inbuilt Cactus Needle model status, and real RAM onloading / offloading controls.

export struct Turn {
    text: string,
    when: string,
    seconds: int,
}

export struct ModelItem {
    name: string,
    detail: string,
    size: string,
    installed: bool,
    bundled: bool,
    downloading: bool,
    progress: float,
    download-info: string,
    loaded: bool,
    ram-status: string,
    engine: string,
}

// ── Small building blocks ──────────────────────────────────────────────────

component StatusDot inherits Rectangle {
    in property <bool> active;
    in property <bool> accent: false;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.active ? (root.accent ? #A855F7 : #FFFFFF) : #3A3A44;
    animate background { duration: 160ms; }
}

component Body inherits Text {
    horizontal-alignment: left;
    color: #EDEDED;
    wrap: word-wrap;
}

component SectionLabel inherits Text {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
    color: #A855F7;
    horizontal-alignment: left;
    wrap: word-wrap;
}

// Left-pinned horizontal progress bar with purple-white highlight.
component ProgressBar inherits Rectangle {
    in property <float> progress: 0.0;
    in property <bool> purple: true;
    height: 6px;
    border-radius: 3px;
    background: #1A1A24;
    border-width: 1px;
    border-color: #2A2438;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * Math.max(0.0, Math.min(1.0, root.progress));
        height: parent.height;
        border-radius: 3px;
        background: root.purple ? @linear-gradient(90deg, #7C3AED 0%, #A855F7 55%, #FFFFFF 100%) : #FFFFFF;
        animate width { duration: 110ms; easing: ease-out; }
    }
}

// ── Minimalist Vector Icons (No mic icons — waveform, list, layers, sliders) ─

component IconWave inherits Rectangle {
    in property <color> tint: #FFFFFF;
    width: 22px;
    height: 22px;
    background: transparent;

    Rectangle { x: 2px;  y: 8px;  width: 2.2px; height: 6px;  border-radius: 1.1px; background: root.tint; }
    Rectangle { x: 6px;  y: 5px;  width: 2.2px; height: 12px; border-radius: 1.1px; background: root.tint; }
    Rectangle { x: 10px; y: 2.5px; width: 2.2px; height: 17px; border-radius: 1.1px; background: root.tint; }
    Rectangle { x: 14px; y: 5px;  width: 2.2px; height: 12px; border-radius: 1.1px; background: root.tint; }
    Rectangle { x: 18px; y: 8px;  width: 2.2px; height: 6px;  border-radius: 1.1px; background: root.tint; }
}

component IconList inherits Rectangle {
    in property <color> tint: #FFFFFF;
    width: 22px;
    height: 22px;
    background: transparent;
    Rectangle { width: 14px; height: 1.8px; x: 4px; y: 6px;    border-radius: 1px; background: root.tint; }
    Rectangle { width: 14px; height: 1.8px; x: 4px; y: 10.5px; border-radius: 1px; background: root.tint; }
    Rectangle { width: 9px;  height: 1.8px; x: 4px; y: 15px;   border-radius: 1px; background: root.tint; }
}

component IconLayers inherits Rectangle {
    in property <color> tint: #FFFFFF;
    width: 22px;
    height: 22px;
    background: transparent;
    Rectangle { width: 14px; height: 3px; x: 4px; y: 4.5px;  border-radius: 1.5px; background: root.tint; }
    Rectangle { width: 14px; height: 3px; x: 4px; y: 9.5px;  border-radius: 1.5px; background: root.tint; }
    Rectangle { width: 14px; height: 3px; x: 4px; y: 14.5px; border-radius: 1.5px; background: root.tint; }
}

component IconSliders inherits Rectangle {
    in property <color> tint: #FFFFFF;
    width: 22px;
    height: 22px;
    background: transparent;
    Rectangle { width: 14px; height: 1.5px; x: 4px;  y: 7px;     border-radius: 1px; background: root.tint; }
    Rectangle { width: 4px;  height: 4px;   x: 6px;  y: 5.75px;  border-radius: 2px; background: root.tint; }
    Rectangle { width: 14px; height: 1.5px; x: 4px;  y: 14px;    border-radius: 1px; background: root.tint; }
    Rectangle { width: 4px;  height: 4px;   x: 13px; y: 12.75px; border-radius: 2px; background: root.tint; }
}

// ── Super-Smooth White Waveform Component (No Mic Icons) ───────────────────

component SmoothWaveform inherits Rectangle {
    in property <float> phase: 0.0;
    in property <float> level: 0.0;
    in property <bool> active: false;
    in property <bool> busy: false;
    in property <bool> compact: false;

    height: root.compact ? 26px : 44px;
    background: transparent;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        alignment: center;
        spacing: root.compact ? 3px : 4px;

        for weight[idx] in (root.compact ? [0.42, 0.78, 1.0, 0.78, 0.42] : [
            0.22, 0.35, 0.50, 0.68, 0.82, 0.94, 1.00, 0.92,
            0.85, 0.96, 1.00, 0.90, 0.76, 0.58, 0.42, 0.28, 0.20
        ]) : Rectangle {
            width: root.compact ? 2.8px : 3.2px;
            height: parent.height;
            background: transparent;

            property <float> wave-a: Math.sin((root.phase * 360deg) + idx * 32deg);
            property <float> wave-b: Math.cos((root.phase * 240deg) - idx * 24deg);
            property <float> dyn: root.active
                ? (0.18 + weight * (0.22 + root.level * 0.78) * (0.55 + 0.45 * (0.5 + 0.32 * wave-a + 0.18 * wave-b)))
                : (root.busy
                    ? (0.18 + weight * 0.62 * (0.5 + 0.5 * wave-a))
                    : (0.16 + weight * 0.20 * (0.5 + 0.5 * wave-b)));
            property <length> bar-h: Math.max(4px, parent.height * Math.min(1.0, Math.max(0.14, dyn)));

            // Slight purple glow behind white bar
            Rectangle {
                x: -0.8px;
                y: (parent.height - self.height) / 2;
                width: parent.width + 1.6px;
                height: Math.min(parent.height, parent.bar-h + 3px);
                border-radius: self.width / 2;
                background: root.active ? #44A855F7 : #269333EA;
            }

            // Crisp pure white waveform bar
            Rectangle {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: parent.bar-h;
                border-radius: self.width / 2;
                background: #FFFFFF;
            }
        }
    }
}

// ── Controls ───────────────────────────────────────────────────────────────

component Toggle inherits Rectangle {
    in-out property <bool> on;
    callback toggled();

    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: root.on ? #9333EA : #161620;
    border-width: 1px;
    border-color: root.on ? #C084FC : #322C42;
    animate background { duration: 150ms; easing: ease-out; }

    Rectangle {
        width: 20px;
        height: 20px;
        y: 3px;
        x: root.on ? 23px : 3px;
        border-radius: 10px;
        background: #FFFFFF;
        animate x { duration: 150ms; easing: ease-out; }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.toggled(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: true;
    in property <bool> enabled: true;
    in property <bool> destructive: false;
    in property <bool> purple: false;
    callback clicked();

    height: 38px;
    border-radius: 19px;
    background: !root.enabled
        ? #111116
        : (root.primary
            ? (root.purple ? #9333EA : #FFFFFF)
            : (root.destructive ? #221216 : #151520));
    border-width: 1px;
    border-color: !root.enabled
        ? #20202A
        : (root.primary
            ? (root.purple ? #C084FC : #FFFFFF)
            : (root.destructive ? #52242E : #322A46));
    animate background { duration: 140ms; }
    animate border-color { duration: 140ms; }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        font-size: 12px;
        font-weight: 600;
        color: !root.enabled
            ? #525260
            : (root.primary
                ? (root.purple ? #FFFFFF : #000000)
                : (root.destructive ? #FF8896 : #F0EAFF));
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> highlight: false;
    in property <bool> active: false;

    height: 22px;
    width: label.preferred-width + 16px;
    border-radius: 11px;
    background: root.active ? #2A1642 : (root.highlight ? #1E182B : #15151C);
    border-width: 1px;
    border-color: root.active ? #A855F7 : (root.highlight ? #5B388A : #2A2A36);

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: 10px;
        font-weight: 700;
        color: root.active ? #E9D5FF : (root.highlight ? #C084FC : #9999AA);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Card inherits Rectangle {
    in property <bool> highlighted: false;
    border-radius: 16px;
    background: root.highlighted ? #0E0B16 : #0B0B10;
    border-width: 1px;
    border-color: root.highlighted ? #7C3AED : #231F32;
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <int> icon: 0;
    in property <bool> active;
    callback picked();

    horizontal-stretch: 1;
    background: transparent;

    Rectangle {
        x: (parent.width - 24px) / 2;
        y: 0;
        width: 24px;
        height: 2.5px;
        border-radius: 1.25px;
        background: root.active ? #A855F7 : transparent;
        animate background { duration: 150ms; }
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        alignment: center;
        spacing: 4px;

        Rectangle {
            width: 22px;
            height: 22px;
            x: (parent.width - self.width) / 2;
            background: transparent;

            if root.icon == 0 : IconWave    { tint: root.active ? #FFFFFF : #666478; }
            if root.icon == 1 : IconList    { tint: root.active ? #FFFFFF : #666478; }
            if root.icon == 2 : IconLayers  { tint: root.active ? #FFFFFF : #666478; }
            if root.icon == 3 : IconSliders { tint: root.active ? #FFFFFF : #666478; }
        }

        Text {
            text: root.label;
            font-size: 10px;
            font-weight: root.active ? 700 : 500;
            color: root.active ? #FFFFFF : #666478;
            horizontal-alignment: center;
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.picked(); }
    }
}

component TurnRow inherits Rectangle {
    in property <string> text;
    in property <string> when;
    in property <int> seconds;
    callback copy-clicked();

    min-height: 62px;
    background: transparent;

    HorizontalLayout {
        width: parent.width;
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;

        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: #141020;
            border-width: 1px;
            border-color: #3A2858;

            IconWave {
                x: 5px;
                y: 5px;
                tint: #FFFFFF;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Body {
                text: root.text;
                font-size: 13px;
            }

            Text {
                text: "\{root.when} · \{root.seconds}s";
                font-size: 11px;
                color: #88829E;
                horizontal-alignment: left;
            }
        }

        ActionButton {
            width: 62px;
            height: 30px;
            label: "Copy";
            primary: false;
            clicked => { root.copy-clicked(); }
        }
    }
}

component SetupStep inherits Rectangle {
    in property <string> number: "1";
    in property <string> title;
    in property <string> detail;
    in property <string> extra: "";
    in property <bool> done: false;
    in property <bool> busy: false;
    in property <string> action-label: "";
    in property <bool> action-primary: true;
    in property <bool> action-enabled: true;
    in property <float> progress: 0.0;
    callback action();

    min-height: 68px;
    background: transparent;

    HorizontalLayout {
        width: parent.width;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 12px;

        Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 13px;
            background: root.done ? #9333EA : #171522;
            border-width: 1px;
            border-color: root.done ? #C084FC : #342E48;

            Text {
                width: parent.width;
                height: parent.height;
                text: root.done ? "✓" : root.number;
                font-size: 11px;
                font-weight: 700;
                color: #FFFFFF;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;

            Body {
                text: root.title;
                font-size: 13px;
                font-weight: 600;
            }

            Body {
                text: root.detail;
                font-size: 11px;
                color: #9A96B0;
            }

            if root.extra != "" : Body {
                text: root.extra;
                font-size: 11px;
                color: #C084FC;
            }

            if root.busy : ProgressBar {
                progress: root.progress;
            }
        }

        if root.action-label != "" : ActionButton {
            width: 88px;
            height: 34px;
            label: root.action-label;
            primary: root.action-primary;
            purple: root.action-primary;
            enabled: root.action-enabled && !root.busy;
            clicked => { root.action(); }
        }
    }
}

// ══════════════════════════════════════════════════════════════════════════════
//  MAIN APP WINDOW
// ══════════════════════════════════════════════════════════════════════════════

export component AppWindow inherits Window {
    title: "QuickSTT";
    background: #000000;
    default-font-size: 15px;
    preferred-width: 412px;
    preferred-height: 760px;

    in-out property <int> tab: 0;
    in-out property <bool> recording: false;
    in-out property <string> live-text: "Press the live waveform pill to dictate.";
    in-out property <int> selected-model: 0;
    in-out property <bool> auto-offload: true;
    in-out property <bool> haptics: true;
    in-out property <float> pulse: 0.0;
    in-out property <float> wave-phase: 0.0;
    in-out property <float> audio-level: 0.0;
    in-out property <bool> bubble-expanded: false;
    in-out property <string> status-text: "Ready";
    in-out property <bool> mic-ok: false;
    in-out property <bool> model-installed: true;
    in-out property <bool> model-downloading: false;
    in-out property <float> model-progress: 0.0;
    in-out property <string> model-download-info: "";
    in-out property <bool> model-loaded: false;
    in-out property <string> model-ram-status: "Onloaded in RAM · Cactus Whistle 16M";
    in-out property <bool> overlay-ok: false;
    in-out property <bool> overlay-enabled: false;
    in-out property <bool> busy: false;
    in-out property <bool> has-text: false;
    in-out property <string> mic-health: "";
    in-out property <string> log-text: "";
    in-out property <string> touch-probe: "Window ready";
    in-out property <string> test-result: "";
    in-out property <bool> test-running: false;
    in-out property <string> diagnostics: "";
    in-out property <bool> background-ok: false;
    in-out property <bool> battery-ok: false;
    in property <[string]> tabs: ["Listen", "History", "Models", "Settings"];

    in-out property <[Turn]> turns: [];
    in-out property <[ModelItem]> models: [];

    callback toggle-record();
    callback pick-model(int);
    callback nav(int);
    callback test-mic();
    callback test-model(int);
    callback run-diagnostics();
    callback copy-diagnostics();
    callback request-battery-exemption();
    callback grant-mic();
    callback download-model();
    callback uninstall-model(int);
    callback onload-model(int);
    callback offload-model();
    callback toggle-auto-offload();
    callback toggle-overlay();
    callback toggle-bubble-expand();
    callback open-overlay-settings();
    callback type-into-app();
    callback share-text();
    callback copy-turn(string);
    callback clear-history();
    callback report-tap(float, float);

    Rectangle {
        background: #000000;

        VerticalLayout {
            width: parent.width;
            height: parent.height;

            // Top status bar safe spacer
            Rectangle { height: 22px; background: #000000; }

            // ── Top Header ─────────────────────────────────────────────────
            Rectangle {
                height: 54px;
                background: #000000;

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 10px;

                    // Brand mark: rounded-corner mini icon with white waveform
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 10px;
                        background: #09070F;
                        border-width: 1px;
                        border-color: #9333EA;

                        IconWave {
                            x: 5px;
                            y: 5px;
                            tint: #FFFFFF;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;

                        Text {
                            text: "QuickSTT";
                            font-size: 17px;
                            font-weight: 700;
                            color: #FFFFFF;
                            horizontal-alignment: left;
                        }

                        Text {
                            text: root.model-loaded ? root.model-ram-status : "On-device neural STT";
                            font-size: 10px;
                            color: #B497E7;
                            horizontal-alignment: left;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // Live Pill Status Badge
                    Rectangle {
                        width: 104px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 14px;
                        background: root.recording ? #1A0E2E : #0D0C14;
                        border-width: 1px;
                        border-color: root.recording ? #A855F7 : #2C263E;

                        HorizontalLayout {
                            width: parent.width;
                            height: parent.height;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;

                            StatusDot {
                                y: (parent.height - self.height) / 2;
                                active: root.recording || root.model-loaded;
                                accent: root.recording;
                            }

                            Text {
                                text: root.recording ? "Listening" : (root.busy ? "Decoding" : (root.model-loaded ? "RAM Ready" : "Standby"));
                                font-size: 11px;
                                font-weight: 600;
                                color: root.recording ? #FFFFFF : #C4B5FD;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // ── Main Content Area ──────────────────────────────────────────
            Rectangle {
                vertical-stretch: 1;
                background: #000000;
                clip: true;

                // ══ TAB 0: LISTEN ════════════════════════════════════════
                if root.tab == 0 : Flickable {
                    width: parent.width;
                    height: parent.height;

                    listen-layout := VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 6px;
                        padding-bottom: 28px;
                        spacing: 12px;

                        // 1. Status & Touch Probe Card
                        Card {
                            highlighted: root.recording;

                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 5px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    SectionLabel {
                                        text: root.recording ? "LIVE AUDIO STREAM" : (root.busy ? "NEURAL INFERENCE" : "ENGINE STATUS");
                                        horizontal-stretch: 1;
                                    }
                                    Badge {
                                        text: root.model-loaded ? "ONLOADED" : "OFFLOADED";
                                        active: root.model-loaded;
                                    }
                                }

                                Body {
                                    text: root.status-text;
                                    font-size: 14px;
                                    font-weight: 600;
                                }

                                if root.log-text != "" : Body {
                                    text: root.log-text;
                                    font-size: 11px;
                                    color: #8E88A8;
                                }

                                Body {
                                    text: root.touch-probe;
                                    font-size: 10px;
                                    color: #56506B;
                                }
                            }

                            probe := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => {
                                    root.report-tap(probe.mouse-x / 1px, probe.mouse-y / 1px);
                                }
                            }
                        }

                        // 2. Live Expandable Circular Waveform Pill (No Mic Icons!)
                        Card {
                            highlighted: true;

                            VerticalLayout {
                                width: parent.width;
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    SectionLabel {
                                        text: "LIVE WAVEFORM PILL (NO MIC ICON)";
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: root.bubble-expanded || root.recording ? "Expanded Circular Pill" : "Rounded-Corner Icon";
                                        font-size: 11px;
                                        color: #C084FC;
                                    }
                                }

                                // Interactive preview of the exact expandable bubble / dictation trigger
                                Rectangle {
                                    height: 76px;
                                    background: transparent;

                                    // Outer subtle purple ambient glow
                                    Rectangle {
                                        width: (root.bubble-expanded || root.recording ? 268px : 68px) + root.pulse * 14px;
                                        height: 62px + root.pulse * 10px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: (root.bubble-expanded || root.recording) ? self.height / 2 : 18px;
                                        background: #1E0D36;
                                        border-width: 1px;
                                        border-color: #6D28D9;
                                        opacity: root.recording ? 0.75 : 0.35;
                                        animate width { duration: 220ms; easing: ease-out; }
                                    }

                                    // Morphing Rounded-Corner Icon <-> Circular Pill
                                    Rectangle {
                                        width: (root.bubble-expanded || root.recording) ? 256px : 56px;
                                        height: 54px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: (root.bubble-expanded || root.recording) ? 27px : 15px;
                                        background: @linear-gradient(135deg, #050508 0%, #12091F 55%, #050508 100%);
                                        border-width: 1.5px;
                                        border-color: root.recording ? #C084FC : #8B5CF6;
                                        animate width { duration: 220ms; easing: ease-out; }
                                        animate border-radius { duration: 220ms; easing: ease-out; }
                                        animate border-color { duration: 160ms; }

                                        HorizontalLayout {
                                            width: parent.width;
                                            height: parent.height;
                                            padding-left: (root.bubble-expanded || root.recording) ? 16px : 10px;
                                            padding-right: (root.bubble-expanded || root.recording) ? 12px : 10px;
                                            spacing: 10px;

                                            SmoothWaveform {
                                                horizontal-stretch: 1;
                                                y: (parent.height - self.height) / 2;
                                                phase: root.wave-phase;
                                                level: root.audio-level;
                                                active: root.recording;
                                                busy: root.busy;
                                                compact: !(root.bubble-expanded || root.recording);
                                            }

                                            if (root.bubble-expanded || root.recording) : Rectangle {
                                                width: 52px;
                                                height: 28px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 14px;
                                                background: root.recording ? #9333EA : #1B132B;
                                                border-width: 1px;
                                                border-color: #A855F7;

                                                Text {
                                                    width: parent.width;
                                                    height: parent.height;
                                                    text: root.recording ? "STOP" : (root.busy ? "···" : "LIVE");
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: #FFFFFF;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            clicked => {
                                                if !root.bubble-expanded && !root.recording {
                                                    root.toggle-bubble-expand();
                                                }
                                                root.toggle-record();
                                            }
                                        }
                                    }
                                }

                                Text {
                                    text: root.recording
                                        ? "Listening with live white waveform — tap pill to finish"
                                        : "Tap the rounded-corner waveform icon to expand into the circular pill & dictate";
                                    font-size: 12px;
                                    color: #9A94B8;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        label: root.recording ? "Stop Recording" : "Start Dictation";
                                        primary: true;
                                        purple: true;
                                        clicked => { root.toggle-record(); }
                                    }

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        label: root.bubble-expanded ? "Collapse to Icon" : "Expand Pill";
                                        primary: false;
                                        clicked => { root.toggle-bubble-expand(); }
                                    }
                                }
                            }
                        }

                        // 3. Active Speech Model & Onload / Offload Bar
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 10px;

                                HorizontalLayout {
                                    spacing: 8px;

                                    StatusDot {
                                        y: (parent.height - self.height) / 2;
                                        active: root.model-installed;
                                        accent: root.model-loaded;
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;

                                        Text {
                                            text: root.models.length > 0 ? root.models[root.selected-model].name : "Cactus Whistle 16M";
                                            font-size: 14px;
                                            font-weight: 700;
                                            color: #FFFFFF;
                                            horizontal-alignment: left;
                                        }

                                        Text {
                                            text: root.model-ram-status;
                                            font-size: 11px;
                                            color: root.model-loaded ? #C084FC : #88849E;
                                            horizontal-alignment: left;
                                        }
                                    }

                                    Badge {
                                        text: root.models.length > 0 && root.models[root.selected-model].bundled ? "BUILT-IN" : "MODEL";
                                        highlight: true;
                                    }
                                }

                                if root.model-downloading : VerticalLayout {
                                    spacing: 4px;
                                    ProgressBar { progress: root.model-progress; }
                                    Text {
                                        text: root.model-download-info != ""
                                            ? root.model-download-info
                                            : ("Downloading… " + Math.round(root.model-progress * 100.0) + "%");
                                        font-size: 11px;
                                        color: #C084FC;
                                        horizontal-alignment: left;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        height: 34px;
                                        label: root.model-loaded ? "Reload in RAM" : "Onload to RAM";
                                        primary: !root.model-loaded;
                                        purple: !root.model-loaded;
                                        enabled: root.model-installed && !root.busy;
                                        clicked => { root.onload-model(root.selected-model); }
                                    }

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        height: 34px;
                                        label: "Offload RAM";
                                        primary: false;
                                        enabled: root.model-loaded && !root.busy;
                                        clicked => { root.offload-model(); }
                                    }

                                    ActionButton {
                                        width: 84px;
                                        height: 34px;
                                        label: "Models ›";
                                        primary: false;
                                        clicked => { root.nav(2); }
                                    }
                                }
                            }
                        }

                        // 4. Transcript & Direct Keystroke Output Card
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 10px;

                                SectionLabel {
                                    text: root.recording ? "LIVE TRANSCRIPTION" : "TRANSCRIPT OUTPUT";
                                }

                                Body {
                                    text: root.live-text;
                                    font-size: 15px;
                                    color: root.recording ? #FFFFFF : #E2DCF5;
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        label: "Type into App";
                                        primary: true;
                                        purple: true;
                                        enabled: root.has-text;
                                        clicked => { root.type-into-app(); }
                                    }

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        label: "Copy";
                                        primary: false;
                                        enabled: root.has-text;
                                        clicked => { root.copy-turn(root.live-text); }
                                    }

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        label: "Share";
                                        primary: false;
                                        enabled: root.has-text;
                                        clicked => { root.share-text(); }
                                    }
                                }
                            }
                        }

                        // 5. Setup & Permissions Checklist
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 6px;

                                SectionLabel { text: "QUICK SETUP & OVERLAY"; }

                                SetupStep {
                                    number: "1";
                                    title: "Microphone Capture (AAudio)";
                                    detail: root.mic-ok ? "Granted — 16 kHz low-latency input ready." : "Allow microphone access for voice dictation.";
                                    extra: root.mic-health;
                                    done: root.mic-ok;
                                    action-label: root.mic-ok ? "Test Mic" : "Allow";
                                    action-primary: !root.mic-ok;
                                    action => {
                                        if root.mic-ok { root.test-mic(); } else { root.grant-mic(); }
                                    }
                                }

                                SetupStep {
                                    number: "2";
                                    title: "Inbuilt Needle Speech Model";
                                    detail: root.model-installed
                                        ? (root.models.length > 0 ? root.models[root.selected-model].name + " installed & ready." : "Cactus Whistle 16M installed.")
                                        : (root.model-downloading ? root.model-download-info : "Tap to install or download model.");
                                    done: root.model-installed;
                                    busy: root.model-downloading;
                                    progress: root.model-progress;
                                    action-label: root.model-installed ? (root.model-loaded ? "Onloaded" : "Onload") : "Download";
                                    action-primary: !root.model-installed;
                                    action => {
                                        if root.model-installed {
                                            root.onload-model(root.selected-model);
                                        } else {
                                            root.download-model();
                                        }
                                    }
                                }

                                SetupStep {
                                    number: "3";
                                    title: "Expandable Floating Bubble";
                                    detail: root.overlay-ok
                                        ? (root.overlay-enabled ? "Active — rounded icon expands to circular waveform pill." : "Permission granted — tap Enable to float above apps.")
                                        : "Allow “Display over other apps” for the live bubble.";
                                    done: root.overlay-enabled;
                                    action-label: root.overlay-enabled ? "Disable" : (root.overlay-ok ? "Enable" : "Allow");
                                    action-primary: !root.overlay-enabled;
                                    action => { root.toggle-overlay(); }
                                }
                            }
                        }

                        if root.turns.length > 0 : SectionLabel { text: "RECENT TRANSCRIPTS"; }

                        if root.turns.length > 0 : Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 6px;
                                spacing: 4px;

                                for t[i] in root.turns : TurnRow {
                                    visible: i < 3;
                                    text: t.text;
                                    when: t.when;
                                    seconds: t.seconds;
                                    copy-clicked => { root.copy-turn(t.text); }
                                }
                            }
                        }
                    }
                }

                // ══ TAB 1: HISTORY ═══════════════════════════════════════
                if root.tab == 1 : Flickable {
                    width: parent.width;
                    height: parent.height;

                    history-layout := VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 6px;
                        padding-bottom: 28px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: "Dictation History";
                                font-size: 21px;
                                font-weight: 700;
                                color: #FFFFFF;
                                horizontal-alignment: left;
                                horizontal-stretch: 1;
                            }

                            if root.turns.length > 0 : ActionButton {
                                width: 84px;
                                height: 32px;
                                label: "Clear All";
                                primary: false;
                                destructive: true;
                                clicked => { root.clear-history(); }
                            }
                        }

                        Body {
                            text: "Every turn transcribed on-device. Tap Copy on any row to place it on your clipboard.";
                            font-size: 12px;
                            color: #8E88A8;
                        }

                        if root.turns.length == 0 : Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 20px;
                                spacing: 6px;

                                Body {
                                    text: "No transcripts recorded yet";
                                    font-size: 14px;
                                    font-weight: 600;
                                }

                                Body {
                                    text: "Press the waveform pill on the Listen tab or the floating bubble to dictate.";
                                    font-size: 12px;
                                    color: #8E88A8;
                                }
                            }
                        }

                        if root.turns.length > 0 : Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 6px;
                                spacing: 4px;

                                for t[i] in root.turns : TurnRow {
                                    text: t.text;
                                    when: t.when;
                                    seconds: t.seconds;
                                    copy-clicked => { root.copy-turn(t.text); }
                                }
                            }
                        }
                    }
                }

                // ══ TAB 2: MODELS ════════════════════════════════════════
                if root.tab == 2 : Flickable {
                    width: parent.width;
                    height: parent.height;

                    models-layout := VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 6px;
                        padding-bottom: 28px;
                        spacing: 12px;

                        Text {
                            text: "Models & RAM Runtime";
                            font-size: 21px;
                            font-weight: 700;
                            color: #FFFFFF;
                            horizontal-alignment: left;
                        }

                        Body {
                            text: "Cactus Whistle 16M (Needle) is inbuilt and installed out of the box. Onload models into RAM for zero-latency dictation or offload to free memory.";
                            font-size: 12px;
                            color: #8E88A8;
                        }

                        // Model Onloading / Offloading Runtime Status Card
                        Card {
                            highlighted: root.model-loaded;

                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 8px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    SectionLabel {
                                        text: "RAM ONLOAD / OFFLOAD ENGINE";
                                        horizontal-stretch: 1;
                                    }
                                    Badge {
                                        text: root.model-loaded ? "RESIDENT IN RAM" : "RAM FREE";
                                        active: root.model-loaded;
                                    }
                                }

                                Body {
                                    text: root.model-ram-status;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: #FFFFFF;
                                }

                                Body {
                                    text: root.status-text;
                                    font-size: 11px;
                                    color: #B497E7;
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        height: 34px;
                                        label: "Onload Active Model";
                                        primary: true;
                                        purple: true;
                                        enabled: root.model-installed && !root.busy;
                                        clicked => { root.onload-model(root.selected-model); }
                                    }

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        height: 34px;
                                        label: "Offload from RAM";
                                        primary: false;
                                        enabled: root.model-loaded && !root.busy;
                                        clicked => { root.offload-model(); }
                                    }
                                }
                            }
                        }

                        // Benchmark & Live Model Test Card
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 6px;

                                SectionLabel {
                                    text: "LIVE 4-SECOND MODEL BENCHMARK";
                                }

                                Body {
                                    text: root.test-result != ""
                                        ? root.test-result
                                        : "Tap “Test” on any installed model below to record 4 seconds of speech and benchmark its speed.";
                                    font-size: 12px;
                                    color: #D8D4E8;
                                }
                            }
                        }

                        // Model Catalog Cards
                        for m[i] in root.models : Card {
                            highlighted: root.selected-model == i;

                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 9px;

                                HorizontalLayout {
                                    spacing: 8px;

                                    Text {
                                        text: m.name;
                                        font-size: 15px;
                                        font-weight: 700;
                                        color: #FFFFFF;
                                        horizontal-alignment: left;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    if m.bundled : Badge {
                                        text: "INBUILT";
                                        highlight: true;
                                    }

                                    Badge {
                                        text: m.loaded ? "ONLOADED" : (m.installed ? "INSTALLED" : m.size);
                                        active: m.loaded;
                                        highlight: m.installed;
                                    }
                                }

                                Body {
                                    text: m.detail;
                                    font-size: 12px;
                                    color: #9A96B0;
                                }

                                Text {
                                    text: m.ram-status;
                                    font-size: 11px;
                                    color: m.loaded ? #C084FC : #6E6A86;
                                    horizontal-alignment: left;
                                }

                                // Download progress bar with exact MB and rounded %
                                if m.downloading : VerticalLayout {
                                    spacing: 5px;

                                    ProgressBar {
                                        progress: m.progress;
                                    }

                                    HorizontalLayout {
                                        Text {
                                            text: m.download-info != "" ? m.download-info : "Downloading from HuggingFace…";
                                            font-size: 11px;
                                            color: #C4B5FD;
                                            horizontal-alignment: left;
                                            horizontal-stretch: 1;
                                        }

                                        Text {
                                            text: Math.round(m.progress * 100.0) + "%";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: #FFFFFF;
                                            horizontal-alignment: right;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;

                                    if !m.installed && !m.downloading : ActionButton {
                                        horizontal-stretch: 1;
                                        height: 34px;
                                        label: m.bundled ? "Restore Inbuilt" : ("Download · " + m.size);
                                        primary: true;
                                        purple: true;
                                        enabled: !root.model-downloading;
                                        clicked => { root.pick-model(i); root.download-model(); }
                                    }

                                    if m.downloading : ActionButton {
                                        horizontal-stretch: 1;
                                        height: 34px;
                                        label: "Downloading " + Math.round(m.progress * 100.0) + "%…";
                                        primary: false;
                                        enabled: false;
                                    }

                                    if m.installed : ActionButton {
                                        horizontal-stretch: 1;
                                        height: 34px;
                                        label: root.selected-model == i ? "Selected" : "Select";
                                        primary: root.selected-model != i;
                                        purple: root.selected-model != i;
                                        enabled: root.selected-model != i;
                                        clicked => { root.pick-model(i); }
                                    }

                                    if m.installed : ActionButton {
                                        horizontal-stretch: 1;
                                        height: 34px;
                                        label: m.loaded ? "Offload" : "Onload";
                                        primary: false;
                                        enabled: !root.busy;
                                        clicked => {
                                            if m.loaded {
                                                root.offload-model();
                                            } else {
                                                // pick-model already onloads the installed model.
                                                root.pick-model(i);
                                            }
                                        }
                                    }

                                    if m.installed : ActionButton {
                                        width: 64px;
                                        height: 34px;
                                        label: "Test";
                                        primary: false;
                                        enabled: !root.test-running;
                                        clicked => { root.test-model(i); }
                                    }

                                    if m.installed && !m.bundled : ActionButton {
                                        width: 74px;
                                        height: 34px;
                                        label: "Delete";
                                        primary: false;
                                        destructive: true;
                                        clicked => { root.uninstall-model(i); }
                                    }
                                }
                            }
                        }
                    }
                }

                // ══ TAB 3: SETTINGS ══════════════════════════════════════
                if root.tab == 3 : Flickable {
                    width: parent.width;
                    height: parent.height;

                    settings-layout := VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 6px;
                        padding-bottom: 28px;
                        spacing: 12px;

                        Text {
                            text: "Settings & Diagnostics";
                            font-size: 21px;
                            font-weight: 700;
                            color: #FFFFFF;
                            horizontal-alignment: left;
                        }

                        // 1. Expandable Floating Bubble Settings
                        Card {
                            highlighted: root.overlay-enabled;

                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 10px;

                                SectionLabel { text: "EXPANDABLE FLOATING BUBBLE"; }

                                Body {
                                    text: "Always-on rounded-corner icon that expands on press into a circular pill with black background, slight purple highlights, and super-smooth white waveforms (no mic icons).";
                                    font-size: 12px;
                                    color: #9A96B0;
                                }

                                HorizontalLayout {
                                    spacing: 12px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;

                                        Body {
                                            text: "Always-on floating overlay";
                                            font-size: 14px;
                                            font-weight: 600;
                                        }

                                        Body {
                                            text: root.overlay-ok
                                                ? (root.overlay-enabled ? "Showing above all apps" : "Permission granted — toggle on")
                                                : "Requires Display over other apps permission";
                                            font-size: 11px;
                                            color: #8E88A8;
                                        }
                                    }

                                    Toggle {
                                        on: root.overlay-enabled;
                                        toggled => { root.toggle-overlay(); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    if !root.overlay-ok : ActionButton {
                                        horizontal-stretch: 1;
                                        label: "Grant Overlay Permission";
                                        primary: true;
                                        purple: true;
                                        clicked => { root.open-overlay-settings(); }
                                    }

                                    if root.overlay-ok : ActionButton {
                                        horizontal-stretch: 1;
                                        label: root.overlay-enabled ? "Hide Bubble" : "Show Bubble Now";
                                        primary: !root.overlay-enabled;
                                        purple: !root.overlay-enabled;
                                        clicked => { root.toggle-overlay(); }
                                    }

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        label: root.bubble-expanded ? "Collapse Bubble Icon" : "Test Expand to Pill";
                                        primary: false;
                                        clicked => { root.toggle-bubble-expand(); }
                                    }
                                }
                            }
                        }

                        // 2. Model Onloading / Offloading Policy
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 10px;

                                SectionLabel { text: "MODEL MEMORY MANAGEMENT"; }

                                HorizontalLayout {
                                    spacing: 12px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;

                                        Body {
                                            text: "Auto-offload idle model from RAM";
                                            font-size: 14px;
                                            font-weight: 600;
                                        }

                                        Body {
                                            text: "Automatically releases model RAM after 2 minutes of inactivity and re-onloads on record.";
                                            font-size: 11px;
                                            color: #8E88A8;
                                        }
                                    }

                                    Toggle {
                                        on: root.auto-offload;
                                        toggled => { root.toggle-auto-offload(); }
                                    }
                                }

                                Body {
                                    text: root.model-ram-status;
                                    font-size: 12px;
                                    color: #C084FC;
                                }
                            }
                        }

                        // 3. Background Service & Battery Optimization
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 8px;

                                SectionLabel { text: "FOREGROUND KEEP-ALIVE SERVICE"; }

                                Body {
                                    text: root.battery-ok
                                        ? "Unrestricted background execution is active. The floating waveform bubble stays alive across all apps."
                                        : "Allow unrestricted battery usage so Android does not suspend the floating bubble while you dictate in other apps.";
                                    font-size: 12px;
                                    color: #9A96B0;
                                }

                                if !root.battery-ok : ActionButton {
                                    label: "Allow Unrestricted Background Run";
                                    primary: false;
                                    clicked => { root.request-battery-exemption(); }
                                }
                            }
                        }

                        // 4. Activity Log
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 6px;

                                SectionLabel { text: "ACTIVITY LOG"; }

                                Body {
                                    text: root.log-text != "" ? root.log-text : "No events logged yet.";
                                    font-size: 11px;
                                    color: #8E88A8;
                                }
                            }
                        }

                        // 5. System Diagnostics
                        Card {
                            VerticalLayout {
                                width: parent.width;
                                padding: 14px;
                                spacing: 8px;

                                SectionLabel { text: "DIAGNOSTICS & ENGINE VERIFICATION"; }

                                Body {
                                    text: root.diagnostics != ""
                                        ? root.diagnostics
                                        : "Inspects permissions, ARM64 NEON engine binaries, inbuilt Needle model, and RAM onload state.";
                                    font-size: 11px;
                                    color: #9A96B0;
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        label: "Run Self-Test";
                                        primary: false;
                                        clicked => { root.run-diagnostics(); }
                                    }

                                    ActionButton {
                                        horizontal-stretch: 1;
                                        label: "Copy Report";
                                        primary: false;
                                        enabled: root.diagnostics != "";
                                        clicked => { root.copy-diagnostics(); }
                                    }
                                }
                            }
                        }

                        Text {
                            text: "QuickSTT · ARM64 NEON On-Device Speech-to-Text";
                            font-size: 11px;
                            color: #4A4462;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // ── Bottom Navigation Bar ──────────────────────────────────────
            Rectangle {
                height: 1px;
                background: #1E192D;
            }

            Rectangle {
                height: 64px;
                background: #050508;

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;

                    NavItem {
                        width: 25%;
                        icon: 0;
                        label: "Listen";
                        active: root.tab == 0;
                        picked => { root.nav(0); }
                    }

                    NavItem {
                        width: 25%;
                        icon: 1;
                        label: "History";
                        active: root.tab == 1;
                        picked => { root.nav(1); }
                    }

                    NavItem {
                        width: 25%;
                        icon: 2;
                        label: "Models";
                        active: root.tab == 2;
                        picked => { root.nav(2); }
                    }

                    NavItem {
                        width: 25%;
                        icon: 3;
                        label: "Settings";
                        active: root.tab == 3;
                        picked => { root.nav(3); }
                    }
                }
            }

            // Gesture navigation bar safe area
            Rectangle {
                height: 14px;
                background: #050508;
            }
        }
    }
}
