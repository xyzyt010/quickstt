import { Button, CheckBox, ComboBox, LineEdit, Slider, ScrollView } from "std-widgets.slint";
import { IconSym, ToggleRow } from "common.slint";

// Model card for the hardware-aware catalog (image-inspired): name, blurb,
// badge (Active/Recommended/Legacy/"", pink pills), accuracy/speed 0-100,
// languages label, size label, installed flag, entry index for callbacks.
export struct ModelCard {
    name: string,
    blurb: string,
    badge: string,
    accuracy: int,
    speed: int,
    langs: string,
    size: string,
    installed: bool,
    is_active: bool,
    visible: bool,
    index: int,
    downloading: bool,
    // Provider group for this card ("Local" / "Groq" / "OpenAI" / "DeepGram").
    provider: string,
    // True when this is a hosted-API card and the user has a key set.
    has-key: bool,
    // Stable model_dir — the scoped key for its api_key param.
    model-dir: string,
    // Current API key text (mirrored back from settings for Connect boxes).
    connect-text: string,
}

// Per-model user parameter row on the Models tab. `kind`:
// 0 = IntRange (Slider), 1 = Toggle (CheckBox), 2 = Choice (ComboBox).
// `value` is always a float (0/1 toggles; index for choices; integer for int).
export struct ModelParamUi {
    key: string,
    label: string,
    kind: int,
    lo: float,
    hi: float,
    choices: [string],
    value: float,
    /// Free-text value for kind == 3 (API keys). Float `value` carries the
    /// numeric/toggle/choice kinds.
    text-value: string,
    hint: string,
}

// One recorded turn for the dashboard History section. Times and labels are
// pre-formatted in Rust so the rows stay cheap (the whole model is rebuilt at
// most 10x/second, and only while something is actually playing).
export struct HistRow {
    index: int,
    when: string,
    dur: string,
    pos: string,
    text: string,
    has_audio: bool,
    menu_open: bool,
    playing: bool,
    progress: float,
    copied: bool,
    /// Selection checkbox state (bulk delete / download mode).
    selected: bool,
}

// Row action button: 40x40 hit target (touch-friendly — a 28px plate alone is
// below the 44px fingertip rule once the row is scaled), plate + drawn glyph,
// hover / press / active states with quick consistent animations.
// kind: 0 = copy (flips to a green tick while "copied"), 1 = delete, 2 = ⋮.
component HistButton inherits Rectangle {
    in property <int> kind: 0;
    in property <bool> copied: false;
    in property <bool> active: false;
    in property <color> rest-plate: #131313;
    in property <color> hover-plate: #232323;
    in property <color> rest-tint: #9A9A9A;
    in property <color> hover-tint: #FFFFFF;
    callback clicked();

    width: 40px;
    height: 40px;

    // The plate shrinks slightly while pressed — instant tactile feedback.
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: bt.pressed ? 30px : 34px;
        height: bt.pressed ? 30px : 34px;
        border-radius: 10px;
        background: root.copied ? #14301F : ((bt.has-hover || root.active) ? root.hover-plate : root.rest-plate);
        animate background { duration: 130ms; easing: ease-out; }
        animate width { duration: 90ms; easing: ease-out; }
        animate height { duration: 90ms; easing: ease-out; }
    }

    IconSym {
        glyph: "\u{E14D}";
        x: 6px;
        y: 6px;
        visible: root.kind == 0 && !root.copied;
        tint: (bt.has-hover || root.active) ? root.hover-tint : root.rest-tint;
        size: 18px;
    }
    IconSym {
        glyph: "\u{E5CA}";
        x: 6px;
        y: 6px;
        visible: root.kind == 0 && root.copied;
        tint: #4ADE80;
        size: 18px;
    }
    IconSym {
        glyph: "\u{E872}";
        x: 6px;
        y: 6px;
        visible: root.kind == 1;
        tint: (bt.has-hover || root.active) ? root.hover-tint : root.rest-tint;
        size: 18px;
    }
    IconSym {
        glyph: "\u{E5D4}";
        x: 6px;
        y: 6px;
        visible: root.kind == 2;
        tint: (bt.has-hover || root.active) ? root.hover-tint : root.rest-tint;
        size: 18px;
    }

    bt := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// Menu entry (34px): same drawn glyphs + label. kind: 0 = copy/✓,
// 1 = download, 2 = delete (danger red).
component HistMenuItem inherits Rectangle {
    in property <int> kind: 0;
    in property <bool> copied: false;
    in property <bool> danger: false;
    in property <string> label: "";
    callback clicked();

    height: 44px;
    border-radius: 8px;
    background: hit.has-hover ? (root.danger ? #2A1414 : #242424) : transparent;
    animate background { duration: 110ms; easing: ease-out; }

    IconSym { glyph: "\u{E14D}"; x: 8px; y: 8px; visible: root.kind == 0 && !root.copied; tint: root.danger ? #FF8A8A : #B9B9B9; size: 17px; }
    IconSym { glyph: "\u{E5CA}"; x: 8px; y: 8px; visible: root.kind == 0 && root.copied; tint: #4ADE80; size: 17px; }
    IconSym { glyph: "\u{E171}"; x: 8px; y: 8px; visible: root.kind == 1; size: 17px; }
    IconSym { glyph: "\u{E872}"; x: 8px; y: 8px; visible: root.kind == 2; tint: #FF8A8A; size: 17px; }

    Text {
        x: 46px;
        y: 0px;
        width: parent.width - 56px;
        height: parent.height;
        text: root.label;
        font-size: 13.5px;
        color: root.danger ? #FF9A9A : #E8E8E8;
        vertical-alignment: center;
        overflow: elide;
    }

    hit := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// Modern Dark Theme QuickSTT Control Center Dashboard
// Rendered via DirectWrite / Direct2D / D3D11 on Windows, fully native Slint.

export component DashboardWidget inherits Window {
    title: "QuickSTT Control Center";
    // Blue mic app icon: the title bar, the taskbar button and Alt+Tab all show
    // the QuickSTT icon instead of the generic Slint/Rust one. (The exe itself
    // carries the same icon via build.rs.)
    icon: @image-url("../../assets/app_icon.svg");
    preferred-width: 940px;
    preferred-height: 700px;
    // Small windows must stay usable: the layout reflows (sidebar → icon rail)
    // instead of being laid out wider than the window and clipped.
    min-width: 520px;
    min-height: 400px;
    background: #000000;

    in-out property <int> active-tab: 0;

    // Adaptive rail: below ~820 logical px the sidebar collapses to its icon
    // rail so the content column keeps a usable width. Set from Rust on a
    // timer — a root.width binding here would feed back into the window's
    // preferred size (Slint reports that as a binding loop).
    in-out property <bool> rail-mode: false;
    // What the sidebar actually shows: the icon rail when the user collapsed
    // it OR when the window is too narrow for the full panel.
    out property <bool> rail-active: root.sidebar-collapsed || root.rail-mode;
    // Minimum fingertip target. Touchscreen-first on Android, and touch-capable
    // Windows/Linux convertibles get the same hit areas.
    out property <length> tap-size: 44px;

    // Model & Language State
    in property <[string]> models: [""];
    in property <int> selected-model: 0;
    in property <[string]> languages: ["English"];
    in property <int> selected-language: 0;
    /// Recommendation priority (0 = Balanced, 1 = Fastest, 2 = Most accurate).
    in property <int> model-priority: 0;

    // Download & Progress Bar
    in property <bool> is-downloading: false;
    in property <int> download-progress: 0;
    in property <string> download-status: "";
    in property <string> download-speed: "";
    in property <string> download-bytes: "";
    in property <string> download-file: "";
    /// The single recommended model, pre-resolved in Rust. One banner, one
    /// action (Download → Use it) — the visible badge/button for it.
    in property <string> recommend-model: "";
    /// True when the recommended model is installed locally.
    in property <bool> recommend-installed: false;
    /// Human size of the recommended model ("800 MB").
    in property <string> recommend-size: "";

    // Style Properties
    in property <int> ui-opacity: 100;
    in property <int> ui-pill-radius: 25;
    in property <bool> show-waveform: true;
    in property <int> waveform-sensitivity: 5;
    in property <int> tray-icon-size: 32;

    // Wakeword & VAD Properties
    in property <bool> wakeword-enabled: false;
    in property <int> wakeword-sensitivity: 50;
    // Exact enforced trigger rule, pushed from Rust (threshold × 3 hits).
    in property <string> wakeword-threshold-text: "";
    in property <int> vad-sensitivity: 50;
    in property <int> live-audio-level: 0;
    in property <bool> ww-hey-jarvis: true;
    in property <bool> ww-jarvis: true;
    in property <bool> ww-alexa: true;
    in property <bool> ww-agent: true;
    in property <bool> ww-hem: true;
    // Clap action (0 = Start Dictation, 1 = Stop Dictation, 2 = Disabled).
    // Active (Start) out of the box.
    in property <int> transient-action: 0;

    // General & System Settings
    in property <bool> start-with-windows: false;
    in property <bool> start-minimized: true;
    in property <bool> lrc-enabled: true;
    in property <bool> auto-stop-silence: false;
    in property <int> silence-duration: 8;
    in property <bool> auto-offload: true;
    in property <int> offload-seconds: 15;
    in property <bool> ctrl-space-enabled: true;
    in property <int> ctrl-space-mode: 0;
    in property <int> ctrl-space-output: 0;
    // Disfluency cleanup toggle (non-streaming utterance text only).
    in property <bool> clean-disfluencies: true;
    // Cleanup engine: 0 = FDT 66M tagger, 1 = S1-mini INT4 0.6B normalizer,
    // 2 = SmolLM2 360M Q4 (llama.cpp), 3 = Gemma 3 270M Q4 (llama.cpp).
    in property <int> disfluency-engine: 0;

    // Sidebar: collapsible to icons via the chevron, drag-resizable 150-280px.
    in-out property <bool> sidebar-collapsed: false;
    in-out property <int> sidebar-width: 200;
    // Width at the moment a sidebar drag started (absolute math: a moving
    // pointer must never accumulate deltas onto an already-updated width).
    in-out property <int> sidebar-drag-start: 200;
    // "Copied to clipboard" toast: Rust flips this; the root-level overlay
    // animates its opacity + rise, then Rust flips it back after ~2.5s.
    in-out property <bool> history-toast-show: false;
    // History backup: ON stores every finished turn (text + audio) in the
    // dashboard history; OFF stops new recordings (existing rows stay).
    in-out property <bool> history-enabled: true;
    // True while the user drags the sidebar edge (cursor + no re-layout jitter).
    in-out property <bool> sidebar-dragging: false;

    // Dashboard history (newest first). Rows carry pre-formatted labels.
    in property <[HistRow]> history-items: [];
    // Row whose ⋮ menu is open (-1 = none). Set by Rust (single source of
    // truth) and mirrored by the UI for instant open/close feedback.
    in-out property <int> history-menu-idx: -1;
    // Row currently playing (-1 = none), for the play/pause icon.
    in-out property <int> history-play-idx: -1;
    // Floating row menu: anchor in window coordinates (bottom-right corner of
    // the ⋮ button, set by the row) + one-shot rise/fade flag flipped by a 1ms
    // timer the moment the menu opens.
    property <length> hist-menu-x: 0px;
    property <length> hist-menu-y: 0px;
    property <bool> hist-menu-grown: false;
    in property <string> recording-dir: "C:\\Users\\hemsh_sfya5gq\\Recordings";
    in property <string> app-version: "2.0.0-alpha.18 (Rust & Slint Edition)";

    // ── Bulk history controls (History section) ──
    /// Selection mode: rows swap their play circle for a checkbox so nothing
    /// in the layout shifts. Rust owns the actual selected-id set.
    in property <bool> history-selecting: false;
    /// How many turns are currently selected (Rust counts the set).
    in property <int> history-selected-count: 0;
    /// Total stored turns (history may hold more than the rendered window,
    /// so the header counts from Rust rather than the row model).
    in property <int> history-total: 0;
    /// True when every stored turn is selected (drives the "Select all" box).
    in property <bool> history-all-selected: false;
    /// Two-step guard for "Delete all": the first click arms the button
    /// ("Tap again to confirm"), the second performs the wipe. A timer
    /// disarms it after a few seconds so a stray click cannot nuke history
    /// later on.
    in-out property <bool> delete-all-armed: false;

    // Callbacks
    callback select-model(string);
    callback select-language(string);
    /// Recommendation priority pick (0/1/2) — re-scores the Recommended badge.
    callback set-model-priority(string);
    callback set-wakeword-enabled(bool);
    callback set-wakeword-sensitivity(int);
    callback set-vad-sensitivity(int);
    callback set-ui-opacity(int);
    callback set-ui-pill-radius(int);
    callback set-start-with-windows(bool);
    callback set-start-minimized(bool);
    callback set-lrc-enabled(bool);
    callback set-auto-stop-silence(bool);
    callback set-silence-duration(int);
    callback set-auto-offload(bool);
    callback set-offload-seconds(int);
    callback set-ctrl-space-enabled(bool);
    callback set-ctrl-space-mode(int);
    callback set-ctrl-space-output(int);
    callback set-clean-disfluencies(bool);
    callback set-disfluency-engine(int);
    callback set-sidebar-width(length);
    callback set-sidebar-collapsed(bool);
    // History backup toggle (top of the General tab's history card).
    callback set-history-enabled(bool);
    // History row actions (index into history-items).
    callback history-play(int);
    callback history-seek(int, float);
    callback history-copy(int);
    callback history-delete(int);
    callback history-download(int);
    // Audio-only export (wav, no .txt) — the ⋮ menu's second download entry.
    callback history-download-audio(int);
    // Bulk selection: set/clear one row, select/deselect every row, then act
    // on the selection (delete or export). Rust keeps the selected id set, so
    // it survives row rebuilds and stays correct when history shifts.
    callback history-set-selected(int, bool);
    callback history-set-selecting(bool);
    callback history-select-all(bool);
    callback history-delete-selected();
    callback history-download-selected();
    // Nuclear option: delete EVERY stored turn (audio included).
    callback history-delete-all();
    callback history-menu(int, bool);
    callback set-show-waveform(bool);
    callback set-waveform-sensitivity(int);
    callback set-tray-icon-size(int);
    callback toggle-wakeword-phrase(string, bool);
    callback set-transient-action(int);
    callback download-catalog-model(int);
    callback select-catalog-model(int);
    callback use-recommended-model();
    /// Download the recommended model (or activate it when it is local).
    callback download-recommended-model();
    callback set-catalog-search(string);
    /// Per-model parameter writeback: (param key, value). Value semantics by
    /// kind: IntRange = the integer, Toggle = 0/1. Choice params use
    /// `set-model-param-choice` instead (ComboBox reports text, not an index).
    callback set-model-param(string, float);
    callback set-model-param-choice(string, string);
    /// Free-text parameter writeback (e.g. the Groq API key).
    callback set-model-param-text(string, string);
    /// Provider group picker (above the Model dropdown). Filtering is a
    /// view over the catalog; the active model is preserved when possible.
    callback set-provider(string);
    /// Toggle the catalog collapsed/expanded state.
    callback toggle-catalog();
    /// Open the inline API-key Connect box for a model_dir ("" = close all).
    callback open-connect(string);
    /// Save an API key for a specific model_dir (catalog Connect boxes).
    callback set-api-key-for(string, string);
    callback browse-recording-dir();
    callback check-updates();
    /// Re-run the first-run onboarding tour from the top.
    callback show-onboarding();
    callback close-dashboard();

    // Hardware-aware catalog (dynamic cards, image-inspired)
    in property <[ModelCard]> catalog: [];
    in property <string> catalog-search: "";
    /// Hardware-aware recommended model name (legacy, use `recommend-model`).
    in property <string> recommend-name: "";
    in property <string> recommend-reason: "";
    /// Per-model parameter rows for the active model — every family has its
    /// own list (empty when the selected model can't be customised).
    in property <[ModelParamUi]> model-params: [];
    // ── Provider filter (Local / Groq / OpenAI / DeepGram) ──
    in property <string> active-provider: "Local";
    in property <[string]> provider-options: ["Local", "Groq", "OpenAI", "DeepGram"];
    // Index of the active provider in provider-options (keeps the ComboBox
    // in sync with the provider of the active model).
    in property <int> active-provider-index: 0;
    // ── Catalog collapse state + inline Connect box ──
    in-out property <bool> catalog-open: true;
    // model_dir whose Connect box is currently open ("" = none).
    in property <string> connect-for: "";
    // ── Hardware-fit recommendation for the cleanup engine ──
    in property <int> recommend-cleanup-engine: -1;
    in property <string> recommend-cleanup-note: "";

    // Monitor scale factor (1.0 = 96 dpi, 1.25 = 125%, …), set from Rust via
    // GetDpiForWindow. Slint's winit-software backend renders at this scale but
    // hands the layout the *physical* window size, so a plain layout overflows
    // the surface by the scale factor. Laying the whole UI out in DIP units
    // (physical / scale) makes the scaled render land exactly on the window.
    in-out property <float> ui-scale: 1.0;
    // Layout probes (read over IPC by DASHGEOM).
    out property <length> probe-root-w: root.width;
    out property <length> probe-box-w: layout-box.width;
    out property <length> probe-side-w: side-panel.width;

    // Borderless Window Dragging
    callback drag_start();
    callback drag_moved();
    callback drag_end();

    // Layout box: fills the window (Window.root width already arrives in DIP
    // units on this backend; the renderer scales it to the physical surface).
    layout-box := Rectangle {
        background: #000000;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;


        // ══════════════════════════════════════════════════════════════════════════
        // Main Body: Left Sidebar Navigation + Right Content Canvas
        // ══════════════════════════════════════════════════════════════════════════
        HorizontalLayout {
            spacing: 0px;

            // ── Left Navigation Sidebar ──
            // Collapsible (chevron → 56px icons-only) and drag-resizable
            // between 150px and 280px. Dragging is disabled while collapsed —
            // the collapsed rail is a fixed icon strip, so there is nothing to
            // drag and re-expanding should not jump the layout.
            side-panel := Rectangle {
                width: root.rail-active ? 56px : root.sidebar-width * 1px;
                background: #050505;
                border-width: 1px;
                border-color: #1A1A1A;

                VerticalLayout {
                    padding: root.rail-active ? 6px : 12px;
                    spacing: 8px;

                    // Sidebar collapse/expand toggle. The glyph morphs between
                    // hamburger (collapse) and close/X (expand) based on the
                    // live collapsed state, the way every Material sidebar
                    // does it. Left-aligned in expanded mode (matches the nav
                    // items), centered in the collapsed rail.
                    Rectangle {
                        height: root.rail-active ? 44px : 40px;
                        border-radius: 8px;
                        background: chev_touch.has-hover ? #161616 : transparent;
                        border-width: chev_touch.has-hover ? 1px : 0px;
                        border-color: #262626;
                        IconSym {
                            // E5D2 = menu (hamburger, 3 lines), E5CD = close X.
                            // Expanded sidebar shows X (click to collapse);
                            // collapsed rail shows hamburger (click to expand).
                            glyph: root.sidebar-collapsed ? "\u{E5D2}" : "\u{E5CD}";
                            tint: chev_touch.has-hover ? #FFFFFF : #9A9A9A;
                            size: 22px;
                            x: root.rail-active ? (parent.width - self.width) / 2 : 12px;
                            y: (parent.height - self.height) / 2;
                        }
                        chev_touch := TouchArea {
                            clicked => {
                                root.sidebar-collapsed = !root.sidebar-collapsed;
                                root.set-sidebar-collapsed(root.sidebar-collapsed);
                            }
                            mouse-cursor: pointer;
                        }
                    }

                    // Navigation Item 0: General
                    Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: root.active-tab == 0 ? #1A1A1A : (tab0_touch.has-hover ? #0E0E0E : transparent);
                        border-width: root.active-tab == 0 ? 1px : 0px;
                        border-color: #FFFFFF;

                        if root.rail-active : IconSym {
                            glyph: "\u{E8B8}";
                            tint: root.active-tab == 0 ? #FFFFFF : #9A9A9A;
                            size: 22px;
                            x: (parent.width - 22px) / 2;
                            y: (parent.height - 22px) / 2;
                        }
                        if !root.rail-active : HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            alignment: start;
                            IconSym {
                                glyph: "\u{E8B8}";
                                tint: root.active-tab == 0 ? #FFFFFF : #9A9A9A;
                                size: 22px;
                                y: (parent.height - 22px) / 2;
                            }
                            Text {
                                text: "General";

                                font-size: 13px;
                                font-weight: root.active-tab == 0 ? 700 : 500;
                                color: root.active-tab == 0 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                        }
                        tab0_touch := TouchArea {
                            clicked => { root.active-tab = 0; }
                            mouse-cursor: pointer;
                        }
                    }

                    // Navigation Item 1: Models
                    Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: root.active-tab == 1 ? #1A1A1A : (tab1_touch.has-hover ? #0E0E0E : transparent);
                        border-width: root.active-tab == 1 ? 1px : 0px;
                        border-color: #FFFFFF;

                        if root.rail-active : IconSym {
                            glyph: "\u{E1B8}";
                            tint: root.active-tab == 1 ? #FFFFFF : #9A9A9A;
                            size: 22px;
                            x: (parent.width - 22px) / 2;
                            y: (parent.height - 22px) / 2;
                        }
                        if !root.rail-active : HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            alignment: start;
                            IconSym {
                                glyph: "\u{E1B8}";
                                tint: root.active-tab == 1 ? #FFFFFF : #9A9A9A;
                                size: 22px;
                                y: (parent.height - 22px) / 2;
                            }
                            Text {
                                text: "Speech Models";

                                font-size: 13px;
                                font-weight: root.active-tab == 1 ? 700 : 500;
                                color: root.active-tab == 1 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                        }
                        tab1_touch := TouchArea {
                            clicked => { root.active-tab = 1; }
                            mouse-cursor: pointer;
                        }
                    }

                    // Navigation Item 2: Style
                    Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: root.active-tab == 2 ? #1A1A1A : (tab2_touch.has-hover ? #0E0E0E : transparent);
                        border-width: root.active-tab == 2 ? 1px : 0px;
                        border-color: #FFFFFF;

                        if root.rail-active : IconSym {
                            glyph: "\u{E3B7}";
                            tint: root.active-tab == 2 ? #FFFFFF : #9A9A9A;
                            size: 22px;
                            x: (parent.width - 22px) / 2;
                            y: (parent.height - 22px) / 2;
                        }
                        if !root.rail-active : HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            alignment: start;
                            IconSym {
                                glyph: "\u{E3B7}";
                                tint: root.active-tab == 2 ? #FFFFFF : #9A9A9A;
                                size: 22px;
                                y: (parent.height - 22px) / 2;
                            }
                            Text {
                                text: "Widget Style";

                                font-size: 13px;
                                font-weight: root.active-tab == 2 ? 700 : 500;
                                color: root.active-tab == 2 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                        }
                        tab2_touch := TouchArea {
                            clicked => { root.active-tab = 2; }
                            mouse-cursor: pointer;
                        }
                    }

                    // Navigation Item 3: Wakewords
                    Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: root.active-tab == 3 ? #1A1A1A : (tab3_touch.has-hover ? #0E0E0E : transparent);
                        border-width: root.active-tab == 3 ? 1px : 0px;
                        border-color: #FFFFFF;

                        if root.rail-active : IconSym {
                            glyph: "\u{E023}";
                            tint: root.active-tab == 3 ? #FFFFFF : #9A9A9A;
                            size: 22px;
                            x: (parent.width - 22px) / 2;
                            y: (parent.height - 22px) / 2;
                        }
                        if !root.rail-active : HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            alignment: start;
                            IconSym {
                                glyph: "\u{E023}";
                                tint: root.active-tab == 3 ? #FFFFFF : #9A9A9A;
                                size: 22px;
                                y: (parent.height - 22px) / 2;
                            }
                            Text {
                                text: "Wake Words & VAD";

                                font-size: 13px;
                                font-weight: root.active-tab == 3 ? 700 : 500;
                                color: root.active-tab == 3 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                        }
                        tab3_touch := TouchArea {
                            clicked => { root.active-tab = 3; }
                            mouse-cursor: pointer;
                        }
                    }

                    // Navigation Item 4: System & Updates
                    Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: root.active-tab == 4 ? #1A1A1A : (tab4_touch.has-hover ? #0E0E0E : transparent);
                        border-width: root.active-tab == 4 ? 1px : 0px;
                        border-color: #FFFFFF;

                        if root.rail-active : IconSym {
                            glyph: "\u{E30A}";
                            tint: root.active-tab == 4 ? #FFFFFF : #9A9A9A;
                            size: 22px;
                            x: (parent.width - 22px) / 2;
                            y: (parent.height - 22px) / 2;
                        }
                        if !root.rail-active : HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            alignment: start;
                            IconSym {
                                glyph: "\u{E30A}";
                                tint: root.active-tab == 4 ? #FFFFFF : #9A9A9A;
                                size: 22px;
                                y: (parent.height - 22px) / 2;
                            }
                            Text {
                                text: "System & Info";

                                font-size: 13px;
                                font-weight: root.active-tab == 4 ? 700 : 500;
                                color: root.active-tab == 4 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                        }
                        tab4_touch := TouchArea {
                            clicked => { root.active-tab = 4; }
                            mouse-cursor: pointer;
                        }
                    }

                    // Navigation Item 5: History (all transcriptions + audio)
                    Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: root.active-tab == 5 ? #1A1A1A : (tab5_touch.has-hover ? #0E0E0E : transparent);
                        border-width: root.active-tab == 5 ? 1px : 0px;
                        border-color: #FFFFFF;

                        if root.rail-active : IconSym {
                            glyph: "\u{E28E}";
                            tint: root.active-tab == 5 ? #FFFFFF : #9A9A9A;
                            size: 22px;
                            x: (parent.width - 22px) / 2;
                            y: (parent.height - 22px) / 2;
                        }
                        if !root.rail-active : HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            alignment: start;
                            IconSym {
                                glyph: "\u{E28E}";
                                tint: root.active-tab == 5 ? #FFFFFF : #9A9A9A;
                                size: 22px;
                                y: (parent.height - 22px) / 2;
                            }
                            Text {
                                text: "History";

                                font-size: 13px;
                                font-weight: root.active-tab == 5 ? 700 : 500;
                                color: root.active-tab == 5 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                        }
                        tab5_touch := TouchArea {
                            clicked => { root.active-tab = 5; }
                            mouse-cursor: pointer;
                        }
                    }

                    // Spacer
                    Rectangle { }
                }

                // Drag-to-resize handle on the right edge: 6px grab strip,
                // col-resize cursor, width clamped 150-280px and persisted.
                sidebar_drag := TouchArea {
                    x: parent.width - 6px;
                    width: 6px;
                    height: parent.height;
                    enabled: !root.rail-active;
                    mouse-cursor: col-resize;
                    // Anchor the width at press time, then follow the pointer
                    // ABSOLUTELY (start + total offset) — never accumulate.
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.sidebar-drag-start = root.sidebar-width;
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.sidebar-width = clamp(root.sidebar-drag-start + round((self.mouse-x - self.pressed-x) / 1px), 150, 280);
                            root.set-sidebar-width(root.sidebar-width * 1px);
                        }
                    }
                }
            }

            // ── Right Main Content Area ──
            Rectangle {
                // Fill the row next to the sidebar (otherwise the layout just
                // sizes to the ScrollView's longest child and clips at the
                // window edge — the "everything cut off on the right" report.
                horizontal-stretch: 1;
                background: #000000;

                ScrollView {
                    // Touch: drag anywhere on the page to pan (Windows/Linux
                    // touchscreens + precision touchpads), wheel still works.
                    mouse-drag-pan-enabled: true;
                    VerticalLayout {
                        alignment: start;
                        width: parent.width;

                        // ══════════════════════════════════════════════════════════════════
                        // TAB 0: GENERAL SETTINGS
                        // ══════════════════════════════════════════════════════════════════
                        if root.active-tab == 0 : VerticalLayout {
                        padding: 20px;
                        spacing: 16px;

                        Text {
                            text: "General Configuration";
                            font-size: 18px;
                            font-weight: 700;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Configure Windows integration, silence auto-commit, memory auto-offload, and recording output.";
                            font-size: 12px;
                            color: #9A9A9A;
                            wrap: word-wrap;
                        }

                        // ── History moved to its own section ──
                        // Everything that used to live at the top of General
                        // (turns, audio, exports, bulk delete) now lives in the
                        // dedicated History section, so this tab stays about
                        // behaviour and recording settings.
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text {
                                    text: "Transcription History";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: #FFFFFF;
                                }
                                Text {
                                    text: "Every finished turn — transcript and audio — is kept in the dedicated History section. There you can play it back, copy or export the audio and text, select turns in bulk, and delete everything.";
                                    font-size: 12px;
                                    color: #9A9A9A;
                                    wrap: word-wrap;
                                }
                                Rectangle {
                                    width: 176px;
                                    height: 36px;
                                    border-radius: 8px;
                                    background: go_hist.has-hover ? #2A2A2A : #FFFFFF;
                                    animate background { duration: 130ms; easing: ease-out; }
                                    Text {
                                        text: "Open History →";
                                        font-size: 12.5px;
                                        font-weight: 700;
                                        color: go_hist.has-hover ? #FFFFFF : #000000;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    go_hist := TouchArea {
                                        clicked => { root.active-tab = 5; }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }

                        // Group 1: Startup & Behavior Card
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "System Startup & Behavior"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                CheckBox {
                                    height: 40px;
                                    text: "Start with Windows on logon";
                                    checked: root.start-with-windows;
                                    toggled => { root.set-start-with-windows(self.checked); }
                                }
                                CheckBox {
                                    height: 40px;
                                    text: "Start minimized to system tray";
                                    checked: root.start-minimized;
                                    toggled => { root.set-start-minimized(self.checked); }
                                }
                                CheckBox {
                                    height: 40px;
                                    text: "Export synchronized .lrc (lyrics/timestamp) files with recordings";
                                    checked: root.lrc-enabled;
                                    toggled => { root.set-lrc-enabled(self.checked); }
                                }
                            }
                        }

                        // Group 2: Silence Detection Auto-Stop
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "Inactivity & Silence Auto-Stop"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                CheckBox {
                                    height: 40px;
                                    text: "Automatically stop and commit transcription when silence is detected";
                                    checked: root.auto-stop-silence;
                                    toggled => { root.set-auto-stop-silence(self.checked); }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "Silence threshold duration:";
                                        font-size: 13px;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                        min-width: 180px;
                                    }
                                    Slider {
                                        height: 34px;
                                        minimum: 1;
                                        maximum: 60;
                                        value: root.silence-duration;
                                        enabled: root.auto-stop-silence;
                                        changed(val) => { root.set-silence-duration(val); }
                                    }
                                    Text {
                                        text: root.silence-duration + " sec";
                                        font-size: 13px;
                                        color: #FFFFFF;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        min-width: 55px;
                                    }
                                }
                            }
                        }

                        // Group 3: Memory Auto-Offload
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "Memory Management & Model Offloading"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                CheckBox {
                                    height: 40px;
                                    text: "Auto-offload speech model when idle (saves RAM)";
                                    checked: root.auto-offload;
                                    toggled => { root.set-auto-offload(self.checked); }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "Offload model after inactivity:";
                                        font-size: 13px;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                        min-width: 180px;
                                    }
                                    Slider {
                                        height: 34px;
                                        minimum: 5;
                                        maximum: 180;
                                        value: root.offload-seconds;
                                        enabled: root.auto-offload;
                                        changed(val) => { root.set-offload-seconds(val); }
                                    }
                                    Text {
                                        text: root.offload-seconds + " sec";
                                        font-size: 13px;
                                        color: #FFFFFF;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        min-width: 55px;
                                    }
                                }
                            }
                        }

                        // Group 4: Quick Transcription (Ctrl+Space)
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "Quick Transcription Hotkey (Ctrl+Space)"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                CheckBox {
                                    height: 40px;
                                    text: "Enable global Ctrl+Space dictation overlay";
                                    checked: root.ctrl-space-enabled;
                                    toggled => { root.set-ctrl-space-enabled(self.checked); }
                                }

                                // Stacked (not side-by-side): at 860px the two
                                // combos + labels overflow the ~620px content
                                // and the right column clips. VerticalLayout
                                // scales cleanly down to the 720px min-width.
                                VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Trigger Mode:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 110px; }
                                        ComboBox {
                                            height: 40px;
                                            model: ["Push-to-Talk (Hold)", "Toggle (Press on/off)"];
                                            current-index: root.ctrl-space-mode;
                                            selected(v) => { root.set-ctrl-space-mode(self.current-index); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Output Target:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 110px; }
                                        // Two options only. "Show only" is
                                        // retired: the transcript is previewed
                                        // on the TextBoard either way, so a
                                        // display-only choice could only mean
                                        // "my dictation never reached the text
                                        // box".
                                        ComboBox {
                                            height: 40px;
                                            model: ["Type into active app", "Copy to clipboard"];
                                            current-index: root.ctrl-space-output == 1 ? 1 : 0;
                                            selected(v) => { root.set-ctrl-space-output(self.current-index); }
                                        }
                                    }
                                }

                                CheckBox {
                                    height: 40px;
                                    text: "Clean disfluencies (um, uh, repeats) from non-streaming transcripts";
                                    checked: root.clean-disfluencies;
                                    toggled => { root.set-clean-disfluencies(self.checked); }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "Cleanup model:";
                                        font-size: 13px;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                        min-width: 110px;
                                    }
                                    ComboBox {
                                        height: 40px;
                                        model: ["FDT 66M tagger - fillers + repeats only (66MB)", "S1-mini INT4 (0.6B) - self-corrections + numbers (375MB, slow)", "SmolLM2 360M Q4 - self-corrections + numbers (271MB, fast)", "Gemma 3 270M Q4 - self-corrections + numbers (253MB, fast)"];
                                        current-index: root.disfluency-engine;
                                        enabled: root.clean-disfluencies;
                                        selected(v) => { root.set-disfluency-engine(self.current-index); }
                                    }
                                }
                                if root.recommend-cleanup-note != "" : Text {
                                    text: root.recommend-cleanup-note;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #7FB069;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "FDT is an instant deletion-only tagger. The three normalizer engines also resolve self-corrections (\"no wait, thursday\") and write spoken numbers, dates and times in written form: S1-mini (0.6B, highest quality, slowest), SmolLM2 360M and Gemma 3 270M (llama.cpp, fast). Weights download on first use; the model loads only for the turn being cleaned, off the UI thread, and is dropped immediately after.";
                                    font-size: 12px;
                                    color: #9A9A9A;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ══════════════════════════════════════════════════════════════════
                    // TAB 1: SPEECH MODELS
                    // One recommendation banner, one model dropdown, one
                    // language dropdown, one unified catalog. Compatibility
                    // notes are inline; no duplicate progress bars.
                    // ══════════════════════════════════════════════════════════════════
                    if root.active-tab == 1 : VerticalLayout {
                        padding: 20px;
                        spacing: 16px;

                        Text {
                            text: "Speech Models";
                            font-size: 18px;
                            font-weight: 700;
                            color: #FFFFFF;
                        }

                        // ── Best-fit recommendation banner (the one action that matters) ──
                        if root.recommend-model != "" : Rectangle {
                            background: #141414;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #FFFFFF;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Best fit"; font-size: 12px; font-weight: 700; color: #9A9A9A; vertical-alignment: center; }
                                    Text { text: root.recommend-model; font-size: 13px; font-weight: 700; color: #FFFFFF; vertical-alignment: center; overflow: elide; }
                                    Rectangle { horizontal-stretch: 1; }
                                    // The recommended model's single action —
                                    // download when missing, use when local,
                                    // live percent while fetching.
                                    Rectangle {
                                        width: root.recommend-installed ? 84px : 128px;
                                        height: 30px;
                                        border-radius: 15px;
                                        background: use_rec.has-hover ? #E4E4E4 : #FFFFFF;
                                        animate background { duration: 130ms; easing: ease-out; }
                                        Text {
                                            text: root.recommend-installed ? "Use it" : ((root.is-downloading && root.recommend-size != "") ? (root.download-progress + "%") : ("Download " + root.recommend-size));
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #000000;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        use_rec := TouchArea {
                                            clicked => { root.download-recommended-model(); }
                                            mouse-cursor: pointer;
                                        }
                                    }
                                }
                            }
                        }

                        // ── Download progress (single place, single bar) ──
                        if root.is-downloading : Rectangle {
                            background: #141414;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: root.download-status;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: root.download-progress + "%";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {
                                    height: 8px;
                                    border-radius: 4px;
                                    background: #1F1F1F;
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 8px;
                                        width: (parent.width * root.download-progress / 100);
                                        border-radius: 4px;
                                        background: #FFFFFF;
                                    }
                                }
                                Text {
                                    text: (root.download-bytes != "" && root.download-speed != "") ? (root.download-bytes + "  ·  " + root.download-speed) : root.download-bytes;
                                    font-size: 12px;
                                    color: #9A9A9A;
                                }
                            }
                        }

                        // ── Model + Language card ──
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                Text { text: "Active model"; font-size: 13px; font-weight: 600; color: #FFFFFF; }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Provider"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 72px; }
                                    ComboBox {
                                        height: 40px;
                                        model: root.provider-options;
                                        current-index: root.active-provider-index;
                                        selected(v) => { root.set-provider(v); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Model"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 72px; }
                                    ComboBox {
                                        height: 40px;
                                        model: root.models;
                                        current-index: root.selected-model;
                                        selected(v) => { root.select-model(v); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Language"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 72px; }
                                    // Exactly one dropdown. Single-language models
                                    // show a disabled one-entry list — never a
                                    // prose note — so the column always reads the
                                    // same way.
                                    ComboBox {
                                        height: 40px;
                                        model: root.languages;
                                        current-index: root.selected-language;
                                        enabled: root.languages.length > 1;
                                        selected(v) => { root.select-language(v); }
                                    }
                                }
                            }
                        }

                        // ── Per-model parameters (when the active model
                        //    exposes any) ── Each row is typed:
                        //    kind 0 = Slider + value, 1 = CheckBox,
                        //    2 = ComboBox. Rust is the source of truth:
                        //    edits echo back through model-params after
                        //    they are persisted.
                        if root.model-params.length > 0 : Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                Text { text: "Model parameters"; font-size: 13px; font-weight: 600; color: #FFFFFF; }

                                for param in root.model-params : VerticalLayout {
                                    spacing: 4px;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text { text: param.label; font-size: 12px; color: #FFFFFF; vertical-alignment: center; min-width: 124px; }

                                        if param.kind == 0 : HorizontalLayout {
                                            spacing: 8px;
                                            Slider {
                                                height: 30px;
                                                minimum: param.lo;
                                                maximum: param.hi;
                                                value: param.value;
                                                changed(v) => {
                                                    root.set-model-param(param.key, round(v));
                                                }
                                            }
                                            Text {
                                                text: "" + round(param.value);
                                                font-size: 12px;
                                                color: #FFFFFF;
                                                vertical-alignment: center;
                                                min-width: 24px;
                                            }
                                        }

                                        if param.kind == 1 : CheckBox {
                                            text: "";
                                            checked: param.value != 0.0;
                                            toggled => {
                                                root.set-model-param(param.key, self.checked ? 1.0 : 0.0);
                                            }
                                        }

                                        if param.kind == 2 : ComboBox {
                                            height: 36px;
                                            model: param.choices;
                                            current-index: round(param.value);
                                            selected(v) => {
                                                root.set-model-param-choice(param.key, v);
                                            }
                                        }

                                        if param.kind == 3 : LineEdit {
                                            height: 36px;
                                            text: param.text-value;
                                            placeholder-text: "Paste API key…";
                                            edited(t) => {
                                                root.set-model-param-text(param.key, t);
                                            }
                                        }
                                    }

                                    if param.hint != "" : Text {
                                        text: param.hint;
                                        font-size: 12px;
                                        color: #9A9A9A;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        // ── Catalog: one searchable list, one card per model ──
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                Rectangle {
                                    height: 28px;
                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        background: transparent;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;
                                        Text { text: "Catalog"; font-size: 13px; font-weight: 600; color: #FFFFFF; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: "▾";
                                            font-size: 14px;
                                            color: #FFFFFF;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            transform-rotation: root.catalog-open ? 0deg : 180deg;
                                            animate transform-rotation { duration: 160ms; easing: ease-out; }
                                        }
                                    }
                                    catalog_toggle := TouchArea {
                                        clicked => { root.toggle-catalog(); }
                                        mouse-cursor: pointer;
                                    }
                                }

                                if root.catalog-open : LineEdit {
                                    height: 36px;
                                    text: root.catalog-search;
                                    placeholder-text: "Search models…";
                                    edited(t) => { root.set-catalog-search(t); }
                                }

                                for card in root.catalog : Rectangle {
                                    visible: root.catalog-open && card.visible;
                                    height: root.catalog-open && card.visible ? (root.connect-for == card.model-dir ? 138px : 66px) : 0px;
                                    border-radius: 8px;
                                    background: #141414;
                                    border-width: 1px;
                                    border-color: card.is-active ? #FFFFFF : #262626;

                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 6px;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 12px;
                                            alignment: center;

                                            VerticalLayout {
                                                spacing: 2px;
                                                alignment: center;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text { text: card.name; font-size: 13px; font-weight: 600; color: card.installed ? #FFFFFF : #9A9A9A; vertical-alignment: center; }
                                                    if card.badge != "" : Rectangle {
                                                        width: 76px; height: 18px; border-radius: 9px; background: #FFFFFF;
                                                        Text { text: card.badge; font-size: 11px; font-weight: 700; color: #000000; horizontal-alignment: center; vertical-alignment: center; }
                                                    }
                                                }
                                                Text { text: card.langs + " · " + card.size; font-size: 12px; color: #9A9A9A; vertical-alignment: center; }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            // One primary action per card:
                                            // installed → Select · missing → Download
                                            // (API cards: has-key → Use · no key → Connect)
                                            if card.provider == "Local" && card.installed : Rectangle {
                                                width: 96px;
                                                height: 30px;
                                                border-radius: 15px;
                                                background: select_touch.has-hover ? #2A2A2A : transparent;
                                                border-width: 1px;
                                                border-color: #404040;
                                                animate background { duration: 130ms; easing: ease-out; }
                                                Text {
                                                    text: card.is-active ? "Active" : "Select";
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: #FFFFFF;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                select_touch := TouchArea {
                                                    clicked => { root.select-catalog-model(card.index); }
                                                    mouse-cursor: (card.is-active ? default : pointer);
                                                }
                                            }
                                            if card.provider != "Local" && card.has-key : Rectangle {
                                                width: 96px;
                                                height: 30px;
                                                border-radius: 15px;
                                                background: use_touch.has-hover ? #2A2A2A : transparent;
                                                border-width: 1px;
                                                border-color: card.is-active ? #FFFFFF : #404040;
                                                animate background { duration: 130ms; easing: ease-out; }
                                                Text {
                                                    text: card.is-active ? "Active" : "Use";
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: #FFFFFF;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                use_touch := TouchArea {
                                                    clicked => { root.select-catalog-model(card.index); }
                                                    mouse-cursor: (card.is-active ? default : pointer);
                                                }
                                            }
                                            if card.provider != "Local" && !card.has-key : Rectangle {
                                                width: 96px;
                                                height: 30px;
                                                border-radius: 15px;
                                                background: conn_touch.has-hover ? #E4E4E4 : #FFFFFF;
                                                animate background { duration: 130ms; easing: ease-out; }
                                                Text {
                                                    text: "Connect";
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: #000000;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                conn_touch := TouchArea {
                                                    clicked => { root.open-connect(card.model-dir); }
                                                    mouse-cursor: pointer;
                                                }
                                            }
                                            if !card.installed : Rectangle {
                                                width: 96px;
                                                height: 30px;
                                                border-radius: 15px;
                                                background: dl_touch.has-hover ? #E4E4E4 : #FFFFFF;
                                                animate background { duration: 130ms; easing: ease-out; }
                                                Text {
                                                    text: card.downloading ? (root.download-progress + "%") : "Download";
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: #000000;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                dl_touch := TouchArea {
                                                    clicked => { if (!card.downloading) { root.download-catalog-model(card.index); } }
                                                    mouse-cursor: pointer;
                                                }
                                            }
                                        }

                                        // Inline API-key Connect box. Same GUI
                                        // language as the rest of Settings; appears
                                        // out of the card without disturbing layout.
                                        if root.connect-for == card.model-dir : VerticalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 4px;
                                            Text { text: "Enter your " + card.provider + " API key"; font-size: 12px; font-weight: 600; color: #FFFFFF; }
                                            LineEdit {
                                                height: 32px;
                                                text: card.connect-text;
                                                placeholder-text: "Paste API key…";
                                                edited(t) => { root.set-api-key-for(card.model-dir, t); }
                                            }
                                            Text {
                                                text: card.provider == "Groq"
                                                    ? "Get a free key at https://console.groq.com (API Keys)."
                                                    : card.provider == "OpenAI"
                                                        ? "Get a key at https://platform.openai.com/api-keys."
                                                        : "Get a key at https://console.deepgram.com (Settings → API Keys).";
                                                font-size: 12px;
                                                color: #9A9A9A;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ══════════════════════════════════════════════════════════════════
                    // TAB 2: WIDGET STYLE & LIVE PILL PREVIEW
                    // ══════════════════════════════════════════════════════════════════
                    if root.active-tab == 2 : VerticalLayout {
                        padding: 20px;
                        spacing: 16px;

                        Text {
                            text: "Widget Styling & Customization";
                            font-size: 18px;
                            font-weight: 700;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Customize the appearance of the floating mini pill widget. Sliders apply immediately with live preview.";
                            font-size: 12px;
                            color: #9A9A9A;
                            wrap: word-wrap;
                        }

                        // Interactive Live Preview Box
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "Live Mini Pill Preview"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                Rectangle {
                                    height: 90px;
                                    background: #000000;
                                    border-radius: 8px;

                                    HorizontalLayout {
                                        alignment: center;

                                        // Rendered Pill mirroring radius + opacity
                                        Rectangle {
                                            width: 250px;
                                            height: 48px;
                                            border-radius: (root.ui-pill-radius * 48px / 50);
                                            background: #111111;
                                            border-width: 1px;
                                            border-color: #FFFFFF;
                                            opacity: root.ui-opacity / 100.0;
                                            y: 21px;

                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                spacing: 10px;
                                                alignment: space-between;

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: start;
                                                    Rectangle {
                                                        width: 10px;
                                                        height: 10px;
                                                        border-radius: 5px;
                                                        background: #FFFFFF;
                                                        y: 18px;
                                                    }
                                                    Text {
                                                        text: "QuickSTT";
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        color: #FFFFFF;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                Text {
                                                    text: "Dictate Ctrl+Win";
                                                    font-size: 12px;
                                                    color: #9A9A9A;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Sliders & Adjustments Card
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                Text { text: "Dimensions & Opacity"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Widget Opacity:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 160px; }
                                    Slider {
                                        height: 34px;
                                        minimum: 20;
                                        maximum: 100;
                                        value: root.ui-opacity;
                                        changed(val) => { root.set-ui-opacity(val); }
                                    }
                                    Text { text: root.ui-opacity + "%"; font-size: 13px; color: #FFFFFF; font-weight: 600; vertical-alignment: center; min-width: 50px; }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Corner Roundness:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 160px; }
                                    Slider {
                                        height: 34px;
                                        minimum: 0;
                                        maximum: 25;
                                        value: root.ui-pill-radius;
                                        changed(val) => { root.set-ui-pill-radius(val); }
                                    }
                                    Text { text: root.ui-pill-radius + " px"; font-size: 13px; color: #FFFFFF; font-weight: 600; vertical-alignment: center; min-width: 50px; }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "System Tray Icon Size:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 160px; }
                                    Slider {
                                        height: 34px;
                                        minimum: 16;
                                        maximum: 64;
                                        value: root.tray-icon-size;
                                        changed(val) => { root.set-tray-icon-size(val); }
                                    }
                                    Text { text: root.tray-icon-size + " px"; font-size: 13px; color: #FFFFFF; font-weight: 600; vertical-alignment: center; min-width: 50px; }
                                }

                                CheckBox {
                                    height: 40px;
                                    text: "Show animated waveform when actively listening";
                                    checked: root.show-waveform;
                                    toggled => { root.set-show-waveform(self.checked); }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Waveform Sensitivity:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 160px; }
                                    Slider {
                                        height: 34px;
                                        minimum: 1;
                                        maximum: 15;
                                        value: root.waveform-sensitivity;
                                        enabled: root.show-waveform;
                                        changed(val) => { root.set-waveform-sensitivity(val); }
                                    }
                                    Text { text: root.waveform-sensitivity + ""; font-size: 13px; color: #FFFFFF; font-weight: 600; vertical-alignment: center; min-width: 50px; }
                                }
                            }
                        }
                    }

                    // ══════════════════════════════════════════════════════════════════
                    // TAB 3: WAKEWORDS, VAD & SENSITIVITY
                    // ══════════════════════════════════════════════════════════════════
                    if root.active-tab == 3 : VerticalLayout {
                        padding: 20px;
                        spacing: 16px;

                        Text {
                            text: "Wakewords & Voice Activity Detection";
                            font-size: 18px;
                            font-weight: 700;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Hands-free voice triggers. Calibrated sensitivity and strict noise gates prevent false activations from room noise and TV audio.";
                            font-size: 12px;
                            color: #9A9A9A;
                            wrap: word-wrap;
                        }

                        // Master Activation Switch
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        Text { text: "Hands-Free Wakeword Detection"; font-size: 14px; font-weight: 600; color: #FFFFFF; }
                                        Text { text: "When enabled, QuickSTT listens for wake phrases in the background (< 1 MB RAM)."; font-size: 12px; color: #9A9A9A; }
                                    }
                                    CheckBox {
                                        height: 40px;
                                        text: "Active";
                                        checked: root.wakeword-enabled;
                                        toggled => { root.set-wakeword-enabled(self.checked); }
                                    }
                                }
                            }
                        }

                        // Calibrated Sensitivity Sliders
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                Text { text: "Sensitivity & Noise Gate Tuning"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                Text { text: root.wakeword-threshold-text; font-size: 12px; color: #9A9A9A; wrap: word-wrap; }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Wakeword Sensitivity:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 170px; }
                                    Slider {
                                        height: 34px;
                                        minimum: 0;
                                        maximum: 100;
                                        value: root.wakeword-sensitivity;
                                        changed(val) => { root.set-wakeword-sensitivity(val); }
                                    }
                                    Text {
                                        text: root.wakeword-sensitivity <= 30 ? (root.wakeword-sensitivity + "% (Strict)") : (root.wakeword-sensitivity >= 70 ? (root.wakeword-sensitivity + "% (Hot)") : (root.wakeword-sensitivity + "% (Balanced)"));
                                        font-size: 12px;
                                        color: #FFFFFF;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        min-width: 95px;
                                    }
                                }
                                Text {
                                    text: "Score bar for the phrases above — HIGHER (right) = triggers on quieter speech, LOWER (left) = needs louder, clearer speech. Too high answers TV and chatter; too low needs shouting. 50 is balanced.";
                                    font-size: 12px;
                                    color: #9A9A9A;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "VAD Speech Gate:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 170px; }
                                    Slider {
                                        height: 34px;
                                        minimum: 0;
                                        maximum: 100;
                                        value: root.vad-sensitivity;
                                        changed(val) => { root.set-vad-sensitivity(val); }
                                    }
                                    Text {
                                        text: root.vad-sensitivity <= 30 ? (root.vad-sensitivity + "% (Strict)") : (root.vad-sensitivity >= 70 ? (root.vad-sensitivity + "% (Open)") : (root.vad-sensitivity + "% (Balanced)"));
                                        font-size: 12px;
                                        color: #FFFFFF;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        min-width: 95px;
                                    }
                                }
                                Text {
                                    text: "Voice gate in front of the detector — HIGHER (right) = soft speech gets through, but so does more room noise. LOWER (left) = stricter; set too low, quiet phrases never reach the detector at all. Same direction as above: right = more sensitive. 50 is balanced.";
                                    font-size: 12px;
                                    color: #9A9A9A;
                                    wrap: word-wrap;
                                }

                                // Live Microphone Input Level Visualizer
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Microphone Audio Level:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 170px; }
                                    Rectangle {
                                        height: 10px;
                                        border-radius: 5px;
                                        background: #1A1A1A;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 10px;
                                            width: (parent.width * root.live-audio-level / 100);
                                            border-radius: 5px;
                                            background: root.live-audio-level > 60 ? #DA3633 : (root.live-audio-level > 20 ? #FFFFFF : #FFFFFF);
                                        }
                                    }
                                    Text {
                                        text: root.live-audio-level + "%";
                                        font-size: 12px;
                                        color: #9A9A9A;
                                        vertical-alignment: center;
                                        min-width: 45px;
                                    }
                                }
                            }
                        }

                        // Enabled Wakewords List
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text { text: "Active Wakewords (community openWakeWord heads)"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                HorizontalLayout {
                                    spacing: 20px;
                                    CheckBox {
                                        height: 40px;
                                        text: "\"Hey Jarvis\"";
                                        checked: root.ww-hey-jarvis;
                                        toggled => { root.toggle-wakeword-phrase("hey jarvis", self.checked); }
                                    }
                                    CheckBox {
                                        height: 40px;
                                        text: "\"Alexa\"";
                                        checked: root.ww-alexa;
                                        toggled => { root.toggle-wakeword-phrase("alexa", self.checked); }
                                    }
                                }

                            }
                        }

                        // Acoustic Sound Trigger (clap only — snap retired)
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "Acoustic Transient Trigger"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Clap Action:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; }
                                    ComboBox {
                                        height: 40px;
                                        model: ["Start Dictation", "Stop Dictation", "Disabled"];
                                        current-index: root.transient-action;
                                        enabled: true;
                                        selected(v) => { root.set-transient-action(self.current-index); }
                                    }
                                }
                                Text {
                                    text: "One sharp hand clap triggers the action above. Isolated impulses only — speech and sustained noise are vetoed. Wakewords work independently.";
                                    font-size: 12px;
                                    color: #9A9A9A;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                            // ══════════════════════════════════════════════════════════════════
                            // TAB 5: TRANSCRIPTION HISTORY
                            // ══════════════════════════════════════════════════════════════════
                            if root.active-tab == 5 : VerticalLayout {
                                padding: 20px;
                                spacing: 16px;

                                Text {
                                    text: "Transcription History";
                                    font-size: 18px;
                                    font-weight: 700;
                                    color: #FFFFFF;
                                }
                                Text {
                                    text: "Every turn you have dictated, newest first, with its audio. Play it back, copy or export it, select turns in bulk, or delete everything.";
                                    font-size: 12px;
                                    color: #9A9A9A;
                                    wrap: word-wrap;
                                }

                                                    // ── Transcription History (its own section) ──
                                                    // Every finished turn with its audio: a round play /
                                                    // pause control, a drag-to-seek timeline with the
                                                    // elapsed/total clock, the transcript, and a right-hand
                                                    // action cluster (copy with a green ✓ flash, delete,
                                                    // and ⋮ which opens a floating menu with copy /
                                                    // download / delete). Every glyph is DRAWN, so rows
                                                    // render identically on Windows and Linux, and every
                                                    // button answers hover/press with a short animation.
                                                    Rectangle {
                                                        background: #0E0E0E;
                                                        border-radius: 10px;
                                                        border-width: 1px;
                                                        border-color: #262626;

                                                        VerticalLayout {
                                                            padding: 16px;
                                                            spacing: 12px;

                                                            HorizontalLayout {
                                                                spacing: 8px;
                                                                Text {
                                                                    text: "Transcript History";
                                                                    font-size: 14px;
                                                                    font-weight: 600;
                                                                    color: #FFFFFF;
                                                                    vertical-alignment: center;
                                                                }
                                                                Text {
                                                                    text: root.history-total == 0 ? "" : root.history-total + " turns";
                                                                    font-size: 12px;
                                                                    color: #8E8E8E;
                                                                    vertical-alignment: center;
                                                                }
                                                                Rectangle { horizontal-stretch: 1; }

                                                                // ── Bulk controls ──
                                                                // "Select turns" enters selection mode (each
                                                                // row swaps its play circle for a checkbox,
                                                                // so nothing in the layout moves). "Delete
                                                                // all" is deliberately two-step — the first
                                                                // click arms it, the second wipes every
                                                                // stored turn and its audio — and a timer
                                                                // disarms it again, so no modal is needed
                                                                // and history can never be nuked by one
                                                                // stray click.
                                                                ToggleRow {
                                                                     width: 132px;
                                                                     glyph: "\u{E834}";
                                                                     label: root.rail-mode ? "Select" : "Select turns";
                                                                     on: root.history-selecting;
                                                                     toggled(v) => { root.history-set-selecting(v); }
                                                                 }
                                                                Rectangle {
                                                                    width: 140px;
                                                                    height: 40px;
                                                                    border-radius: 8px;
                                                                    background: root.delete-all-armed ? #3A1414 : (del_all_touch.has-hover ? #2A1414 : #161616);
                                                                    border-width: 1px;
                                                                    border-color: root.delete-all-armed ? #FF6A6A : #3A2020;
                                                                    animate background { duration: 130ms; easing: ease-out; }
                                                                    animate border-color { duration: 130ms; easing: ease-out; }
                                                                    Text {
                                                                        text: root.delete-all-armed ? "Tap again to confirm" : "Delete all";
                                                                        font-size: 12.5px;
                                                                        font-weight: 700;
                                                                        color: #FF9A9A;
                                                                        horizontal-alignment: center;
                                                                        vertical-alignment: center;
                                                                        overflow: elide;
                                                                    }
                                                                    del_all_touch := TouchArea {
                                                                        clicked => {
                                                                            if (root.delete-all-armed) {
                                                                                root.history-delete-all();
                                                                                root.delete-all-armed = false;
                                                                            } else {
                                                                                root.delete-all-armed = true;
                                                                            }
                                                                        }
                                                                        mouse-cursor: pointer;
                                                                    }
                                                                }
                                                                // Disarm "Delete all" a few seconds after
                                                                // arming so a forgotten click stays harmless.
                                                                Timer {
                                                                    interval: 5s;
                                                                    running: root.delete-all-armed;
                                                                    triggered => { root.delete-all-armed = false; }
                                                                }
                                                                // Backup toggle: OFF stops new turns from
                                                                // being recorded (existing rows stay).
                                                                ToggleRow {
                                                                     width: 148px;
                                                                     glyph: "\u{E2C7}";
                                                                     label: root.rail-mode ? "Back up" : "Back up new turns";
                                                                     on: root.history-enabled;
                                                                     toggled(v) => { root.set-history-enabled(v); }
                                                                 }
                                                            }

                                                            // Selection action bar: counts, select-all, and
                                                            // the two bulk exports/deletes. Only present in
                                                            // selection mode — normal browsing never sees it.
                                                            if root.history-selecting : HorizontalLayout {
                                                                spacing: 8px;
                                                                Text {
                                                                    text: root.history-selected-count + " selected";
                                                                    font-size: 12px;
                                                                    color: #E6E6E6;
                                                                    vertical-alignment: center;
                                                                    min-width: 78px;
                                                                }
                                                                ToggleRow {
                                                                     width: 108px;
                                                                     height: 36px;
                                                                     glyph: "\u{E162}";
                                                                     label: root.rail-mode ? "All" : "Select all";
                                                                     on: root.history-all-selected;
                                                                     toggled(v) => { root.history-select-all(v); }
                                                                 }
                                                                Rectangle { horizontal-stretch: 1; }
                                                                Rectangle {
                                                                    width: 150px;
                                                                    height: 36px;
                                                                    border-radius: 8px;
                                                                    background: exp_touch.has-hover ? #242424 : #1A1A1A;
                                                                    border-width: 1px;
                                                                    border-color: #303030;
                                                                    animate background { duration: 130ms; easing: ease-out; }
                                                                    Text {
                                                                        text: "Export audio";
                                                                        font-size: 12.5px;
                                                                        font-weight: 600;
                                                                        color: #E6E6E6;
                                                                        horizontal-alignment: center;
                                                                        vertical-alignment: center;
                                                                    }
                                                                    exp_touch := TouchArea {
                                                                        clicked => { root.history-download-selected(); }
                                                                        mouse-cursor: pointer;
                                                                    }
                                                                }
                                                                Rectangle {
                                                                    width: 158px;
                                                                    height: 36px;
                                                                    border-radius: 8px;
                                                                    background: del_sel_touch.has-hover ? #2A1414 : #1A1A1A;
                                                                    border-width: 1px;
                                                                    border-color: #3A2020;
                                                                    animate background { duration: 130ms; easing: ease-out; }
                                                                    Text {
                                                                        text: "Delete selected";
                                                                        font-size: 12.5px;
                                                                        font-weight: 600;
                                                                        color: #FF9A9A;
                                                                        horizontal-alignment: center;
                                                                        vertical-alignment: center;
                                                                    }
                                                                    del_sel_touch := TouchArea {
                                                                        clicked => { root.history-delete-selected(); }
                                                                        mouse-cursor: pointer;
                                                                    }
                                                                }
                                                            }

                                                             if root.history-items.length == 0 : Rectangle {
                                                                 height: 230px;
                                                                 VerticalLayout {
                                                                     alignment: center;
                                                                     spacing: 8px;
                                                                     IconSym {
                                                                         glyph: "\u{E1B8}";
                                                                         size: 46px;
                                                                         tint: #2E2E2E;
                                                                     }
                                                                     Text {
                                                                         text: root.history-selecting ? "Nothing to select yet" : "Nothing recorded yet";
                                                                         font-size: 14px;
                                                                         font-weight: 600;
                                                                         color: #D8D8D8;
                                                                         horizontal-alignment: center;
                                                                     }
                                                                     Text {
                                                                         text: "Hold Ctrl+Space and speak — every finished turn lands here with its audio.";
                                                                         font-size: 12px;
                                                                         color: #8E8E8E;
                                                                         horizontal-alignment: center;
                                                                         wrap: word-wrap;
                                                                     }
                                                                 }
                                                             }

                                                            for item[i] in root.history-items : Rectangle {
                                                                background: card_touch.has-hover ? #101010 : #0A0A0A;
                                                                border-radius: 10px;
                                                                border-width: 1px;
                                                                border-color: card_touch.has-hover ? #2A2A2A : #1C1C1C;
                                                                animate background { duration: 150ms; easing: ease-out; }
                                                                animate border-color { duration: 150ms; easing: ease-out; }

                                                                // Whole-card hover feedback. Declared first so
                                                                // every control below stays on top of it.
                                                                card_touch := TouchArea {
                                                                    mouse-cursor: default;
                                                                }

                                                                VerticalLayout {
                                                                    padding: 12px;
                                                                    spacing: 9px;

                                                                    // ── Line 1: play · when ───────── actions ──
                                                                    HorizontalLayout {
                                                                        spacing: 9px;

                                                                        // ── Selection checkbox ──
                                                                        // Sits exactly where the play circle
                                                                        // sits (selection mode swaps them),
                                                                        // so enabling selection never shifts
                                                                        // the transcript or the timeline.
                                                                        Rectangle {
                                                                            width: root.tap-size;
                                                                            height: root.tap-size;
                                                                            visible: root.history-selecting;

                                                                            Rectangle {
                                                                                x: (parent.width - self.width) / 2;
                                                                                y: (parent.height - self.height) / 2;
                                                                                width: sel_touch.pressed ? 24px : 28px;
                                                                                height: sel_touch.pressed ? 24px : 28px;
                                                                                border-radius: 8px;
                                                                                background: item.selected ? #FFFFFF : (sel_touch.has-hover ? #202020 : #141414);
                                                                                border-width: 1px;
                                                                                border-color: item.selected ? #FFFFFF : (sel_touch.has-hover ? #303030 : #202020);
                                                                                animate background { duration: 120ms; easing: ease-out; }
                                                                                animate border-color { duration: 120ms; easing: ease-out; }
                                                                                 // Drawn check (the same Path tick as the copy
                                                                                 // flash) - no font glyph, identical on every OS.
                                                                                 IconSym {
                                                                                      visible: item.selected;
                                                                                      width: 22px;
                                                                                      height: 22px;
                                                                                      x: (parent.width - self.width) / 2;
                                                                                      y: (parent.height - self.height) / 2;
                                                                                      glyph: "\u{E5CA}";
                                                                                      tint: #000000;
                                                                                      size: 20px;
                                                                                  }
                                                                            }
                                                                            sel_touch := TouchArea {
                                                                                clicked => { root.history-set-selected(i, !item.selected); }
                                                                                mouse-cursor: pointer;
                                                                            }
                                                                        }

                                                                        // Play / pause — the primary control.
                                                                        // 44x44 fingertip target with a 36px
                                                                        // visual circle (was 32x32).
                                                                        Rectangle {
                                                                            width: root.tap-size;
                                                                            height: root.tap-size;
                                                                            visible: !root.history-selecting;
                                                                            opacity: item.has_audio ? 1.0 : 0.4;

                                                                            Rectangle {
                                                                                x: (parent.width - self.width) / 2;
                                                                                y: (parent.height - self.height) / 2;
                                                                                width: play_touch.pressed ? 31px : 36px;
                                                                                height: play_touch.pressed ? 31px : 36px;
                                                                                border-radius: 18px;
                                                                                background: item.playing ? #FFFFFF : (play_touch.has-hover ? #202020 : #141414);
                                                                                border-width: 1px;
                                                                                border-color: item.playing ? #FFFFFF : (play_touch.has-hover ? #303030 : #202020);
                                                                                animate background { duration: 130ms; easing: ease-out; }
                                                                                animate border-color { duration: 130ms; easing: ease-out; }
                                                                                animate width { duration: 90ms; easing: ease-out; }
                                                                                animate height { duration: 90ms; easing: ease-out; }
                                                                            }
                                                                            IconSym {
                                                                                x: 8px;
                                                                                y: 8px;
                                                                                visible: !item.playing;
                                                                                glyph: "\u{E037}";
                                                                                tint: play_touch.has-hover ? #FFFFFF : #E6E6E6;
                                                                                size: 20px;
                                                                            }
                                                                            IconSym {
                                                                                x: 8px;
                                                                                y: 8px;
                                                                                visible: item.playing;
                                                                                glyph: "\u{E034}";
                                                                                tint: #000000;
                                                                                size: 20px;
                                                                            }
                                                                            play_touch := TouchArea {
                                                                                enabled: item.has_audio;
                                                                                clicked => { root.history-play(i); }
                                                                                mouse-cursor: item.has_audio ? pointer : default;
                                                                            }
                                                                        }

                                                                        Text {
                                                                            text: item.when;
                                                                            font-size: 12px;
                                                                            color: #8E8E8E;
                                                                            vertical-alignment: center;
                                                                        }

                                                                        Rectangle { horizontal-stretch: 1; }

                                                                        // Copy transcript — flips to a green ✓ for a beat.
                                                                        HistButton {
                                                                            kind: 0;
                                                                            copied: item.copied;
                                                                            visible: !root.history-selecting;
                                                                            clicked => { root.history-copy(i); }
                                                                        }

                                                                        // Delete turn (instant; the ⋮ menu repeats it).
                                                                        HistButton {
                                                                            kind: 1;
                                                                            rest-plate: #131313;
                                                                            hover-plate: #2A1414;
                                                                            rest-tint: #9A9A9A;
                                                                            hover-tint: #FF9A9A;
                                                                            clicked => { root.history-delete(i); }
                                                                        }

                                                                        // ⋮ — opens the floating action menu.
                                                                        more_btn := HistButton {
                                                                            kind: 2;
                                                                            active: root.history-menu-idx == i;
                                                                            visible: !root.history-selecting;
                                                                            clicked => {
                                                                                if (root.history-menu-idx == i) {
                                                                                    root.history-menu(i, false);
                                                                                    root.history-menu-idx = -1;
                                                                                } else {
                                                                                    root.hist-menu-x = more_btn.absolute-position.x + more_btn.width;
                                                                                    root.hist-menu-y = more_btn.absolute-position.y + more_btn.height + 6px;
                                                                                    root.hist-menu-grown = false;
                                                                                    root.history-menu-idx = i;
                                                                                    root.history-menu(i, true);
                                                                                }
                                                                            }
                                                                        }
                                                                    }

                                                                    // ── Lines 2 & 3: transcript + timeline ──
                                                                    VerticalLayout {
                                                                        padding-left: 53px;
                                                                        spacing: 9px;

                                                                        Text {
                                                                            text: item.text;
                                                                            font-size: 12.5px;
                                                                            color: #EDEDED;
                                                                            wrap: word-wrap;
                                                                        }

                                                                        HorizontalLayout {
                                                                            spacing: 10px;

                                                                            // Drag-to-seek timeline: 20px grab area,
                                                                            // 4px track that thickens on hover with a
                                                                            // round handle; the played part is white.
                                                                            Rectangle {
                                                                                horizontal-stretch: 1;
                                                                                height: 34px;

                                                                                Rectangle {
                                                                                    y: (parent.height - self.height) / 2;
                                                                                    width: parent.width;
                                                                                    height: seek_touch.has-hover || item.playing ? 6px : 4px;
                                                                                    border-radius: seek_touch.has-hover || item.playing ? 3px : 2px;
                                                                                    background: #242424;
                                                                                    animate height { duration: 120ms; easing: ease-out; }
                                                                                    animate border-radius { duration: 120ms; easing: ease-out; }

                                                                                    Rectangle {
                                                                                        width: parent.width * item.progress;
                                                                                        height: parent.height;
                                                                                        border-radius: parent.border-radius;
                                                                                        background: #FFFFFF;
                                                                                    }

                                                                                    Rectangle {
                                                                                        x: clamp(parent.width * item.progress - 7px, 0px, parent.width - 14px);
                                                                                        y: (parent.height - self.height) / 2;
                                                                                        width: 14px;
                                                                                        height: 14px;
                                                                                        border-radius: 7px;
                                                                                        background: #FFFFFF;
                                                                                        visible: item.has_audio && (item.progress > 0.001 || item.playing);
                                                                                        opacity: seek_touch.has-hover || item.playing ? 1.0 : 0.0;
                                                                                        animate opacity { duration: 120ms; easing: ease-out; }
                                                                                    }
                                                                                }
                                                                                seek_touch := TouchArea {
                                                                                    enabled: item.has_audio;
                                                                                    clicked => { root.history-seek(i, clamp(self.mouse-x / self.width, 0.0, 1.0)); }
                                                                                    moved => {
                                                                                        if (self.pressed) {
                                                                                            root.history-seek(i, clamp(self.mouse-x / self.width, 0.0, 1.0));
                                                                                        }
                                                                                    }
                                                                                    mouse-cursor: item.has_audio ? pointer : default;
                                                                                }
                                                                            }

                                                                            // Elapsed / total clock, right of the bar.
                                                                            Text {
                                                                                text: item.playing ? (item.pos + " / " + item.dur) : item.dur;
                                                                                font-size: 12px;
                                                                                color: item.playing ? #FFFFFF : #8E8E8E;
                                                                                vertical-alignment: center;
                                                                                min-width: 84px;
                                                                                horizontal-alignment: right;
                                                                                animate color { duration: 150ms; }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                            }
                    // ══════════════════════════════════════════════════════════════════
                    // TAB 4: SYSTEM & UPDATES
                    // ══════════════════════════════════════════════════════════════════
                    if root.active-tab == 4 : VerticalLayout {
                        padding: 20px;
                        spacing: 16px;

                        Text {
                            text: "System Information & Updates";
                            font-size: 18px;
                            font-weight: 700;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Inspect active ML inference runtimes, build versions, and software update status.";
                            font-size: 12px;
                            color: #9A9A9A;
                            wrap: word-wrap;
                        }

                        // System Runtime Status Card
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text { text: "Runtime Diagnostic Status"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Core Architecture:"; font-size: 13px; color: #9A9A9A; }
                                    Text { text: "Rust 64-bit (Tokio + Slint)"; font-size: 13px; font-weight: 600; color: #FFFFFF; }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Audio Driver:"; font-size: 13px; color: #9A9A9A; }
                                    Text { text: "WASAPI shared (cpal)"; font-size: 13px; font-weight: 600; color: #FFFFFF; }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Wakeword Engine:"; font-size: 13px; color: #9A9A9A; }
                                    Text { text: "ONNX Tract (2 heads)"; font-size: 13px; font-weight: 600; color: #FFFFFF; }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Speech Recognition:"; font-size: 13px; color: #9A9A9A; }
                                    Text { text: "Vosk Native & ONNX"; font-size: 13px; font-weight: 600; color: #FFFFFF; }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Idle Memory Usage:"; font-size: 13px; color: #9A9A9A; }
                                    Text { text: "< 5 MB idle (auto-offload)"; font-size: 13px; font-weight: 600; color: #FFFFFF; }
                                }
                            }
                        }

                        // Version & Updates Card
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                // Brand row: the same app icon that ships in the exe,
                                // tray and both installers — centered, always.
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 10px;
                                    padding-top: 4px;
                                    padding-bottom: 2px;
                                    Image {
                                        source: @image-url("../../assets/app_icon.svg");
                                        width: 40px;
                                        height: 54px;
                                    }
                                    VerticalLayout {
                                        spacing: 0px;
                                        padding-top: 2px;
                                        Text {
                                            text: "QuickSTT";
                                            font-size: 17px;
                                            font-weight: 700;
                                            color: #FFFFFF;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Text { text: "Version & Software Updates"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        Text { text: "QuickSTT Release:"; font-size: 13px; color: #FFFFFF; font-weight: 600; }
                                        Text { text: root.app-version; font-size: 12px; color: #9A9A9A; }
                                    }
                                    Rectangle {
                                        width: 140px;
                                        height: 32px;
                                        border-radius: 6px;
                                        background: #FFFFFF;
                                        y: 4px;
                                        Text {
                                            text: "Check Updates";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #000000;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea {
                                            clicked => { root.check-updates(); }
                                            mouse-cursor: pointer;
                                        }
                                    }
                                }

                                // Re-run the onboarding tour: the tour is never
                                // one-shot, so a new install (or a user who
                                // skipped it) can always come back to it.
                                Rectangle {
                                    height: 40px;
                                    border-radius: 8px;
                                    background: tour_touch.has-hover ? #242424 : #161616;
                                    border-width: 1px;
                                    border-color: #303030;
                                    animate background { duration: 130ms; easing: ease-out; }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        spacing: 10px;
                                        Text {
                                            text: "Show the intro tour again";
                                            font-size: 12.5px;
                                            color: #E6E6E6;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Rectangle { width: 12px; }
                                    }
                                    tour_touch := TouchArea {
                                        clicked => { root.show-onboarding(); }
                                        mouse-cursor: pointer;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

    // ── "Copied" toast ──
    // Root-level overlay (declared before the ⋮ menu so the menu still paints
    // over it). Rust flips history-toast-show on copy and back off ~2.5 s
    // later; opacity + rise animate both ways for the fade in/out. No
    // TouchArea: it never intercepts clicks.
    Rectangle {
        x: (root.width - self.width) / 2;
        y: root.history-toast-show ? (root.height - 64px) : (root.height - 50px);
        width: 196px;
        height: 40px;
        border-radius: 10px;
        background: #161616;
        border-width: 1px;
        border-color: #2E2E2E;
        drop-shadow-blur: 18px;
        drop-shadow-color: #000000AA;
        drop-shadow-offset-y: 6px;
        opacity: root.history-toast-show ? 1.0 : 0.0;
        animate opacity { duration: 260ms; easing: ease-in-out; }
        animate y { duration: 260ms; easing: ease-out; }

        IconSym { glyph: "\u{E5CA}"; x: 10px; y: 6px; tint: #4ADE80; size: 24px; }

        Text {
            x: 44px;
            y: 0px;
            width: parent.width - 54px;
            height: parent.height;
            text: "Copied to clipboard";
            font-size: 12.5px;
            font-weight: 600;
            color: #EDEDED;
            vertical-alignment: center;
        }
    }

    // ── Floating history row menu (⋮) ──
    // A root-level overlay declared after the whole UI so it always paints on
    // top (Slint stacks in declaration order). Staying inside this window
    // means it can never be clipped by the history list nor flash a second OS
    // popup. Clicking anywhere outside dismisses; the card swallows its own
    // clicks. Height is fixed: header 24 + separators 2 + items 102 + spacing
    // 15 + padding 12 = 155px.
    if root.history-menu-idx >= 0 && root.history-menu-idx < root.history-items.length : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: transparent;

        // Flip the rise/fade flag one tick after opening so it animates.
        Timer {
            interval: 1ms;
            running: true;
            triggered => { root.hist-menu-grown = true; }
        }

        // Any click outside the card dismisses the menu (and syncs Rust).
        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => {
                root.history-menu(root.history-menu-idx, false);
                root.history-menu-idx = -1;
            }
            mouse-cursor: default;
        }

        // The card: right-aligned under the ⋮ button, clamped into the window.
        Rectangle {
            x: clamp(root.hist-menu-x - self.width, 10px, root.width - self.width - 10px);
            y: clamp(root.hist-menu-y + (root.hist-menu-grown ? 0px : 7px), 10px, root.height - self.height - 10px);
            width: 252px;
            height: 224px;
            opacity: root.hist-menu-grown ? 1.0 : 0.0;
            animate opacity { duration: 130ms; easing: ease-out; }

            background: #171717;
            border-radius: 12px;
            border-width: 1px;
            border-color: #2E2E2E;
            drop-shadow-color: #000000B8;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;

            // Swallow clicks on the card's own padding/header so they do not
            // reach the outside-click catcher (declared first = beneath the
            // menu items).
            TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                mouse-cursor: default;
            }

            VerticalLayout {
                padding: 6px;
                spacing: 3px;

                // Which turn this menu belongs to.
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Rectangle { height: 1px; horizontal-stretch: 1; background: #2A2A2A; }
                }

                HistMenuItem {
                    kind: 0;
                    copied: root.history-items[root.history-menu-idx].copied;
                    label: root.history-items[root.history-menu-idx].copied ? "Copied to clipboard" : "Copy transcript";
                    clicked => { root.history-copy(root.history-menu-idx); }
                }

                HistMenuItem {
                    kind: 1;
                    label: root.history-items[root.history-menu-idx].has_audio ? "Download audio + transcript" : "Download transcript";
                    clicked => {
                        root.history-download(root.history-menu-idx);
                        root.history-menu-idx = -1;
                    }
                }

                // Audio only: the wav with NO transcript beside it.
                HistMenuItem {
                    kind: 1;
                    label: "Download audio only (no text)";
                    visible: root.history-items[root.history-menu-idx].has_audio;
                    clicked => {
                        root.history-download-audio(root.history-menu-idx);
                        root.history-menu-idx = -1;
                    }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Rectangle { height: 1px; horizontal-stretch: 1; background: #2A2A2A; }
                }

                HistMenuItem {
                    kind: 2;
                    danger: true;
                    label: "Delete turn";
                    clicked => {
                        root.history-delete(root.history-menu-idx);
                        root.history-menu-idx = -1;
                    }
                }
            }
        }
    }
        }
}
