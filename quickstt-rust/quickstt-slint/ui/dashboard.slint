import { Button, CheckBox, ComboBox, LineEdit, Slider, ScrollView } from "std-widgets.slint";

// Model card for the hardware-aware catalog (image-inspired): name, blurb,
// badge (Active/Recommended/Legacy/"", pink pills), accuracy/speed 0-100,
// languages label, size label, installed flag, entry index for callbacks.
export struct ModelCard {
    name: string,
    blurb: string,
    badge: string,
    accuracy: int,
    speed: int,
    langs: string,
    size: string,
    installed: bool,
    is_active: bool,
    index: int,
    downloading: bool,
}

// One recorded turn for the dashboard History section. Times and labels are
// pre-formatted in Rust so the rows stay cheap (the whole model is rebuilt at
// most 10x/second, and only while something is actually playing).
export struct HistRow {
    index: int,
    when: string,
    dur: string,
    pos: string,
    text: string,
    has_audio: bool,
    menu_open: bool,
    playing: bool,
    progress: float,
    copied: bool,
}

// ─────────────────────────────────────────────────────────────────────────────
// Transcript History building blocks.
//
// Every glyph below is DRAWN (paths and rectangles), never a font glyph ("▶",
// "🗑", "⋮", …). Font glyphs render at different weights/baselines per OS and
// emoji can come out in colour; drawn shapes are pixel-identical everywhere.
// ─────────────────────────────────────────────────────────────────────────────

// "Copy" — two stacked sheets. The front sheet paints the plate colour behind
// it so the back sheet's stroke never crosses through the paper.
component IconCopy inherits Rectangle {
    in property <color> tint: #9A9A9A;
    in property <color> sheet-bg: #131313;
    width: 28px;
    height: 28px;

    Rectangle {
        x: 12.25px;
        y: 7px;
        width: 8px;
        height: 10.5px;
        border-radius: 2.5px;
        border-width: 1.4px;
        border-color: root.tint;
    }
    Rectangle {
        x: 7.75px;
        y: 10.5px;
        width: 8px;
        height: 10.5px;
        border-radius: 2.5px;
        border-width: 1.4px;
        border-color: root.tint;
        background: root.sheet-bg;
        animate background { duration: 130ms; easing: ease-out; }
    }
}

// "Copied" tick.
component IconCheck inherits Rectangle {
    in property <color> tint: #4ADE80;
    width: 28px;
    height: 28px;
    Path {
        commands: "M 8.6 14.6 L 12.2 18.2 L 19.4 10.6";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 2.2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        // Pin the viewbox to the icon canvas. Without it, Slint scales the
        // path's implicit bounding box to fill the element (glyphs render
        // several times too big and off-center).
        viewbox-width: 28;
        viewbox-height: 28;
    }
}

// "Delete" — lid bar + handle bracket + tapered can; the strokes meet at the
// lid instead of crossing, so no occluder is needed.
component IconTrash inherits Rectangle {
    in property <color> tint: #9A9A9A;
    width: 28px;
    height: 28px;

    Rectangle {
        x: 8px;
        y: 9.6px;
        width: 12px;
        height: 1.4px;
        border-radius: 0.7px;
        background: root.tint;
    }
    Path {
        commands: "M 11.2 10.3 L 11.2 7.8 L 16.8 7.8 L 16.8 10.3";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        viewbox-width: 28;
        viewbox-height: 28;
    }
    Path {
        commands: "M 9.6 10.9 L 10.4 20.8 L 17.6 20.8 L 18.4 10.9";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        viewbox-width: 28;
        viewbox-height: 28;
    }
    Rectangle {
        x: 12.2px;
        y: 13.6px;
        width: 1.2px;
        height: 4.6px;
        border-radius: 0.6px;
        background: root.tint;
        opacity: 0.75;
    }
    Rectangle {
        x: 14.8px;
        y: 13.6px;
        width: 1.2px;
        height: 4.6px;
        border-radius: 0.6px;
        background: root.tint;
        opacity: 0.75;
    }
}

// "⋮" — three drawn dots.
component IconMore inherits Rectangle {
    in property <color> tint: #9A9A9A;
    width: 28px;
    height: 28px;
    Rectangle { x: 12.3px; y: 6.9px; width: 3.4px; height: 3.4px; border-radius: 1.7px; background: root.tint; }
    Rectangle { x: 12.3px; y: 12.3px; width: 3.4px; height: 3.4px; border-radius: 1.7px; background: root.tint; }
    Rectangle { x: 12.3px; y: 17.7px; width: 3.4px; height: 3.4px; border-radius: 1.7px; background: root.tint; }
}

// Hamburger (☰) — three drawn bars. Collapse / expand the sidebar exactly like
// the old chevron, but it reads as a menu affordance at touch sizes and never
// rotates (a rotating glyph looked like a spinner mid-animation).
component IconMenuBars inherits Rectangle {
    in property <color> tint: #9A9A9A;
    width: 28px;
    height: 28px;
    Rectangle { x: 7px; y: 8.9px; width: 14px; height: 1.8px; border-radius: 0.9px; background: root.tint; }
    Rectangle { x: 7px; y: 13.1px; width: 14px; height: 1.8px; border-radius: 0.9px; background: root.tint; }
    Rectangle { x: 7px; y: 17.3px; width: 14px; height: 1.8px; border-radius: 0.9px; background: root.tint; }
}

// "Download" — arrow into a tray (row menu).
component IconDownload inherits Rectangle {
    in property <color> tint: #B9B9B9;
    width: 28px;
    height: 28px;
    Rectangle {
        x: 13.35px;
        y: 7.4px;
        width: 1.4px;
        height: 7.2px;
        border-radius: 0.7px;
        background: root.tint;
    }
    Path {
        commands: "M 10.7 11.6 L 14.05 15 L 17.4 11.6";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        viewbox-width: 28;
        viewbox-height: 28;
    }
    Path {
        commands: "M 9.4 18.6 L 9.4 20.6 L 18.6 20.6 L 18.6 18.6";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        viewbox-width: 28;
        viewbox-height: 28;
    }
}

// Play triangle / pause bars (28px canvases dropped into the 32px circle).
component IconPlay inherits Rectangle {
    in property <color> tint: #E6E6E6;
    width: 28px;
    height: 28px;
    Path {
        commands: "M 11 8.2 L 11 19.8 L 19.6 14 Z";
        fill: root.tint;
        viewbox-width: 28;
        viewbox-height: 28;
    }
}
component IconPause inherits Rectangle {
    in property <color> tint: #000000;
    width: 28px;
    height: 28px;
    Rectangle { x: 10.2px; y: 8.2px; width: 2.8px; height: 11.6px; border-radius: 1.4px; background: root.tint; }
    Rectangle { x: 15px; y: 8.2px; width: 2.8px; height: 11.6px; border-radius: 1.4px; background: root.tint; }
}

// Row action button: 40x40 hit target (touch-friendly — a 28px plate alone is
// below the 44px fingertip rule once the row is scaled), plate + drawn glyph,
// hover / press / active states with quick consistent animations.
// kind: 0 = copy (flips to a green tick while "copied"), 1 = delete, 2 = ⋮.
component HistButton inherits Rectangle {
    in property <int> kind: 0;
    in property <bool> copied: false;
    in property <bool> active: false;
    in property <color> rest-plate: #131313;
    in property <color> hover-plate: #232323;
    in property <color> rest-tint: #9A9A9A;
    in property <color> hover-tint: #FFFFFF;
    callback clicked();

    width: 40px;
    height: 40px;

    // The plate shrinks slightly while pressed — instant tactile feedback.
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: bt.pressed ? 30px : 34px;
        height: bt.pressed ? 30px : 34px;
        border-radius: 10px;
        background: root.copied ? #14301F : ((bt.has-hover || root.active) ? root.hover-plate : root.rest-plate);
        animate background { duration: 130ms; easing: ease-out; }
        animate width { duration: 90ms; easing: ease-out; }
        animate height { duration: 90ms; easing: ease-out; }
    }

    IconCopy {
        x: 6px;
        y: 6px;
        visible: root.kind == 0 && !root.copied;
        tint: (bt.has-hover || root.active) ? root.hover-tint : root.rest-tint;
        sheet-bg: root.copied ? #14301F : ((bt.has-hover || root.active) ? root.hover-plate : root.rest-plate);
    }
    IconCheck { x: 6px; y: 6px; visible: root.kind == 0 && root.copied; }
    IconTrash {
        x: 6px;
        y: 6px;
        visible: root.kind == 1;
        tint: (bt.has-hover || root.active) ? root.hover-tint : root.rest-tint;
    }
    IconMore {
        x: 6px;
        y: 6px;
        visible: root.kind == 2;
        tint: (bt.has-hover || root.active) ? root.hover-tint : root.rest-tint;
    }

    bt := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// Menu entry (34px): same drawn glyphs + label. kind: 0 = copy/✓,
// 1 = download, 2 = delete (danger red).
component HistMenuItem inherits Rectangle {
    in property <int> kind: 0;
    in property <bool> copied: false;
    in property <bool> danger: false;
    in property <string> label: "";
    callback clicked();

    height: 44px;
    border-radius: 8px;
    background: hit.has-hover ? (root.danger ? #2A1414 : #242424) : transparent;
    animate background { duration: 110ms; easing: ease-out; }

    IconCopy { x: 8px; y: 8px; visible: root.kind == 0 && !root.copied; tint: root.danger ? #FF8A8A : #B9B9B9; sheet-bg: hit.has-hover ? (root.danger ? #2A1414 : #242424) : #171717; }
    IconCheck { x: 8px; y: 8px; visible: root.kind == 0 && root.copied; }
    IconDownload { x: 8px; y: 8px; visible: root.kind == 1; }
    IconTrash { x: 8px; y: 8px; visible: root.kind == 2; tint: #FF8A8A; }

    Text {
        x: 46px;
        y: 0px;
        width: parent.width - 56px;
        height: parent.height;
        text: root.label;
        font-size: 13.5px;
        color: root.danger ? #FF9A9A : #E8E8E8;
        vertical-alignment: center;
        overflow: elide;
    }

    hit := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// Modern Dark Theme QuickSTT Control Center Dashboard
// Rendered via DirectWrite / Direct2D / D3D11 on Windows, fully native Slint.

export component DashboardWidget inherits Window {
    title: "QuickSTT Control Center";
    preferred-width: 940px;
    preferred-height: 700px;
    // Small windows must stay usable: the layout reflows (sidebar → icon rail)
    // instead of being laid out wider than the window and clipped.
    min-width: 520px;
    min-height: 400px;
    background: #000000;

    in-out property <int> active-tab: 0;

    // Adaptive rail: below ~820 logical px the sidebar collapses to its icon
    // rail so the content column keeps a usable width. Set from Rust on a
    // timer — a root.width binding here would feed back into the window's
    // preferred size (Slint reports that as a binding loop).
    in-out property <bool> rail-mode: false;
    // What the sidebar actually shows: the icon rail when the user collapsed
    // it OR when the window is too narrow for the full panel.
    out property <bool> rail-active: root.sidebar-collapsed || root.rail-mode;
    // Minimum fingertip target. Touchscreen-first on Android, and touch-capable
    // Windows/Linux convertibles get the same hit areas.
    out property <length> tap-size: 44px;

    // Model & Language State
    in property <[string]> models: ["Vosk Small EN (50M)", "NVIDIA Parakeet TDT 0.6B", "Nemotron 3.5 Streaming", "Vosk Large EN (US)", "Vosk Small Indian EN", "Vosk Small German"];
    in property <int> selected-model: 0;
    in property <[string]> languages: ["Auto", "English", "German"];
    in property <int> selected-language: 0;
    in property <string> models-info: "Local, ultra-fast neural speech recognition. Runs 100% offline.";

    // Download & Progress Bar
    in property <bool> is-downloading: false;
    in property <int> download-progress: 0;
    in property <string> download-status: "";
    in property <string> download-speed: "";
    in property <string> download-bytes: "";
    in property <string> download-file: "";

    // Style Properties
    in property <int> ui-opacity: 100;
    in property <int> ui-pill-radius: 25;
    in property <bool> show-waveform: true;
    in property <int> waveform-sensitivity: 5;
    in property <int> tray-icon-size: 32;

    // Wakeword & VAD Properties
    in property <bool> wakeword-enabled: false;
    in property <int> wakeword-sensitivity: 50;
    // Exact enforced trigger rule, pushed from Rust (threshold × 3 hits).
    in property <string> wakeword-threshold-text: "";
    in property <int> vad-sensitivity: 50;
    in property <int> live-audio-level: 0;
    in property <bool> ww-hey-jarvis: true;
    in property <bool> ww-jarvis: true;
    in property <bool> ww-alexa: true;
    in property <bool> ww-agent: true;
    in property <bool> ww-hem: true;
    // Clap action (0 = Start Dictation, 1 = Stop Dictation, 2 = Disabled).
    // Active (Start) out of the box.
    in property <int> transient-action: 0;

    // General & System Settings
    in property <bool> start-with-windows: false;
    in property <bool> start-minimized: true;
    in property <bool> lrc-enabled: true;
    in property <bool> auto-stop-silence: false;
    in property <int> silence-duration: 8;
    in property <bool> auto-offload: true;
    in property <int> offload-seconds: 15;
    in property <bool> ctrl-space-enabled: true;
    in property <int> ctrl-space-mode: 0;
    in property <int> ctrl-space-output: 0;
    // Disfluency cleanup toggle (non-streaming utterance text only).
    in property <bool> clean-disfluencies: true;
    // Cleanup engine: 0 = FDT 66M tagger, 1 = S1-mini INT4 0.6B normalizer,
    // 2 = SmolLM2 360M Q4 (llama.cpp), 3 = Gemma 3 270M Q4 (llama.cpp).
    in property <int> disfluency-engine: 0;

    // Sidebar: collapsible to icons via the chevron, drag-resizable 150-280px.
    in-out property <bool> sidebar-collapsed: false;
    in-out property <int> sidebar-width: 200;
    // Width at the moment a sidebar drag started (absolute math: a moving
    // pointer must never accumulate deltas onto an already-updated width).
    in-out property <int> sidebar-drag-start: 200;
    // "Copied to clipboard" toast: Rust flips this; the root-level overlay
    // animates its opacity + rise, then Rust flips it back after ~2.5s.
    in-out property <bool> history-toast-show: false;
    // History backup: ON stores every finished turn (text + audio) in the
    // dashboard history; OFF stops new recordings (existing rows stay).
    in-out property <bool> history-enabled: true;
    // True while the user drags the sidebar edge (cursor + no re-layout jitter).
    in-out property <bool> sidebar-dragging: false;

    // Dashboard history (newest first). Rows carry pre-formatted labels.
    in property <[HistRow]> history-items: [];
    // Row whose ⋮ menu is open (-1 = none). Set by Rust (single source of
    // truth) and mirrored by the UI for instant open/close feedback.
    in-out property <int> history-menu-idx: -1;
    // Row currently playing (-1 = none), for the play/pause icon.
    in-out property <int> history-play-idx: -1;
    // Floating row menu: anchor in window coordinates (bottom-right corner of
    // the ⋮ button, set by the row) + one-shot rise/fade flag flipped by a 1ms
    // timer the moment the menu opens.
    property <length> hist-menu-x: 0px;
    property <length> hist-menu-y: 0px;
    property <bool> hist-menu-grown: false;
    in property <string> recording-dir: "C:\\Users\\hemsh_sfya5gq\\Recordings";
    in property <string> app-version: "2.0.0-alpha.18 (Rust & Slint Edition)";

    // Callbacks
    callback select-model(string);
    callback select-language(string);
    callback set-wakeword-enabled(bool);
    callback set-wakeword-sensitivity(int);
    callback set-vad-sensitivity(int);
    callback set-ui-opacity(int);
    callback set-ui-pill-radius(int);
    callback set-start-with-windows(bool);
    callback set-start-minimized(bool);
    callback set-lrc-enabled(bool);
    callback set-auto-stop-silence(bool);
    callback set-silence-duration(int);
    callback set-auto-offload(bool);
    callback set-offload-seconds(int);
    callback set-ctrl-space-enabled(bool);
    callback set-ctrl-space-mode(int);
    callback set-ctrl-space-output(int);
    callback set-clean-disfluencies(bool);
    callback set-disfluency-engine(int);
    callback set-sidebar-width(length);
    callback set-sidebar-collapsed(bool);
    // History backup toggle (top of the General tab's history card).
    callback set-history-enabled(bool);
    // History row actions (index into history-items).
    callback history-play(int);
    callback history-seek(int, float);
    callback history-copy(int);
    callback history-delete(int);
    callback history-download(int);
    callback history-menu(int, bool);
    callback set-show-waveform(bool);
    callback set-waveform-sensitivity(int);
    callback set-tray-icon-size(int);
    callback toggle-wakeword-phrase(string, bool);
    callback set-transient-action(int);
    callback download-catalog-model(int);
    callback uninstall-catalog-model(int);
    callback select-catalog-model(int);
    callback use-recommended-model();
    callback set-catalog-search(string);
    callback set-catalog-lang-filter(string);
    callback browse-recording-dir();
    callback check-updates();
    callback close-dashboard();

    // Hardware-aware catalog (dynamic cards, image-inspired)
    in property <[ModelCard]> catalog: [];
    in property <[string]> catalog-langs: ["All Languages"];
    in property <int> catalog-lang-idx: 0;
    in property <string> catalog-search: "";
    in property <string> recommend-name: "";
    in property <string> recommend-reason: "";
    in property <string> hardware-info: "";

    // Monitor scale factor (1.0 = 96 dpi, 1.25 = 125%, …), set from Rust via
    // GetDpiForWindow. Slint's winit-software backend renders at this scale but
    // hands the layout the *physical* window size, so a plain layout overflows
    // the surface by the scale factor. Laying the whole UI out in DIP units
    // (physical / scale) makes the scaled render land exactly on the window.
    in-out property <float> ui-scale: 1.0;
    // Layout probes (read over IPC by DASHGEOM).
    out property <length> probe-root-w: root.width;
    out property <length> probe-box-w: layout-box.width;
    out property <length> probe-side-w: side-panel.width;

    // Borderless Window Dragging
    callback drag_start();
    callback drag_moved();
    callback drag_end();

    // Layout box: fills the window (Window.root width already arrives in DIP
    // units on this backend; the renderer scales it to the physical surface).
    layout-box := Rectangle {
        background: #000000;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;


        // ══════════════════════════════════════════════════════════════════════════
        // Main Body: Left Sidebar Navigation + Right Content Canvas
        // ══════════════════════════════════════════════════════════════════════════
        HorizontalLayout {
            spacing: 0px;

            // ── Left Navigation Sidebar ──
            // Collapsible (chevron → 56px icons-only) and drag-resizable
            // between 150px and 280px. Dragging is disabled while collapsed —
            // the collapsed rail is a fixed icon strip, so there is nothing to
            // drag and re-expanding should not jump the layout.
            side-panel := Rectangle {
                width: root.rail-active ? 56px : root.sidebar-width * 1px;
                background: #050505;
                border-width: 1px;
                border-color: #1A1A1A;

                VerticalLayout {
                    padding: root.rail-active ? 4px : 12px;
                    spacing: 6px;

                    // Collapse / expand — TOP RIGHT of the rail (the panel's
                    // title-bar control): right-aligned, always reachable and
                    // visible in both states, and it never shifts nav items.
                    // Drawn hamburger (☰), 44x40 touch target, no rotation.
                    HorizontalLayout {
                        alignment: end;
                        Rectangle {
                            width: root.tap-size;
                            height: 40px;
                            border-radius: 8px;
                            background: chev_touch.has-hover ? #1A1A1A : transparent;
                            border-width: chev_touch.has-hover ? 1px : 0px;
                            border-color: #262626;
                            IconMenuBars {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                tint: chev_touch.has-hover ? #FFFFFF : #9A9A9A;
                            }
                            chev_touch := TouchArea {
                                // Write the property directly for a 0 ms visual
                                // response (the callback alone only persisted the
                                // choice — the UI never followed along live).
                                clicked => {
                                    root.sidebar-collapsed = !root.sidebar-collapsed;
                                    root.set-sidebar-collapsed(root.sidebar-collapsed);
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }

                    // Navigation Item 0: General
                    Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: root.active-tab == 0 ? #1A1A1A : (tab0_touch.has-hover ? #0E0E0E : transparent);
                        border-width: root.active-tab == 0 ? 1px : 0px;
                        border-color: #FFFFFF;

                        HorizontalLayout {
                            padding-left: root.rail-active ? 0px : 12px;
                            spacing: root.rail-active ? 0px : 10px;
                            Text {
                                text: "⚙";
                                font-size: 15px;
                                color: root.active-tab == 0 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "General";
                                visible: !root.rail-active;

                                font-size: 13px;
                                font-weight: root.active-tab == 0 ? 700 : 500;
                                color: root.active-tab == 0 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                        }
                        tab0_touch := TouchArea {
                            clicked => { root.active-tab = 0; }
                            mouse-cursor: pointer;
                        }
                    }

                    // Navigation Item 1: Models
                    Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: root.active-tab == 1 ? #1A1A1A : (tab1_touch.has-hover ? #0E0E0E : transparent);
                        border-width: root.active-tab == 1 ? 1px : 0px;
                        border-color: #FFFFFF;

                        HorizontalLayout {
                            padding-left: root.rail-active ? 0px : 12px;
                            spacing: root.rail-active ? 0px : 10px;
                            Text {
                                text: "🎙";
                                font-size: 15px;
                                color: root.active-tab == 1 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Speech Models";
                                visible: !root.rail-active;

                                font-size: 13px;
                                font-weight: root.active-tab == 1 ? 700 : 500;
                                color: root.active-tab == 1 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                        }
                        tab1_touch := TouchArea {
                            clicked => { root.active-tab = 1; }
                            mouse-cursor: pointer;
                        }
                    }

                    // Navigation Item 2: Style
                    Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: root.active-tab == 2 ? #1A1A1A : (tab2_touch.has-hover ? #0E0E0E : transparent);
                        border-width: root.active-tab == 2 ? 1px : 0px;
                        border-color: #FFFFFF;

                        HorizontalLayout {
                            padding-left: root.rail-active ? 0px : 12px;
                            spacing: root.rail-active ? 0px : 10px;
                            Text {
                                text: "🎨";
                                font-size: 15px;
                                color: root.active-tab == 2 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Widget Style";
                                visible: !root.rail-active;

                                font-size: 13px;
                                font-weight: root.active-tab == 2 ? 700 : 500;
                                color: root.active-tab == 2 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                        }
                        tab2_touch := TouchArea {
                            clicked => { root.active-tab = 2; }
                            mouse-cursor: pointer;
                        }
                    }

                    // Navigation Item 3: Wakewords
                    Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: root.active-tab == 3 ? #1A1A1A : (tab3_touch.has-hover ? #0E0E0E : transparent);
                        border-width: root.active-tab == 3 ? 1px : 0px;
                        border-color: #FFFFFF;

                        HorizontalLayout {
                            padding-left: root.rail-active ? 0px : 12px;
                            spacing: root.rail-active ? 0px : 10px;
                            Text {
                                text: "👂";
                                font-size: 15px;
                                color: root.active-tab == 3 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Wake Words & VAD";
                                visible: !root.rail-active;

                                font-size: 13px;
                                font-weight: root.active-tab == 3 ? 700 : 500;
                                color: root.active-tab == 3 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                        }
                        tab3_touch := TouchArea {
                            clicked => { root.active-tab = 3; }
                            mouse-cursor: pointer;
                        }
                    }

                    // Navigation Item 4: System & Updates
                    Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: root.active-tab == 4 ? #1A1A1A : (tab4_touch.has-hover ? #0E0E0E : transparent);
                        border-width: root.active-tab == 4 ? 1px : 0px;
                        border-color: #FFFFFF;

                        HorizontalLayout {
                            padding-left: root.rail-active ? 0px : 12px;
                            spacing: root.rail-active ? 0px : 10px;
                            Text {
                                text: "🔄";
                                font-size: 15px;
                                color: root.active-tab == 4 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "System & Info";
                                visible: !root.rail-active;

                                font-size: 13px;
                                font-weight: root.active-tab == 4 ? 700 : 500;
                                color: root.active-tab == 4 ? #FFFFFF : #9A9A9A;
                                vertical-alignment: center;
                            }
                        }
                        tab4_touch := TouchArea {
                            clicked => { root.active-tab = 4; }
                            mouse-cursor: pointer;
                        }
                    }

                    // Spacer
                    Rectangle { }

                    // Status Pill at Bottom of Sidebar
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: #0E0E0E;
                        border-width: 1px;
                        border-color: #262626;
                        visible: !root.rail-active;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #FFFFFF;
                                y: 14px;
                            }
                            Text {
                                text: "Offline Ready";
                                font-size: 11px;
                                color: #9A9A9A;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Drag-to-resize handle on the right edge: 6px grab strip,
                // col-resize cursor, width clamped 150-280px and persisted.
                sidebar_drag := TouchArea {
                    x: parent.width - 6px;
                    width: 6px;
                    height: parent.height;
                    enabled: !root.rail-active;
                    mouse-cursor: col-resize;
                    // Anchor the width at press time, then follow the pointer
                    // ABSOLUTELY (start + total offset) — never accumulate.
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.sidebar-drag-start = root.sidebar-width;
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.sidebar-width = clamp(root.sidebar-drag-start + round((self.mouse-x - self.pressed-x) / 1px), 150, 280);
                            root.set-sidebar-width(root.sidebar-width * 1px);
                        }
                    }
                }
            }

            // ── Right Main Content Area ──
            Rectangle {
                background: #000000;

                ScrollView {
                    // Touch: drag anywhere on the page to pan (Windows/Linux
                    // touchscreens + precision touchpads), wheel still works.
                    mouse-drag-pan-enabled: true;
                    VerticalLayout {
                        alignment: start;

                        // ══════════════════════════════════════════════════════════════════
                        // TAB 0: GENERAL SETTINGS
                        // ══════════════════════════════════════════════════════════════════
                        if root.active-tab == 0 : VerticalLayout {
                        padding: 20px;
                        spacing: 16px;

                        Text {
                            text: "General Configuration";
                            font-size: 18px;
                            font-weight: 700;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Configure Windows integration, silence auto-commit, memory auto-offload, and recording output.";
                            font-size: 12px;
                            color: #9A9A9A;
                        }

                        // ── Transcript History (top of General) ──
                        // Every finished turn with its audio: a round play /
                        // pause control, a drag-to-seek timeline with the
                        // elapsed/total clock, the transcript, and a right-hand
                        // action cluster (copy with a green ✓ flash, delete,
                        // and ⋮ which opens a floating menu with copy /
                        // download / delete). Every glyph is DRAWN, so rows
                        // render identically on Windows and Linux, and every
                        // button answers hover/press with a short animation.
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Transcript History";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.history-items.length == 0 ? "" : root.history-items.length + " turns";
                                        font-size: 11px;
                                        color: #8E8E8E;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    // Backup toggle: OFF stops new turns from
                                    // being recorded (existing rows stay).
                                    CheckBox {
                                        height: 40px;
                                        text: root.rail-mode ? "Back up" : "Back up new turns";
                                        checked: root.history-enabled;
                                        toggled => { root.set-history-enabled(self.checked); }
                                    }
                                }

                                if root.history-items.length == 0 : Text {
                                    text: "No transcriptions yet. Hold Ctrl+Space and speak — every finished turn lands here with its audio.";
                                    font-size: 12px;
                                    color: #9A9A9A;
                                    wrap: word-wrap;
                                }

                                for item[i] in root.history-items : Rectangle {
                                    background: card_touch.has-hover ? #101010 : #0A0A0A;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: card_touch.has-hover ? #2A2A2A : #1C1C1C;
                                    animate background { duration: 150ms; easing: ease-out; }
                                    animate border-color { duration: 150ms; easing: ease-out; }

                                    // Whole-card hover feedback. Declared first so
                                    // every control below stays on top of it.
                                    card_touch := TouchArea {
                                        mouse-cursor: default;
                                    }

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 9px;

                                        // ── Line 1: play · when ───────── actions ──
                                        HorizontalLayout {
                                            spacing: 9px;

                                            // Play / pause — the primary control.
                                            // 44x44 fingertip target with a 36px
                                            // visual circle (was 32x32).
                                            Rectangle {
                                                width: root.tap-size;
                                                height: root.tap-size;
                                                opacity: item.has_audio ? 1.0 : 0.4;

                                                Rectangle {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    width: play_touch.pressed ? 31px : 36px;
                                                    height: play_touch.pressed ? 31px : 36px;
                                                    border-radius: 18px;
                                                    background: item.playing ? #FFFFFF : (play_touch.has-hover ? #202020 : #141414);
                                                    border-width: 1px;
                                                    border-color: item.playing ? #FFFFFF : (play_touch.has-hover ? #303030 : #202020);
                                                    animate background { duration: 130ms; easing: ease-out; }
                                                    animate border-color { duration: 130ms; easing: ease-out; }
                                                    animate width { duration: 90ms; easing: ease-out; }
                                                    animate height { duration: 90ms; easing: ease-out; }
                                                }
                                                IconPlay {
                                                    x: 8px;
                                                    y: 8px;
                                                    visible: !item.playing;
                                                    tint: play_touch.has-hover ? #FFFFFF : #E6E6E6;
                                                }
                                                IconPause {
                                                    x: 8px;
                                                    y: 8px;
                                                    visible: item.playing;
                                                }
                                                play_touch := TouchArea {
                                                    enabled: item.has_audio;
                                                    clicked => { root.history-play(i); }
                                                    mouse-cursor: item.has_audio ? pointer : default;
                                                }
                                            }

                                            Text {
                                                text: item.when;
                                                font-size: 11.5px;
                                                color: #8E8E8E;
                                                vertical-alignment: center;
                                            }

                                            Rectangle { horizontal-stretch: 1; }

                                            // Copy transcript — flips to a green ✓ for a beat.
                                            HistButton {
                                                kind: 0;
                                                copied: item.copied;
                                                clicked => { root.history-copy(i); }
                                            }

                                            // Delete turn (instant; the ⋮ menu repeats it).
                                            HistButton {
                                                kind: 1;
                                                rest-plate: #131313;
                                                hover-plate: #2A1414;
                                                rest-tint: #9A9A9A;
                                                hover-tint: #FF9A9A;
                                                clicked => { root.history-delete(i); }
                                            }

                                            // ⋮ — opens the floating action menu.
                                            more_btn := HistButton {
                                                kind: 2;
                                                active: root.history-menu-idx == i;
                                                clicked => {
                                                    if (root.history-menu-idx == i) {
                                                        root.history-menu(i, false);
                                                        root.history-menu-idx = -1;
                                                    } else {
                                                        root.hist-menu-x = more_btn.absolute-position.x + more_btn.width;
                                                        root.hist-menu-y = more_btn.absolute-position.y + more_btn.height + 6px;
                                                        root.hist-menu-grown = false;
                                                        root.history-menu-idx = i;
                                                        root.history-menu(i, true);
                                                    }
                                                }
                                            }
                                        }

                                        // ── Lines 2 & 3: transcript + timeline ──
                                        VerticalLayout {
                                            padding-left: 53px;
                                            spacing: 9px;

                                            Text {
                                                text: item.text;
                                                font-size: 12.5px;
                                                color: #EDEDED;
                                                wrap: word-wrap;
                                            }

                                            HorizontalLayout {
                                                spacing: 10px;

                                                // Drag-to-seek timeline: 20px grab area,
                                                // 4px track that thickens on hover with a
                                                // round handle; the played part is white.
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                    height: 34px;

                                                    Rectangle {
                                                        y: (parent.height - self.height) / 2;
                                                        width: parent.width;
                                                        height: seek_touch.has-hover || item.playing ? 6px : 4px;
                                                        border-radius: seek_touch.has-hover || item.playing ? 3px : 2px;
                                                        background: #242424;
                                                        animate height { duration: 120ms; easing: ease-out; }
                                                        animate border-radius { duration: 120ms; easing: ease-out; }

                                                        Rectangle {
                                                            width: parent.width * item.progress;
                                                            height: parent.height;
                                                            border-radius: parent.border-radius;
                                                            background: #FFFFFF;
                                                        }

                                                        Rectangle {
                                                            x: clamp(parent.width * item.progress - 7px, 0px, parent.width - 14px);
                                                            y: (parent.height - self.height) / 2;
                                                            width: 14px;
                                                            height: 14px;
                                                            border-radius: 7px;
                                                            background: #FFFFFF;
                                                            visible: item.has_audio && (item.progress > 0.001 || item.playing);
                                                            opacity: seek_touch.has-hover || item.playing ? 1.0 : 0.0;
                                                            animate opacity { duration: 120ms; easing: ease-out; }
                                                        }
                                                    }
                                                    seek_touch := TouchArea {
                                                        enabled: item.has_audio;
                                                        clicked => { root.history-seek(i, clamp(self.mouse-x / self.width, 0.0, 1.0)); }
                                                        moved => {
                                                            if (self.pressed) {
                                                                root.history-seek(i, clamp(self.mouse-x / self.width, 0.0, 1.0));
                                                            }
                                                        }
                                                        mouse-cursor: item.has_audio ? pointer : default;
                                                    }
                                                }

                                                // Elapsed / total clock, right of the bar.
                                                Text {
                                                    text: item.playing ? (item.pos + " / " + item.dur) : item.dur;
                                                    font-size: 11px;
                                                    color: item.playing ? #FFFFFF : #8E8E8E;
                                                    vertical-alignment: center;
                                                    min-width: 84px;
                                                    horizontal-alignment: right;
                                                    animate color { duration: 150ms; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Group 1: Startup & Behavior Card
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "System Startup & Behavior"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                CheckBox {
                                    height: 40px;
                                    text: "Start with Windows on logon";
                                    checked: root.start-with-windows;
                                    toggled => { root.set-start-with-windows(self.checked); }
                                }
                                CheckBox {
                                    height: 40px;
                                    text: "Start minimized to system tray";
                                    checked: root.start-minimized;
                                    toggled => { root.set-start-minimized(self.checked); }
                                }
                                CheckBox {
                                    height: 40px;
                                    text: "Export synchronized .lrc (lyrics/timestamp) files with recordings";
                                    checked: root.lrc-enabled;
                                    toggled => { root.set-lrc-enabled(self.checked); }
                                }
                            }
                        }

                        // Group 2: Silence Detection Auto-Stop
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "Inactivity & Silence Auto-Stop"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                CheckBox {
                                    height: 40px;
                                    text: "Automatically stop and commit transcription when silence is detected";
                                    checked: root.auto-stop-silence;
                                    toggled => { root.set-auto-stop-silence(self.checked); }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "Silence threshold duration:";
                                        font-size: 13px;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                        min-width: 180px;
                                    }
                                    Slider {
                                        height: 34px;
                                        minimum: 1;
                                        maximum: 60;
                                        value: root.silence-duration;
                                        enabled: root.auto-stop-silence;
                                        changed(val) => { root.set-silence-duration(val); }
                                    }
                                    Text {
                                        text: root.silence-duration + " sec";
                                        font-size: 13px;
                                        color: #FFFFFF;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        min-width: 55px;
                                    }
                                }
                            }
                        }

                        // Group 3: Memory Auto-Offload
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "Memory Management & Model Offloading"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                CheckBox {
                                    height: 40px;
                                    text: "Auto-offload speech model when idle (saves RAM)";
                                    checked: root.auto-offload;
                                    toggled => { root.set-auto-offload(self.checked); }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "Offload model after inactivity:";
                                        font-size: 13px;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                        min-width: 180px;
                                    }
                                    Slider {
                                        height: 34px;
                                        minimum: 5;
                                        maximum: 180;
                                        value: root.offload-seconds;
                                        enabled: root.auto-offload;
                                        changed(val) => { root.set-offload-seconds(val); }
                                    }
                                    Text {
                                        text: root.offload-seconds + " sec";
                                        font-size: 13px;
                                        color: #FFFFFF;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        min-width: 55px;
                                    }
                                }
                            }
                        }

                        // Group 4: Quick Transcription (Ctrl+Space)
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "Quick Transcription Hotkey (Ctrl+Space)"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                CheckBox {
                                    height: 40px;
                                    text: "Enable global Ctrl+Space dictation overlay";
                                    checked: root.ctrl-space-enabled;
                                    toggled => { root.set-ctrl-space-enabled(self.checked); }
                                }

                                // Stacked (not side-by-side): at 860px the two
                                // combos + labels overflow the ~620px content
                                // and the right column clips. VerticalLayout
                                // scales cleanly down to the 720px min-width.
                                VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Trigger Mode:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 110px; }
                                        ComboBox {
                                            height: 40px;
                                            model: ["Push-to-Talk (Hold)", "Toggle (Press on/off)"];
                                            current-index: root.ctrl-space-mode;
                                            selected(v) => { root.set-ctrl-space-mode(self.current-index); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Output Target:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 110px; }
                                        ComboBox {
                                            height: 40px;
                                            model: ["Type into active app", "Copy to clipboard", "Show only"];
                                            current-index: root.ctrl-space-output;
                                            selected(v) => { root.set-ctrl-space-output(self.current-index); }
                                        }
                                    }
                                }

                                CheckBox {
                                    height: 40px;
                                    text: "Clean disfluencies (um, uh, repeats) from non-streaming transcripts";
                                    checked: root.clean-disfluencies;
                                    toggled => { root.set-clean-disfluencies(self.checked); }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "Cleanup model:";
                                        font-size: 13px;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                        min-width: 110px;
                                    }
                                    ComboBox {
                                        height: 40px;
                                        model: ["FDT 66M tagger - fillers + repeats only (66MB)", "S1-mini INT4 (0.6B) - self-corrections + numbers (375MB, slow)", "SmolLM2 360M Q4 - self-corrections + numbers (271MB, fast)", "Gemma 3 270M Q4 - self-corrections + numbers (253MB, fast)"];
                                        current-index: root.disfluency-engine;
                                        enabled: root.clean-disfluencies;
                                        selected(v) => { root.set-disfluency-engine(self.current-index); }
                                    }
                                }
                                Text {
                                    text: "FDT is an instant deletion-only tagger. The three normalizer engines also resolve self-corrections (\"no wait, thursday\") and write spoken numbers, dates and times in written form: S1-mini (0.6B, highest quality, slowest), SmolLM2 360M and Gemma 3 270M (llama.cpp, fast). Weights download on first use; the model loads only for the turn being cleaned, off the UI thread, and is dropped immediately after.";
                                    font-size: 11px;
                                    color: #9A9A9A;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ══════════════════════════════════════════════════════════════════
                    // TAB 1: SPEECH MODELS & DOWNLOAD PROGRESS
                    // ══════════════════════════════════════════════════════════════════
                    if root.active-tab == 1 : VerticalLayout {
                        padding: 20px;
                        spacing: 16px;

                        Text {
                            text: "Speech Recognition Models";
                            font-size: 18px;
                            font-weight: 700;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Select your active transcription engine or download additional neural acoustic models.";
                            font-size: 12px;
                            color: #9A9A9A;
                        }

                        // Dynamic Download Progress Bar Card (Shows whenever downloading)
                        if root.is-downloading || root.download-progress > 0 : Rectangle {
                            background: #141414;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #FFFFFF;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: root.download-status != "" ? root.download-status : "Downloading Speech Model…";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.download-progress + "%";
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                    }
                                }

                                // Throughput row: file • bytes • MB/s (Rust-preformatted).
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: root.download-file;
                                        font-size: 11px;
                                        color: #9A9A9A;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: (root.download-bytes != "" && root.download-speed != "") ? (root.download-bytes + " • " + root.download-speed) : root.download-bytes;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #9A9A9A;
                                        vertical-alignment: center;
                                    }
                                }

                                // Modern Progress Track
                                Rectangle {
                                    height: 8px;
                                    border-radius: 4px;
                                    background: #1A1A1A;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        height: 8px;
                                        width: (parent.width * root.download-progress / 100);
                                        border-radius: 4px;
                                        background: #FFFFFF;
                                    }
                                }
                            }
                        }

                        // Active Model & Language Selector Card
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                Text { text: "Active Recognition Engine"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Selected Model:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 110px; }
                                    ComboBox {
                                        height: 40px;
                                        model: root.models;
                                        current-index: root.selected-model;
                                        selected(v) => { root.select-model(v); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Active Language:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 110px; }
                                    ComboBox {
                                        height: 40px;
                                        model: root.languages;
                                        current-index: root.selected-language;
                                        selected(v) => { root.select-language(v); }
                                    }
                                }

                                Rectangle {
                                    background: #1A1A1A;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 10px;
                                        Text {
                                            text: root.models-info;
                                            font-size: 12px;
                                            color: #9A9A9A;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }

                        // Model Catalog Overview Card
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "Transcription Models"; font-size: 16px; font-weight: 700; color: #FFFFFF; }

                                Text {
                                    text: "Select a transcription model or download additional models. Different models offer varying levels of accuracy and speed. The list is filtered for your hardware — search or filter by language anytime.";
                                    font-size: 12px;
                                    color: #9A9A9A;
                                    wrap: word-wrap;
                                }

                                // ── Dynamic hardware-aware catalog (image-inspired) ──
                                // Search + language filter row
                                HorizontalLayout {
                                    spacing: 10px;
                                    LineEdit {
                                        height: 40px;
                                        text: root.catalog-search;
                                        placeholder-text: "Search models by name…";
                                        edited(t) => { root.set-catalog-search(t); }
                                    }
                                    ComboBox {
                                        height: 40px;
                                        model: root.catalog-langs;
                                        current-index: root.catalog-lang-idx;
                                        selected(v) => { root.set-catalog-lang-filter(v); }
                                    }
                                }

                                // Recommendation banner (smart algorithm)
                                if root.recommend-name != "": Rectangle {
                                    background: #1A1A1A;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: #FFFFFF;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: "Recommended:"; font-size: 12px; font-weight: 700; color: #FFFFFF; vertical-alignment: center; }
                                            Text { text: root.recommend-name; font-size: 13px; font-weight: 700; color: #FFFFFF; vertical-alignment: center; }
                                            Rectangle {
                                                width: 110px; height: 24px; border-radius: 12px; background: #FFFFFF;
                                                Text { text: "Use it"; font-size: 11px; font-weight: 700; color: #000000; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea {
                                                    x: 0px;
                                                    y: 0px;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    clicked => { root.use-recommended-model(); }
                                                    mouse-cursor: pointer;
                                                }
                                            }
                                        }
                                        Text { text: root.recommend-reason; font-size: 11px; color: #B0B0B0; wrap: word-wrap; }
                                        Text { text: root.hardware-info; font-size: 11px; color: #9A9A9A; wrap: word-wrap; }
                                    }
                                }

                                Text { text: "Downloaded Models"; font-size: 13px; font-weight: 700; color: #FFFFFF; }
                                for card in root.catalog: Rectangle {
                                    height: card.installed ? 96px : 0px;
                                    visible: card.installed;
                                    border-radius: 10px;
                                    background: card.is-active ? #1A1A1A : #1A1A1A;
                                    border-width: 1px;
                                    border-color: card.is-active ? #FFFFFF : #262626;
                                    // Card tap = select model. Declared FIRST so it
                                    // stays beneath the Delete button above.
                                    TouchArea {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width;
                                        height: parent.height;
                                        clicked => { root.select-catalog-model(card.index); }
                                        mouse-cursor: pointer;
                                    }
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: space-between;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: card.name; font-size: 13px; font-weight: 700; color: #FFFFFF; vertical-alignment: center; }
                                                if card.badge != "": Rectangle {
                                                    width: 96px; height: 22px; border-radius: 11px;
                                                    background: card.badge == "Legacy" ? #262626 : #FFFFFF;
                                                    Text { text: card.badge; font-size: 11px; font-weight: 700; color: #000000; horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: 12px;
                                                VerticalLayout {
                                                    spacing: 2px;
                                                    alignment: center;
                                                    Text { text: "accuracy"; font-size: 10px; color: #9A9A9A; }
                                                    Rectangle {
                                                        width: 90px; height: 6px; border-radius: 3px; background: #262626;
                                                        Rectangle { x: 0px; y: 0px; height: 6px; width: 90px * card.accuracy / 100; border-radius: 3px; background: #FFFFFF; }
                                                    }
                                                }
                                                VerticalLayout {
                                                    spacing: 2px;
                                                    alignment: center;
                                                    Text { text: "speed"; font-size: 10px; color: #9A9A9A; }
                                                    Rectangle {
                                                        width: 90px; height: 6px; border-radius: 3px; background: #262626;
                                                        Rectangle { x: 0px; y: 0px; height: 6px; width: 90px * card.speed / 100; border-radius: 3px; background: #FFFFFF; }
                                                    }
                                                }
                                            }
                                        }
                                        Text { text: card.blurb; font-size: 12px; color: #C9C9C9; }
                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text { text: card.langs; font-size: 11px; color: #9A9A9A; vertical-alignment: center; }
                                            // Explicit-size delete button: guaranteed hit area.
                                            Rectangle {
                                                width: 150px;
                                                height: 26px;
                                                border-radius: 6px;
                                                background: del_hover.has-hover ? #1A1A1A : transparent;
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 10px;
                                                    alignment: end;
                                                    Text { text: card.size; font-size: 11px; color: #9A9A9A; vertical-alignment: center; }
                                                    Text { text: "Delete"; font-size: 11px; font-weight: 700; color: #FFFFFF; vertical-alignment: center; }
                                                }
                                                del_hover := TouchArea {
                                                    x: 0px;
                                                    y: 0px;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    clicked => { root.uninstall-catalog-model(card.index); }
                                                    mouse-cursor: pointer;
                                                }
                                            }
                                        }
                                    }
                                }
                                Text { text: "Available to Download"; font-size: 13px; font-weight: 700; color: #FFFFFF; }
                                for card in root.catalog: Rectangle {
                                    height: !card.installed ? 96px : 0px;
                                    visible: !card.installed;
                                    border-radius: 10px;
                                    background: #1A1A1A;
                                    border-width: 1px;
                                    border-color: #262626;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: space-between;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: card.name; font-size: 13px; font-weight: 700; color: #FFFFFF; vertical-alignment: center; }
                                                if card.badge != "": Rectangle {
                                                    width: 110px; height: 22px; border-radius: 11px; background: #FFFFFF;
                                                    Text { text: card.badge; font-size: 11px; font-weight: 700; color: #000000; horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: 12px;
                                                VerticalLayout {
                                                    spacing: 2px;
                                                    alignment: center;
                                                    Text { text: "accuracy"; font-size: 10px; color: #9A9A9A; }
                                                    Rectangle {
                                                        width: 90px; height: 6px; border-radius: 3px; background: #262626;
                                                        Rectangle { x: 0px; y: 0px; height: 6px; width: 90px * card.accuracy / 100; border-radius: 3px; background: #FFFFFF; }
                                                    }
                                                }
                                                VerticalLayout {
                                                    spacing: 2px;
                                                    alignment: center;
                                                    Text { text: "speed"; font-size: 10px; color: #9A9A9A; }
                                                    Rectangle {
                                                        width: 90px; height: 6px; border-radius: 3px; background: #262626;
                                                        Rectangle { x: 0px; y: 0px; height: 6px; width: 90px * card.speed / 100; border-radius: 3px; background: #FFFFFF; }
                                                    }
                                                }
                                            }
                                        }
                                        Text { text: card.blurb; font-size: 12px; color: #C9C9C9; }
                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text { text: card.langs; font-size: 11px; color: #9A9A9A; vertical-alignment: center; }
                                            // Explicit-size download button: guaranteed hit area
                                            // (bare TouchAreas in layouts can collapse to 0×0).
                                            dl_btn := Rectangle {
                                                width: 170px;
                                                height: 26px;
                                                border-radius: 6px;
                                                background: dl_hover.has-hover ? #222222 : transparent;
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 6px;
                                                    alignment: end;
                                                    Text { text: "⬇"; font-size: 11px; color: #9A9A9A; vertical-alignment: center; }
                                                    Text { text: card.size; font-size: 11px; color: #9A9A9A; vertical-alignment: center; }
                                                    if card.downloading: Text {
                                                        text: root.download-progress + "%";
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: #FFFFFF;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                dl_hover := TouchArea {
                                                    x: 0px;
                                                    y: 0px;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    clicked => { if (!card.downloading) { root.download-catalog-model(card.index); } }
                                                    mouse-cursor: pointer;
                                                }
                                            }
                                        }
                                    }
                                }

                            }
                        }
                    }

                    // ══════════════════════════════════════════════════════════════════
                    // TAB 2: WIDGET STYLE & LIVE PILL PREVIEW
                    // ══════════════════════════════════════════════════════════════════
                    if root.active-tab == 2 : VerticalLayout {
                        padding: 20px;
                        spacing: 16px;

                        Text {
                            text: "Widget Styling & Customization";
                            font-size: 18px;
                            font-weight: 700;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Customize the appearance of the floating mini pill widget. Sliders apply immediately with live preview.";
                            font-size: 12px;
                            color: #9A9A9A;
                        }

                        // Interactive Live Preview Box
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "Live Mini Pill Preview"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                Rectangle {
                                    height: 90px;
                                    background: #000000;
                                    border-radius: 8px;

                                    HorizontalLayout {
                                        alignment: center;

                                        // Rendered Pill mirroring radius + opacity
                                        Rectangle {
                                            width: 250px;
                                            height: 48px;
                                            border-radius: (root.ui-pill-radius * 48px / 50);
                                            background: #111111;
                                            border-width: 1px;
                                            border-color: #FFFFFF;
                                            opacity: root.ui-opacity / 100.0;
                                            y: 21px;

                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                spacing: 10px;
                                                alignment: space-between;

                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: start;
                                                    Rectangle {
                                                        width: 10px;
                                                        height: 10px;
                                                        border-radius: 5px;
                                                        background: #FFFFFF;
                                                        y: 18px;
                                                    }
                                                    Text {
                                                        text: "QuickSTT";
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        color: #FFFFFF;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                Text {
                                                    text: "Dictate Ctrl+Win";
                                                    font-size: 12px;
                                                    color: #9A9A9A;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Sliders & Adjustments Card
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                Text { text: "Dimensions & Opacity"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Widget Opacity:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 160px; }
                                    Slider {
                                        height: 34px;
                                        minimum: 20;
                                        maximum: 100;
                                        value: root.ui-opacity;
                                        changed(val) => { root.set-ui-opacity(val); }
                                    }
                                    Text { text: root.ui-opacity + "%"; font-size: 13px; color: #FFFFFF; font-weight: 600; vertical-alignment: center; min-width: 50px; }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Corner Roundness:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 160px; }
                                    Slider {
                                        height: 34px;
                                        minimum: 0;
                                        maximum: 25;
                                        value: root.ui-pill-radius;
                                        changed(val) => { root.set-ui-pill-radius(val); }
                                    }
                                    Text { text: root.ui-pill-radius + " px"; font-size: 13px; color: #FFFFFF; font-weight: 600; vertical-alignment: center; min-width: 50px; }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "System Tray Icon Size:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 160px; }
                                    Slider {
                                        height: 34px;
                                        minimum: 16;
                                        maximum: 64;
                                        value: root.tray-icon-size;
                                        changed(val) => { root.set-tray-icon-size(val); }
                                    }
                                    Text { text: root.tray-icon-size + " px"; font-size: 13px; color: #FFFFFF; font-weight: 600; vertical-alignment: center; min-width: 50px; }
                                }

                                CheckBox {
                                    height: 40px;
                                    text: "Show animated waveform when actively listening";
                                    checked: root.show-waveform;
                                    toggled => { root.set-show-waveform(self.checked); }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Waveform Sensitivity:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 160px; }
                                    Slider {
                                        height: 34px;
                                        minimum: 1;
                                        maximum: 15;
                                        value: root.waveform-sensitivity;
                                        enabled: root.show-waveform;
                                        changed(val) => { root.set-waveform-sensitivity(val); }
                                    }
                                    Text { text: root.waveform-sensitivity + ""; font-size: 13px; color: #FFFFFF; font-weight: 600; vertical-alignment: center; min-width: 50px; }
                                }
                            }
                        }
                    }

                    // ══════════════════════════════════════════════════════════════════
                    // TAB 3: WAKEWORDS, VAD & SENSITIVITY
                    // ══════════════════════════════════════════════════════════════════
                    if root.active-tab == 3 : VerticalLayout {
                        padding: 20px;
                        spacing: 16px;

                        Text {
                            text: "Wakewords & Voice Activity Detection";
                            font-size: 18px;
                            font-weight: 700;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Hands-free voice triggers. Calibrated sensitivity and strict noise gates prevent false activations from room noise and TV audio.";
                            font-size: 12px;
                            color: #9A9A9A;
                        }

                        // Master Activation Switch
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        Text { text: "Hands-Free Wakeword Detection"; font-size: 14px; font-weight: 600; color: #FFFFFF; }
                                        Text { text: "When enabled, QuickSTT listens for wake phrases in the background (< 1 MB RAM)."; font-size: 11px; color: #9A9A9A; }
                                    }
                                    CheckBox {
                                        height: 40px;
                                        text: "Active";
                                        checked: root.wakeword-enabled;
                                        toggled => { root.set-wakeword-enabled(self.checked); }
                                    }
                                }
                            }
                        }

                        // Calibrated Sensitivity Sliders
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                Text { text: "Sensitivity & Noise Gate Tuning"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                Text { text: root.wakeword-threshold-text; font-size: 11px; color: #9A9A9A; wrap: word-wrap; }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Wakeword Sensitivity:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 170px; }
                                    Slider {
                                        height: 34px;
                                        minimum: 0;
                                        maximum: 100;
                                        value: root.wakeword-sensitivity;
                                        changed(val) => { root.set-wakeword-sensitivity(val); }
                                    }
                                    Text {
                                        text: root.wakeword-sensitivity <= 30 ? (root.wakeword-sensitivity + "% (Strict)") : (root.wakeword-sensitivity >= 70 ? (root.wakeword-sensitivity + "% (Hot)") : (root.wakeword-sensitivity + "% (Balanced)"));
                                        font-size: 12px;
                                        color: #FFFFFF;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        min-width: 95px;
                                    }
                                }
                                Text {
                                    text: "Score bar for the phrases above — HIGHER (right) = triggers on quieter speech, LOWER (left) = needs louder, clearer speech. Too high answers TV and chatter; too low needs shouting. 50 is balanced.";
                                    font-size: 11px;
                                    color: #9A9A9A;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "VAD Speech Gate:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 170px; }
                                    Slider {
                                        height: 34px;
                                        minimum: 0;
                                        maximum: 100;
                                        value: root.vad-sensitivity;
                                        changed(val) => { root.set-vad-sensitivity(val); }
                                    }
                                    Text {
                                        text: root.vad-sensitivity <= 30 ? (root.vad-sensitivity + "% (Strict)") : (root.vad-sensitivity >= 70 ? (root.vad-sensitivity + "% (Open)") : (root.vad-sensitivity + "% (Balanced)"));
                                        font-size: 12px;
                                        color: #FFFFFF;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        min-width: 95px;
                                    }
                                }
                                Text {
                                    text: "Voice gate in front of the detector — HIGHER (right) = soft speech gets through, but so does more room noise. LOWER (left) = stricter; set too low, quiet phrases never reach the detector at all. Same direction as above: right = more sensitive. 50 is balanced.";
                                    font-size: 11px;
                                    color: #9A9A9A;
                                    wrap: word-wrap;
                                }

                                // Live Microphone Input Level Visualizer
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: "Microphone Audio Level:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; min-width: 170px; }
                                    Rectangle {
                                        height: 10px;
                                        border-radius: 5px;
                                        background: #1A1A1A;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 10px;
                                            width: (parent.width * root.live-audio-level / 100);
                                            border-radius: 5px;
                                            background: root.live-audio-level > 60 ? #DA3633 : (root.live-audio-level > 20 ? #FFFFFF : #FFFFFF);
                                        }
                                    }
                                    Text {
                                        text: root.live-audio-level + "%";
                                        font-size: 12px;
                                        color: #9A9A9A;
                                        vertical-alignment: center;
                                        min-width: 45px;
                                    }
                                }
                            }
                        }

                        // Enabled Wakewords List
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text { text: "Active Wakewords (community openWakeWord heads)"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                HorizontalLayout {
                                    spacing: 20px;
                                    CheckBox {
                                        height: 40px;
                                        text: "\"Hey Jarvis\"";
                                        checked: root.ww-hey-jarvis;
                                        toggled => { root.toggle-wakeword-phrase("hey jarvis", self.checked); }
                                    }
                                    CheckBox {
                                        height: 40px;
                                        text: "\"Alexa\"";
                                        checked: root.ww-alexa;
                                        toggled => { root.toggle-wakeword-phrase("alexa", self.checked); }
                                    }
                                }

                                Text {
                                    text: "Custom phrases (jarvis, agent, hem) are retired: their models answered ~0.5 to pure silence, so no threshold could ever separate them from nothing. They may return via retrained heads.";
                                    font-size: 11px;
                                    color: #9A9A9A;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Acoustic Sound Trigger (clap only — snap retired)
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "Acoustic Transient Trigger"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Clap Action:"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; }
                                    ComboBox {
                                        height: 40px;
                                        model: ["Start Dictation", "Stop Dictation", "Disabled"];
                                        current-index: root.transient-action;
                                        enabled: true;
                                        selected(v) => { root.set-transient-action(self.current-index); }
                                    }
                                }
                                Text {
                                    text: "One sharp hand clap triggers the action above. Isolated impulses only — speech and sustained noise are vetoed. Wakewords work independently.";
                                    font-size: 11px;
                                    color: #9A9A9A;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ══════════════════════════════════════════════════════════════════
                    // TAB 4: SYSTEM & UPDATES
                    // ══════════════════════════════════════════════════════════════════
                    if root.active-tab == 4 : VerticalLayout {
                        padding: 20px;
                        spacing: 16px;

                        Text {
                            text: "System Information & Updates";
                            font-size: 18px;
                            font-weight: 700;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Inspect active ML inference runtimes, build versions, and software update status.";
                            font-size: 12px;
                            color: #9A9A9A;
                        }

                        // System Runtime Status Card
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text { text: "Runtime Diagnostic Status"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Core Architecture:"; font-size: 13px; color: #9A9A9A; }
                                    Text { text: "Rust 64-bit (Tokio + Slint)"; font-size: 13px; font-weight: 600; color: #FFFFFF; }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Audio Driver:"; font-size: 13px; color: #9A9A9A; }
                                    Text { text: "WASAPI shared (cpal)"; font-size: 13px; font-weight: 600; color: #FFFFFF; }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Wakeword Engine:"; font-size: 13px; color: #9A9A9A; }
                                    Text { text: "ONNX Tract (2 heads)"; font-size: 13px; font-weight: 600; color: #FFFFFF; }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Speech Recognition:"; font-size: 13px; color: #9A9A9A; }
                                    Text { text: "Vosk Native & ONNX"; font-size: 13px; font-weight: 600; color: #FFFFFF; }
                                }
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Idle Memory Usage:"; font-size: 13px; color: #9A9A9A; }
                                    Text { text: "< 5 MB idle (auto-offload)"; font-size: 13px; font-weight: 600; color: #FFFFFF; }
                                }
                            }
                        }

                        // Version & Updates Card
                        Rectangle {
                            background: #0E0E0E;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #262626;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text { text: "Version & Software Updates"; font-size: 14px; font-weight: 600; color: #FFFFFF; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        Text { text: "QuickSTT Release:"; font-size: 13px; color: #FFFFFF; font-weight: 600; }
                                        Text { text: root.app-version; font-size: 12px; color: #9A9A9A; }
                                    }
                                    Rectangle {
                                        width: 140px;
                                        height: 32px;
                                        border-radius: 6px;
                                        background: #FFFFFF;
                                        y: 4px;
                                        Text {
                                            text: "Check Updates";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #000000;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea {
                                            clicked => { root.check-updates(); }
                                            mouse-cursor: pointer;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

    // ── "Copied" toast ──
    // Root-level overlay (declared before the ⋮ menu so the menu still paints
    // over it). Rust flips history-toast-show on copy and back off ~2.5 s
    // later; opacity + rise animate both ways for the fade in/out. No
    // TouchArea: it never intercepts clicks.
    Rectangle {
        x: (root.width - self.width) / 2;
        y: root.history-toast-show ? (root.height - 64px) : (root.height - 50px);
        width: 196px;
        height: 40px;
        border-radius: 10px;
        background: #161616;
        border-width: 1px;
        border-color: #2E2E2E;
        drop-shadow-blur: 18px;
        drop-shadow-color: #000000AA;
        drop-shadow-offset-y: 6px;
        opacity: root.history-toast-show ? 1.0 : 0.0;
        animate opacity { duration: 260ms; easing: ease-in-out; }
        animate y { duration: 260ms; easing: ease-out; }

        IconCheck { x: 10px; y: 6px; }

        Text {
            x: 44px;
            y: 0px;
            width: parent.width - 54px;
            height: parent.height;
            text: "Copied to clipboard";
            font-size: 12.5px;
            font-weight: 600;
            color: #EDEDED;
            vertical-alignment: center;
        }
    }

    // ── Floating history row menu (⋮) ──
    // A root-level overlay declared after the whole UI so it always paints on
    // top (Slint stacks in declaration order). Staying inside this window
    // means it can never be clipped by the history list nor flash a second OS
    // popup. Clicking anywhere outside dismisses; the card swallows its own
    // clicks. Height is fixed: header 24 + separators 2 + items 102 + spacing
    // 15 + padding 12 = 155px.
    if root.history-menu-idx >= 0 && root.history-menu-idx < root.history-items.length : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: transparent;

        // Flip the rise/fade flag one tick after opening so it animates.
        Timer {
            interval: 1ms;
            running: true;
            triggered => { root.hist-menu-grown = true; }
        }

        // Any click outside the card dismisses the menu (and syncs Rust).
        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => {
                root.history-menu(root.history-menu-idx, false);
                root.history-menu-idx = -1;
            }
            mouse-cursor: default;
        }

        // The card: right-aligned under the ⋮ button, clamped into the window.
        Rectangle {
            x: clamp(root.hist-menu-x - self.width, 10px, root.width - self.width - 10px);
            y: clamp(root.hist-menu-y + (root.hist-menu-grown ? 0px : 7px), 10px, root.height - self.height - 10px);
            width: 252px;
            height: 155px;
            opacity: root.hist-menu-grown ? 1.0 : 0.0;
            animate opacity { duration: 130ms; easing: ease-out; }

            background: #171717;
            border-radius: 12px;
            border-width: 1px;
            border-color: #2E2E2E;
            drop-shadow-color: #000000B8;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;

            // Swallow clicks on the card's own padding/header so they do not
            // reach the outside-click catcher (declared first = beneath the
            // menu items).
            TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                mouse-cursor: default;
            }

            VerticalLayout {
                padding: 6px;
                spacing: 3px;

                // Which turn this menu belongs to.
                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    Text {
                        height: 24px;
                        text: root.history-items[root.history-menu-idx].when + "   ·   " + root.history-items[root.history-menu-idx].dur;
                        font-size: 10.5px;
                        color: #7A7A7A;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Rectangle { height: 1px; horizontal-stretch: 1; background: #2A2A2A; }
                }

                HistMenuItem {
                    kind: 0;
                    copied: root.history-items[root.history-menu-idx].copied;
                    label: root.history-items[root.history-menu-idx].copied ? "Copied to clipboard" : "Copy transcript";
                    clicked => { root.history-copy(root.history-menu-idx); }
                }

                HistMenuItem {
                    kind: 1;
                    label: root.history-items[root.history-menu-idx].has_audio ? "Download audio + transcript" : "Download transcript";
                    clicked => {
                        root.history-download(root.history-menu-idx);
                        root.history-menu-idx = -1;
                    }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Rectangle { height: 1px; horizontal-stretch: 1; background: #2A2A2A; }
                }

                HistMenuItem {
                    kind: 2;
                    danger: true;
                    label: "Delete turn";
                    clicked => {
                        root.history-delete(root.history-menu-idx);
                        root.history-menu-idx = -1;
                    }
                }
            }
        }
    }
        }
}
