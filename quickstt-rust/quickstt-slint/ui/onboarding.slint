// ═══════════════════════════════════════════════════════════════════════════
//  First-run onboarding: five slides + a live animated demo of the app being
//  used (a "clip" rendered in place, so nothing external has to ship).
//
//  Design rules carried over from the rest of the UI:
//   * every glyph is DRAWN (paths / rectangles), never a font glyph — the
//     mic, the caret, the check, the arrows. Identical pixels everywhere.
//   * Skip is ALWAYS reachable: one click on the first slide finishes the
//     tour with the defaults, exactly like the rest of the setup.
//   * Nothing is persisted by the markup: Rust applies every choice through
//     the same orchestrator commands the dashboard uses, so onboarding picks
//     behave identically to dashboard picks (and survive the restart).
// ═══════════════════════════════════════════════════════════════════════════

import { Button, CheckBox, ComboBox } from "std-widgets.slint";

// Small round icon button (Back / Skip / Next footer + Skip top-right).
component PillButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 38px;
    min-width: 108px;
    border-radius: 10px;
    background: root.primary
        ? (hit.has-hover ? #E4E4E4 : #FFFFFF)
        : (hit.has-hover ? #242424 : #161616);
    border-width: 1px;
    border-color: root.primary ? #FFFFFF : (#303030);
    opacity: root.enabled ? 1.0 : 0.45;
    animate background { duration: 130ms; easing: ease-out; }
    animate border-color { duration: 130ms; easing: ease-out; }

    Text {
        text: root.label;
        font-size: 13px;
        font-weight: 700;
        color: root.primary ? #000000 : (root.danger ? #FF9A9A : #E6E6E6);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    hit := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }
}

// Progress dots: one per step, the current one stretches into a bar.
component StepDots inherits HorizontalLayout {
    in property <int> count: 5;
    in property <int> current: 0;
    spacing: 7px;
    for i in count : Rectangle {
        width: i == root.current ? 26px : 8px;
        height: 8px;
        border-radius: 4px;
        background: i <= root.current ? #FFFFFF : #333333;
        animate width { duration: 180ms; easing: ease-out; }
        animate background { duration: 180ms; easing: ease-out; }
    }
}

export component OnboardingWidget inherits Window {
    title: "Welcome to QuickSTT";
    // Same blue mic as every other window / the exe / the tray.
    icon: @image-url("../../assets/app_icon.svg");
    preferred-width: 800px;
    preferred-height: 580px;
    min-width: 640px;
    min-height: 520px;
    background: #050505;

    // ── state driven from Rust ──
    in property <int> step: 0;
    in property <[string]> languages: ["Auto"];
    in property <int> selected-language: 0;
    in property <[string]> models: [];
    in property <int> selected-model: 0;
    in property <string> recommend-reason: "";
    in property <string> hardware-info: "";
    in property <bool> wakeword-enabled: false;
    in property <int> ctrl-space-output: 0;
    in property <bool> history-enabled: true;
    in property <string> version: "";

    // ── actions (Rust applies + persists them) ──
    callback next();
    callback back();
    callback skip();
    callback set-language(string);
    callback set-model(string);
    callback set-wakeword(bool);
    callback set-output(int);
    callback set-history(bool);

    // ── internal ──
    property <int> steps: 6;
    // "Clip" transport: the demo scene runs its own loop so the slide reads as
    // a short recording of the app in use (pill → waveform → typed text).
    property <int> demo_tick: 0;
    property <bool> demo_playing: true;
    // Teaching-scene phase (0..89): cursor click, Ctrl+Space, then pill hover.
    property <int> demo_phase: mod(root.demo_tick, 90);
    // Haze backdrop: the demo slides render inside a single warm glow with
    // hard vignette edges, so the eye lands on the pill — not the chrome.
    property <brush> haze: @radial-gradient(circle, #16120A 0%, #0C0B07 42%, #050505 100%);

    Timer {
        interval: 90ms;
        running: (root.step == 1 || root.step == 2) && root.demo_playing;
        triggered => { root.demo_tick = root.demo_tick + 1; }
    }

    VerticalLayout {
        padding: 26px;
        spacing: 18px;

        // ── Header: brand + Skip ──
        HorizontalLayout {
            spacing: 12px;
            Image {
                width: 34px;
                height: 46px;
                source: @image-url("../../assets/app_icon.svg");
                // Gentle pulse so the brand feels alive without being noisy.
                y: 0px;
            }
            VerticalLayout {
                Text {
                    text: "QuickSTT";
                    font-size: 16px;
                    font-weight: 700;
                    color: #FFFFFF;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            PillButton {
                label: "Skip";
                danger: true;
                clicked => { root.skip(); }
            }
        }

        // ── Title / subtitle per step ──
        VerticalLayout {
            spacing: 6px;
            Text {
                text: root.step == 0 ? "Hold Ctrl+Space. Speak." :
                      root.step == 1 ? "See it land." :
                      root.step == 2 ? "Try it now." :
                      root.step == 3 ? "Language" :
                      root.step == 4 ? "Pick your model" :
                      "You are set";
                font-size: 26px;
                font-weight: 700;
                color: #FFFFFF;
            }
            Text {
                text: root.step == 0 ? "Your words appear where you were typing — every dictation runs on this PC, nothing is uploaded." :
                      root.step == 1 ? "The pill wakes, hears you, and types at your cursor." :
                      root.step == 2 ? "The same three moves work anywhere you can type." :
                      root.step == 3 ? "Auto detects, or pin one language — each model remembers its choice." :
                      root.step == 4 ? "Recommended for this PC — change any time in Settings." :
                      "Defaults are sensible. You can change everything later.";
                font-size: 13px;
                color: #9A9A9A;
                wrap: word-wrap;
            }
        }

        // ── Body ──
        Rectangle {
            horizontal-stretch: 1;
            background: (root.step == 1 || root.step == 2) ? root.haze : #0C0C0C;
            border-radius: 14px;
            border-width: 1px;
            border-color: #1E1E1E;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                // ══ Step 0: hero — the one move that matters ══
                if root.step == 0 : VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 18px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 110px;
                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 60px;
                            height: 80px;
                            source: @image-url("../../assets/app_icon.svg");
                        }
                    }
                    // The whole app in one image: two keys, held together.
                    HorizontalLayout {
                        alignment: center;
                        spacing: 12px;
                        Rectangle {
                            width: 92px;
                            height: 48px;
                            border-radius: 10px;
                            background: #161616;
                            border-width: 1px;
                            border-color: #2A2A2A;
                            Text {
                                text: "Ctrl";
                                font-size: 15px;
                                font-weight: 700;
                                color: #FFFFFF;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            width: 148px;
                            height: 48px;
                            border-radius: 10px;
                            background: #161616;
                            border-width: 1px;
                            border-color: #2A2A2A;
                            Text {
                                text: "Space";
                                font-size: 15px;
                                font-weight: 700;
                                color: #FFFFFF;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Text {
                        text: "hold both  ·  release when you are done  ·  100% offline";
                        font-size: 12px;
                        color: #8E8E8E;
                        horizontal-alignment: center;
                    }
                }

                // ══ Step 1: the animated "clip" ══
                if root.step == 1 : VerticalLayout {
                    spacing: 16px;

                    // Mock target app: a window with a blinking caret and text
                    // that "types" in — this is the payoff the user expects.
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 132px;
                        border-radius: 10px;
                        background: #101010;
                        border-width: 1px;
                        border-color: #242424;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle { width: 9px; height: 9px; border-radius: 5px; background: #3A3A3A; }
                                Rectangle { width: 9px; height: 9px; border-radius: 5px; background: #3A3A3A; }
                                Rectangle { width: 9px; height: 9px; border-radius: 5px; background: #3A3A3A; }
                            }
                            HorizontalLayout {
                                spacing: 2px;
                                Text {
                                    text: "Let's ship the release notes";
                                    font-size: 14px;
                                    color: #EDEDED;
                                    vertical-alignment: center;
                                }
                                // Caret: blinks while the text is "typing".
                                Rectangle {
                                    width: 2px;
                                    height: 18px;
                                    background: #FFFFFF;
                                    opacity: mod(root.demo_tick, 2) == 0 ? 1.0 : 0.15;
                                    animate opacity { duration: 90ms; }
                                }
                            }
                        }
                    }

                    // The pill: idle → listening (capsule grows, mic turns red)
                    // → done. Driven by the same demo clock, so it reads as one
                    // continuous capture.
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: center;
                        Rectangle {
                            width: 120px;
                            height: 52px;
                            border-radius: 26px;
                            background: #0F0F0F;
                            border-width: 1px;
                            border-color: #2A2A2A;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Image {
                                    width: 20px;
                                    height: 26px;
                                    source: @image-url("../../assets/mic_active.svg");
                                }
                                Rectangle {
                                    width: 30px;
                                    height: 12px;
                                    border-radius: 6px;
                                    background: #FFFFFF1A;
                                }
                            }
                        }
                        // Live waveform: 14 drawn bars driven by the demo clock
                        // (sine + tick offset), the same shape as the pill's.
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: center;
                            for i in 14 : Rectangle {
                                width: 4px;
                                height: 6px + 26px * abs(sin((root.demo_tick * 37 + i * 61) * 1deg));
                                border-radius: 2px;
                                background: #FFFFFF;
                                animate height { duration: 90ms; easing: linear; }
                            }
                        }
                    }

                    // Clip progress + caption: makes the sequence read as a
                    // recorded clip rather than an idle animation.
                    VerticalLayout {
                        spacing: 6px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 4px;
                            border-radius: 2px;
                            background: #1A1A1A;
                            Rectangle {
                                width: parent.width * mod(root.demo_tick, 40) / 40;
                                height: parent.height;
                                border-radius: parent.border-radius;
                                background: #FFFFFF;
                            }
                        }
                        Text {
                            text: root.step == 1 ? "Ctrl+Space held  ·  speaking  ·  released — text lands at the cursor" : "";
                            font-size: 11.5px;
                            color: #8E8E8E;
                            horizontal-alignment: center;
                        }
                    }
                }

                // ══ Step 2: "try it" — the interactive teaching scene ══
                // Everything is drawn and animated on the demo clock: a cursor
                // clicking into a text box, the Ctrl and Space keys lighting up
                // in order, and the mini pill growing on hover so the three ways
                // to start dictation are SHOWN, not just described.
                if root.step == 2 : VerticalLayout {
                    spacing: 12px;

                    Text {
                        text: root.demo_phase < 20
                            ? "1 ·  Click into any text box — anywhere you can type."
                            : (root.demo_phase < 45
                                ? "2 ·  Hold Ctrl, tap Space, then speak."
                                : "3 ·  Or hover the pill and click the mic.");
                        font-size: 13.5px;
                        font-weight: 600;
                        color: #FFFFFF;
                        horizontal-alignment: center;
                    }

                    // The scene: a mock text field on the left, the mini pill
                    // bottom-right, and a keyboard strip along the bottom.
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 210px;
                        border-radius: 10px;
                        background: #101010;
                        border-width: 1px;
                        border-color: #242424;

                        // ── mock text box (the dictation target) ──
                        Rectangle {
                            x: 16px;
                            y: 16px;
                            width: parent.width - 32px;
                            height: 74px;
                            border-radius: 8px;
                            background: #0A0A0A;
                            border-width: 1px;
                            border-color: root.demo_phase < 20 ? #FFFFFF : #262626;
                            animate border-color { duration: 200ms; }
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 3px;
                                Text {
                                    text: "The quick brown fox";
                                    font-size: 13px;
                                    color: #EDEDED;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    width: 2px;
                                    height: 16px;
                                    background: #FFFFFF;
                                    opacity: mod(root.demo_tick, 2) == 0 ? 1.0 : 0.2;
                                }
                            }
                            // Click ripple: expands + fades while phase 1 runs.
                            Rectangle {
                                x: 26px;
                                y: 30px;
                                width: 14px;
                                height: 14px;
                                border-radius: 7px;
                                border-width: 2px;
                                border-color: #FFFFFF;
                                opacity: root.demo_phase < 20 ? (1.0 - root.demo_phase / 20) : 0.0;
                                animate opacity { duration: 120ms; }
                            }
                        }

                        // ── cursor arrow flying into the text box ──
                        Rectangle {
                            x: root.demo_phase < 20 ? (16px + (14px * root.demo_phase)) : 26px;
                            y: root.demo_phase < 20 ? (190px - (20px * root.demo_phase)) : 30px;
                            width: 14px;
                            height: 20px;
                            animate x { duration: 90ms; }
                            animate y { duration: 90ms; }
                            Path {
                                commands: "M 0 0 L 0 14 L 4 10 L 6 14 L 9 13 L 7 9 L 11 9 Z";
                                fill: #FFFFFF;
                                viewbox-width: 12;
                                viewbox-height: 16;
                            }
                        }

                        // ── the pill (hover → grow → click the mic) ──
                        // Haze glow behind it: a soft warm bloom that pulls
                        // the eye to the one control that matters.
                        Rectangle {
                            x: parent.width - 260px;
                            y: parent.height - 130px;
                            width: 240px;
                            height: 130px;
                            border-radius: 130px;
                            background: @radial-gradient(circle, #FFFFFF14 0%, transparent 70%);
                        }
                        Rectangle {
                            x: parent.width - 150px;
                            y: parent.height - 52px;
                            width: root.demo_phase < 45 ? 118px : 96px;
                            height: 34px;
                            border-radius: root.demo_phase < 45 ? 17px : 17px;
                            background: #000000;
                            border-width: root.demo_phase >= 45 ? 1px : 0px;
                            border-color: #FFFFFF55;
                            animate width { duration: 200ms; easing: ease-out; }
                            // Hover wake-up: a soft ring fades in.
                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 52px;
                                height: 52px;
                                border-radius: 26px;
                                border-width: 1px;
                                border-color: #FFFFFF33;
                                opacity: root.demo_phase >= 45 ? 1.0 : 0.0;
                                animate opacity { duration: 220ms; }
                            }
                            // The mic icon inside the capsule, lit while active.
                            Image {
                                width: 16px;
                                height: 20px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../../assets/mic_active.svg");
                                opacity: root.demo_phase >= 45 ? 1.0 : 0.55;
                                animate opacity { duration: 200ms; }
                            }
                        }

                        // ── keyboard: big Ctrl + Space keys, pressed in order ──
                        HorizontalLayout {
                            x: 16px;
                            y: parent.height - 46px;
                            spacing: 8px;
                            // Ctrl
                            Rectangle {
                                width: 92px;
                                height: 30px;
                                border-radius: 6px;
                                background: (root.demo_phase >= 20 && root.demo_phase < 45) ? #FFFFFF : #1E1E1E;
                                border-width: 1px;
                                border-color: (root.demo_phase >= 20 && root.demo_phase < 45) ? #FFFFFF : #2E2E2E;
                                animate background { duration: 120ms; }
                                Text {
                                    text: "Ctrl";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: (root.demo_phase >= 20 && root.demo_phase < 45) ? #000000 : #B9B9B9;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            // Space
                            Rectangle {
                                width: 150px;
                                height: 30px;
                                border-radius: 6px;
                                background: (root.demo_phase >= 28 && root.demo_phase < 45) ? #FFFFFF : #1E1E1E;
                                border-width: 1px;
                                border-color: (root.demo_phase >= 28 && root.demo_phase < 45) ? #FFFFFF : #2E2E2E;
                                animate background { duration: 120ms; }
                                Text {
                                    text: "Space";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: (root.demo_phase >= 28 && root.demo_phase < 45) ? #000000 : #B9B9B9;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }

                    Text {
                        text: "Every finished turn also lands in Settings → History with its audio, so you can play it back, copy it, export the audio, or delete everything.";
                        font-size: 11.5px;
                        color: #8E8E8E;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }


                // ══ Step 3: language ══
                if root.step == 3 : VerticalLayout {
                    spacing: 12px;
                    Text { text: "Transcription language:"; font-size: 13px; color: #E6E6E6; }
                    ComboBox {
                        height: 42px;
                        model: root.languages;
                        current-index: root.selected-language;
                        selected(v) => { root.set-language(v); }
                    }
                    Rectangle {
                        background: #121212;
                        border-radius: 8px;
                        VerticalLayout {
                            padding: 12px;
                            Text {
                                text: root.selected-language == 0
                                    ? "Auto: the engine detects the spoken language from the audio."
                                    : "Forced: this language is always used, even when another is spoken. Each model remembers its own choice.";
                                font-size: 12px;
                                color: #9A9A9A;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ══ Step 4: model ══
                if root.step == 4 : VerticalLayout {
                    spacing: 12px;
                    Rectangle {
                        background: #121212;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #2A2A2A;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text {
                                text: "Recommended for this PC";
                                font-size: 12px;
                                font-weight: 700;
                                color: #FFFFFF;
                            }
                            Text {
                                text: root.recommend-reason;
                                font-size: 11.5px;
                                color: #9A9A9A;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Text { text: "Choose a model:"; font-size: 13px; color: #E6E6E6; }
                    ComboBox {
                        height: 42px;
                        model: root.models;
                        current-index: root.selected-model;
                        selected(v) => { root.set-model(v); }
                    }
                }

                // ══ Step 5: preferences ══
                if root.step == 5 : VerticalLayout {
                    spacing: 10px;
                    Text { text: "Where finished text goes:"; font-size: 13px; color: #E6E6E6; }
                    HorizontalLayout {
                        spacing: 8px;
                        for i in 2 : Rectangle {
                            horizontal-stretch: 1;
                            height: 54px;
                            border-radius: 10px;
                            background: root.ctrl-space-output == i ? #FFFFFF : #141414;
                            border-width: 1px;
                            border-color: root.ctrl-space-output == i ? #FFFFFF : #262626;
                            animate background { duration: 130ms; easing: ease-out; }
                            Text {
                                text: i == 0 ? "Type it\n(where I'm typing)" : "Clipboard\n(paste anywhere)";
                                font-size: 11.5px;
                                font-weight: root.ctrl-space-output == i ? 700 : 500;
                                color: root.ctrl-space-output == i ? #000000 : #B9B9B9;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.set-output(i); } mouse-cursor: pointer; }
                        }
                    }
                    CheckBox {
                        height: 42px;
                        text: "Back up every turn in History (text + audio)";
                        checked: root.history-enabled;
                        toggled => { root.set-history(self.checked); }
                    }
                    CheckBox {
                        height: 42px;
                        text: "Listen for wake words in the background";
                        checked: root.wakeword-enabled;
                        toggled => { root.set-wakeword(self.checked); }
                    }
                }
            }
        }

        // ── Footer: dots · Back · Next/Start ──
        HorizontalLayout {
            spacing: 12px;
            StepDots { count: root.steps; current: root.step; }
            Rectangle { horizontal-stretch: 1; }
            PillButton {
                label: "Back";
                enabled: root.step > 0;
                clicked => { root.back(); }
            }
            PillButton {
                label: root.step >= root.steps - 1 ? "Start dictating" : "Next";
                primary: true;
                clicked => { root.next(); }
            }
        }
    }
}
